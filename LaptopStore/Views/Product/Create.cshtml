@model LaptopStore.ViewModels.ProductEditViewModel
@{
    ViewData["Title"] = "Thêm sản phẩm mới";
}

<div class="page-header">
    <div>
        <h2 class="page-title">Thêm sản phẩm mới</h2>
        <p class="text-muted small mb-0">Nhập đầy đủ thông tin sản phẩm, cấu hình chi tiết và ảnh minh họa</p>
    </div>
    <div class="page-actions">
        <a asp-action="Index" class="btn-secondary-custom">
            <i class="bi bi-arrow-left"></i> Trở lại danh sách
        </a>
    </div>
</div>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div class="row g-4">
        <!-- ==================== CỘT TRÁI: THÔNG TIN SẢN PHẨM ==================== -->
        <div class="col-lg-6">
            <div class="admin-card h-100">
                <div class="admin-card-header">
                    <h5 class="card-title-text">
                        <i class="bi bi-info-circle text-primary"></i> Thông tin sản phẩm
                    </h5>
                </div>

                <!-- Tên sản phẩm -->
                <div class="mb-3">
                    <label asp-for="ProductName" class="form-label-dark">Tên sản phẩm *</label>
                    <input asp-for="ProductName" class="form-control-dark" placeholder="VD: ASUS ROG Strix G16 G614JV" />
                    <span asp-validation-for="ProductName" class="text-danger small"></span>
                </div>

                <!-- Thương hiệu & Phân khúc -->
                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label asp-for="BrandId" class="form-label-dark">Thương hiệu *</label>
                        <select asp-for="BrandId" class="form-select-dark" asp-items="ViewBag.Brands">
                            <option value="">-- Chọn thương hiệu --</option>
                        </select>
                        <span asp-validation-for="BrandId" class="text-danger small"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="CategoryId" class="form-label-dark">Phân khúc *</label>
                        <select asp-for="CategoryId" class="form-select-dark" asp-items="ViewBag.Categories">
                            <option value="">-- Chọn phân khúc --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Giá bán & Số lượng -->
                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label asp-for="Price" class="form-label-dark">Giá bán (VNĐ) *</label>
                        <input asp-for="Price" type="number" class="form-control-dark" placeholder="35500000" />
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="StockQuantity" class="form-label-dark">Số lượng kho *</label>
                        <input asp-for="StockQuantity" type="number" class="form-control-dark" placeholder="15" value="10" />
                        <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Giá khuyến mãi (tùy chọn) -->
                <div class="mb-3">
                    <label asp-for="DiscountPrice" class="form-label-dark">Giá khuyến mãi (VNĐ - tùy chọn)</label>
                    <input asp-for="DiscountPrice" type="number" class="form-control-dark" placeholder="Để trống nếu không giảm giá" />
                </div>

                <!-- Mô tả sản phẩm -->
                <div class="mb-3">
                    <label asp-for="Description" class="form-label-dark">Mô tả sản phẩm</label>
                    <textarea asp-for="Description" class="form-control-dark" rows="5" placeholder="Nhập mô tả tính năng nổi bật, thiết kế, màn hình của máy..."></textarea>
                </div>
            </div>
        </div>

        <!-- ==================== CỘT PHẢI: CẤU HÌNH & HÌNH ẢNH ==================== -->
        <div class="col-lg-6">
            <div class="admin-card h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="admin-card-header">
                        <h5 class="card-title-text">
                            <i class="bi bi-cpu text-primary"></i> Cấu hình & Hình ảnh
                        </h5>
                    </div>

                    <!-- 1. Cấu hình chi tiết -->
                    <h6 class="text-dark fw-bold mb-3" style="font-size: 0.9rem;">
                        <i class="bi bi-motherboard text-primary me-1"></i> Cấu hình chi tiết
                    </h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6 col-12">
                            <label class="form-label-dark">Vi xử lý (CPU)</label>
                            <input asp-for="CPU" class="form-control-dark" placeholder="VD: Intel Core i7-13650HX hoặc AMD Ryzen 7" />
                        </div>
                        <div class="col-md-6 col-12">
                            <label class="form-label-dark">Card đồ họa (VGA)</label>
                            <input asp-for="GPU" class="form-control-dark" placeholder="VD: NVIDIA RTX 4060 8GB" />
                        </div>
                        <div class="col-md-4 col-12">
                            <label class="form-label-dark">Bộ nhớ RAM <span class="text-danger">*</span></label>
                            <select asp-for="RamGB" class="form-select-dark">
                                <option value="4">4 GB</option>
                                <option value="8">8 GB</option>
                                <option value="12">12 GB</option>
                                <option value="16" selected>16 GB (Tiêu chuẩn)</option>
                                <option value="24">24 GB</option>
                                <option value="32">32 GB (Cao cấp)</option>
                                <option value="48">48 GB</option>
                                <option value="64">64 GB (Workstation)</option>
                                <option value="96">96 GB</option>
                                <option value="128">128 GB</option>
                            </select>
                        </div>
                        <div class="col-md-4 col-12">
                            <label class="form-label-dark">Dung lượng ổ cứng <span class="text-danger">*</span></label>
                            <select asp-for="StorageGB" class="form-select-dark">
                                <option value="128">128 GB</option>
                                <option value="256">256 GB</option>
                                <option value="512" selected>512 GB (Tiêu chuẩn)</option>
                                <option value="1024">1 TB (1024 GB)</option>
                                <option value="2048">2 TB (2048 GB)</option>
                                <option value="4096">4 TB (4096 GB)</option>
                            </select>
                        </div>
                        <div class="col-md-4 col-12">
                            <label class="form-label-dark">Loại ổ cứng <span class="text-danger">*</span></label>
                            <select asp-for="StorageType" class="form-select-dark">
                                <option value="SSD NVMe" selected>SSD NVMe (Tốc độ cao)</option>
                                <option value="SSD SATA">SSD SATA</option>
                                <option value="HDD">HDD</option>
                            </select>
                        </div>
                    </div>

                    <!-- 2. Quản lý hình ảnh sản phẩm (Tối đa 4 ảnh cho sản phẩm) -->
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="text-dark fw-bold mb-0" style="font-size: 0.9rem;">
                            <i class="bi bi-images text-danger me-1"></i> Bộ ảnh sản phẩm (Tối đa 4 ảnh cố định)
                        </h6>
                        <span class="badge bg-light text-muted border" style="font-size: 11px;">1 ảnh chính + 3 ảnh chi tiết</span>
                    </div>

                    <div class="alert alert-light border py-2 px-3 mb-3 small text-muted">
                        <i class="bi bi-info-circle text-primary me-1"></i> Mỗi sản phẩm có tối đa 4 ảnh dùng chung cho mọi biến thể.
                    </div>

                    <!-- Màu sắc khởi tạo phiên bản đầu tiên -->
                    <div class="mb-3 p-2 rounded border bg-light">
                        <label class="form-label-dark small fw-bold mb-1">
                            <i class="bi bi-palette text-primary me-1"></i> Màu sắc phiên bản mặc định đầu tiên:
                        </label>
                        <select asp-for="SelectedColorId" class="form-select-dark" asp-items="ViewBag.Colors">
                        </select>
                        <div class="form-text small" style="font-size: 11px;">
                            Phiên bản đầu tiên sẽ tạo với màu này. Bạn có thể thêm nhiều phiên bản màu khác ở trang Quản lý Phiên bản.
                        </div>
                    </div>

                    <!-- 4 Ô ảnh theo thứ tự 1-4 -->
                    <div class="row g-2 mb-3">
                        <!-- Ô 1: Ảnh đại diện -->
                        <div class="col-6 col-md-3">
                            <div class="card h-100 border p-2 text-center bg-white shadow-sm slot-card">
                                <span class="badge bg-dark mb-2 small text-truncate" title="Ô 1 · Ảnh đại diện">Ô 1 · Đại diện</span>
                                <div class="slot-preview-wrapper mb-2 d-flex align-items-center justify-content-center border rounded bg-light" style="height: 100px; overflow: hidden;">
                                    <img id="slot1Preview" src="/images/placeholder.png" alt="Ô 1" style="max-height: 90px; max-width: 100%; object-fit: contain;" />
                                </div>
                                <input asp-for="Slot1Image" id="slot1FileInput" type="file" class="d-none" accept="image/*" onchange="handleSlotFileChange(1, this)" />
                                <button type="button" class="btn btn-sm btn-outline-dark w-100 mt-auto" onclick="document.getElementById('slot1FileInput').click()">
                                    <i class="bi bi-camera"></i> Chọn ảnh
                                </button>
                                <div id="slot1FileName" class="text-primary small text-truncate mt-1" style="font-size: 10px;"></div>
                            </div>
                        </div>

                        <!-- Ô 2: Mặt sau & Cổng -->
                        <div class="col-6 col-md-3">
                            <div class="card h-100 border p-2 text-center bg-white shadow-sm slot-card">
                                <span class="badge bg-secondary mb-2 small text-truncate" title="Ô 2 · Mặt sau & Cổng kết nối">Ô 2 · Mặt sau</span>
                                <div class="slot-preview-wrapper mb-2 d-flex align-items-center justify-content-center border rounded bg-light" style="height: 100px; overflow: hidden;">
                                    <img id="slot2Preview" src="/images/placeholder.png" alt="Ô 2" style="max-height: 90px; max-width: 100%; object-fit: contain;" />
                                </div>
                                <input asp-for="Slot2Image" id="slot2FileInput" type="file" class="d-none" accept="image/*" onchange="handleSlotFileChange(2, this)" />
                                <div class="btn-group w-100 btn-group-sm mt-auto">
                                    <button type="button" class="btn btn-outline-dark" onclick="document.getElementById('slot2FileInput').click()" title="Chọn ảnh">
                                        <i class="bi bi-upload"></i> Chọn
                                    </button>
                                    <button type="button" class="btn btn-outline-danger" id="slot2ClearBtn" onclick="clearSlotFile(2)" title="Hủy chọn">
                                        <i class="bi bi-x-circle"></i>
                                    </button>
                                </div>
                                <div id="slot2FileName" class="text-primary small text-truncate mt-1" style="font-size: 10px;"></div>
                            </div>
                        </div>

                        <!-- Ô 3: Bàn phím & Bản lề -->
                        <div class="col-6 col-md-3">
                            <div class="card h-100 border p-2 text-center bg-white shadow-sm slot-card">
                                <span class="badge bg-secondary mb-2 small text-truncate" title="Ô 3 · Bàn phím & Bản lề">Ô 3 · Bàn phím</span>
                                <div class="slot-preview-wrapper mb-2 d-flex align-items-center justify-content-center border rounded bg-light" style="height: 100px; overflow: hidden;">
                                    <img id="slot3Preview" src="/images/placeholder.png" alt="Ô 3" style="max-height: 90px; max-width: 100%; object-fit: contain;" />
                                </div>
                                <input asp-for="Slot3Image" id="slot3FileInput" type="file" class="d-none" accept="image/*" onchange="handleSlotFileChange(3, this)" />
                                <div class="btn-group w-100 btn-group-sm mt-auto">
                                    <button type="button" class="btn btn-outline-dark" onclick="document.getElementById('slot3FileInput').click()" title="Chọn ảnh">
                                        <i class="bi bi-upload"></i> Chọn
                                    </button>
                                    <button type="button" class="btn btn-outline-danger" id="slot3ClearBtn" onclick="clearSlotFile(3)" title="Hủy chọn">
                                        <i class="bi bi-x-circle"></i>
                                    </button>
                                </div>
                                <div id="slot3FileName" class="text-primary small text-truncate mt-1" style="font-size: 10px;"></div>
                            </div>
                        </div>

                        <!-- Ô 4: Góc nghiêng & Chi tiết -->
                        <div class="col-6 col-md-3">
                            <div class="card h-100 border p-2 text-center bg-white shadow-sm slot-card">
                                <span class="badge bg-secondary mb-2 small text-truncate" title="Ô 4 · Góc nghiêng & Chi tiết">Ô 4 · Chi tiết</span>
                                <div class="slot-preview-wrapper mb-2 d-flex align-items-center justify-content-center border rounded bg-light" style="height: 100px; overflow: hidden;">
                                    <img id="slot4Preview" src="/images/placeholder.png" alt="Ô 4" style="max-height: 90px; max-width: 100%; object-fit: contain;" />
                                </div>
                                <input asp-for="Slot4Image" id="slot4FileInput" type="file" class="d-none" accept="image/*" onchange="handleSlotFileChange(4, this)" />
                                <div class="btn-group w-100 btn-group-sm mt-auto">
                                    <button type="button" class="btn btn-outline-dark" onclick="document.getElementById('slot4FileInput').click()" title="Chọn ảnh">
                                        <i class="bi bi-upload"></i> Chọn
                                    </button>
                                    <button type="button" class="btn btn-outline-danger" id="slot4ClearBtn" onclick="clearSlotFile(4)" title="Hủy chọn">
                                        <i class="bi bi-x-circle"></i>
                                    </button>
                                </div>
                                <div id="slot4FileName" class="text-primary small text-truncate mt-1" style="font-size: 10px;"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. Action Buttons -->
                <div class="d-flex align-items-center justify-content-end gap-3 mt-4 pt-3 border-top border-secondary">
                    <a asp-action="Index" class="btn-secondary-custom px-4">Hủy</a>
                    <button type="submit" class="btn-primary-custom px-4">
                        <i class="bi bi-check-lg"></i> Thêm sản phẩm
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        function handleSlotFileChange(slot, input) {
            if (input.files && input.files[0]) {
                const file = input.files[0];
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('slot' + slot + 'Preview').src = e.target.result;
                    document.getElementById('slot' + slot + 'FileName').innerText = file.name;
                };
                reader.readAsDataURL(file);
            }
        }

        function clearSlotFile(slot) {
            const input = document.getElementById('slot' + slot + 'FileInput');
            if (input) input.value = '';
            document.getElementById('slot' + slot + 'Preview').src = '/images/placeholder.png';
            document.getElementById('slot' + slot + 'FileName').innerText = '';
        }
    </script>
}