@model IEnumerable<LaptopStore.Models.Product>

<div class="admin-table-container">
    <table class="admin-table">
        <thead>
            <tr>
                <th style="width: 40px;"><input type="checkbox" class="custom-checkbox" /></th>
                <th>Mã SP</th>
                <th>Hình ảnh</th>
                <th>Tên sản phẩm</th>
                <th>Thương hiệu</th>
                <th>Giá bán</th>
                <th>Kho số lượng</th>
                <th>Trạng thái</th>
                <th class="text-end">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    var statusClass = item.StockQuantity > 5 ? "badge-in-stock" : (item.StockQuantity > 0 ? "badge-low-stock" : "badge-out-of-stock");
                    var statusText = item.StockQuantity > 5 ? "Còn hàng" : (item.StockQuantity > 0 ? "Sắp hết hàng" : "Hết hàng");

                    <tr id="row-@item.ProductId">
                        <td><input type="checkbox" class="custom-checkbox" /></td>
                        <td class="fw-semibold text-primary">SP@(item.ProductId.ToString("D3"))</td>
                        <td>
                            <img src="@item.ThumbnailUrl" onerror="this.src='/images/default.png'" 
                                 style="width: 44px; height: 44px; object-fit: contain; background: #ffffff; border-radius: 6px; padding: 2px;" 
                                 class="border" />
                        </td>
                        <td>
                            <div class="fw-semibold text-dark">@item.ProductName</div>
                            <div class="text-muted" style="font-size: 0.75rem;">
                                @(item.Category?.CategoryName ?? "Laptop")
                            </div>
                        </td>
                        <td class="text-secondary">@(item.Brand?.BrandName ?? "-")</td>
                        <td class="fw-bold text-dark">
                            @string.Format("{0:N0}đ", item.DiscountPrice ?? item.Price)
                        </td>
                        <td class="fw-medium text-dark">@item.StockQuantity</td>
                        <td>
                            <span class="badge-status @statusClass">
                                @statusText
                            </span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.ProductId" class="btn-action-view me-1 text-decoration-none">
                                <i class="bi bi-eye"></i> Xem
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn-action-edit me-1 text-decoration-none">
                                <i class="bi bi-pencil-square"></i> Sửa
                            </a>
                            <button type="button" class="btn-action-delete" onclick="deleteProduct(@item.ProductId)">
                                <i class="bi bi-trash"></i> Xóa
                            </button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" class="text-center py-4 text-muted">
                        <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                        Không tìm thấy sản phẩm nào phù hợp với bộ lọc.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- PAGINATION FOOTER -->
<div class="admin-pagination-wrap">
    <div class="pagination-info">
        Hiển thị 1-@ViewBag.PageSize trên @ViewBag.TotalCount sản phẩm
    </div>
    <ul class="admin-pagination">
        <!-- Nút Trước -->
        <li class="admin-page-item @(ViewBag.CurrentPage <= 1 ? "disabled" : "")">
            <a href="javascript:void(0)" onclick="loadProductPage(@(ViewBag.CurrentPage - 1))">
                <i class="bi bi-chevron-left"></i> Trước
            </a>
        </li>

        @for (int i = 1; i <= Math.Min((int)ViewBag.TotalPages, 5); i++)
        {
            <li class="admin-page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                <a href="javascript:void(0)" onclick="loadProductPage(@i)">@i</a>
            </li>
        }

        @if (ViewBag.TotalPages > 5)
        {
            <li class="admin-page-item disabled"><a href="javascript:void(0)">...</a></li>
            <li class="admin-page-item @(ViewBag.TotalPages == ViewBag.CurrentPage ? "active" : "")">
                <a href="javascript:void(0)" onclick="loadProductPage(@ViewBag.TotalPages)">@ViewBag.TotalPages</a>
            </li>
        }

        <!-- Nút Sau -->
        <li class="admin-page-item @(ViewBag.CurrentPage >= ViewBag.TotalPages ? "disabled" : "")">
            <a href="javascript:void(0)" onclick="loadProductPage(@(ViewBag.CurrentPage + 1))">
                Sau <i class="bi bi-chevron-right"></i>
            </a>
        </li>
    </ul>
</div>