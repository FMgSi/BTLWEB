@model IEnumerable<LaptopStore.Models.Product>

<div class="admin-table-container">
    <table class="admin-table">
        <thead>
            <tr>
                <th style="width: 40px;"><input type="checkbox" class="custom-checkbox" /></th>
                <th>Mã SP</th>
                <th>Hình ảnh</th>
                <th>Tên sản phẩm</th>
                <th>Thương hiệu</th>
                <th>Giá bán</th>
                <th>Kho số lượng</th>
                <th>Trạng thái</th>
                <th class="text-end">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    var statusClass = item.StockQuantity > 5 ? "badge-in-stock" : (item.StockQuantity > 0 ? "badge-low-stock" : "badge-out-of-stock");
                    var statusText = item.StockQuantity > 5 ? "Còn hàng" : (item.StockQuantity > 0 ? "Sắp hết hàng" : "Hết hàng");

                    <tr id="row-@item.ProductId">
                        <td><input type="checkbox" class="custom-checkbox" /></td>
                        <td class="fw-semibold text-primary">SP@(item.ProductId.ToString("D3"))</td>
                        <td>
                            <img src="@item.ThumbnailUrl" onerror="this.src='/images/default.png'" 
                                 style="width: 44px; height: 44px; object-fit: contain; background: #ffffff; border-radius: 6px; padding: 2px;" 
                                 class="border" />
                        </td>
                        <td>
                            <div class="fw-semibold text-dark">
                                <a asp-action="Edit" asp-route-id="@item.ProductId" class="text-dark text-decoration-none" title="Nhấp để sửa tên và thông tin sản phẩm">
                                    @item.ProductName
                                </a>
                            </div>
                            <div class="text-muted" style="font-size: 0.75rem;">
                                @(item.Category?.CategoryName ?? "Laptop")
                            </div>
                        </td>
                        <td class="text-secondary">@(item.Brand?.BrandName ?? "-")</td>
                        <td class="fw-bold text-dark">
                            @string.Format("{0:N0}đ", item.DiscountPrice ?? item.Price)
                        </td>
                        <td class="fw-medium text-dark">@item.StockQuantity</td>
                        <td>
                            <span class="badge-status @statusClass">
                                @statusText
                            </span>
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Variants" asp-route-id="@item.ProductId" class="btn-action-tool btn-sm me-1" title="Quản lý phiên bản màu & tồn kho">
                                <i class="bi bi-palette"></i> Biến thể
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn-action-tool btn-sm me-1" title="Sửa thông tin">
                                <i class="bi bi-pencil-square"></i> Sửa
                            </a>
                            <button type="button" class="btn-action-tool btn-sm" onclick="deleteProduct(@item.ProductId)" title="Xóa">
                                <i class="bi bi-trash"></i> Xóa
                            </button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" class="text-center py-4 text-muted">
                        <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                        Không tìm thấy sản phẩm nào phù hợp với bộ lọc.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (ViewBag.TotalPages != null && (int)ViewBag.TotalPages > 0)
{
    int curPage = ViewBag.CurrentPage ?? 1;
    int totPages = ViewBag.TotalPages ?? 1;
    int totCount = ViewBag.TotalCount ?? 0;
    int pageSize = ViewBag.PageSize ?? 5;
    int startItem = totCount > 0 ? (curPage - 1) * pageSize + 1 : 0;
    int endItem = Math.Min(curPage * pageSize, totCount);

    var pagesToShow = new List<object>();
    if (totPages <= 7)
    {
        for (int i = 1; i <= totPages; i++) { pagesToShow.Add(i); }
    }
    else
    {
        if (curPage <= 4)
        {
            pagesToShow.AddRange(new object[] { 1, 2, 3, 4, 5, "...", totPages });
        }
        else if (curPage >= totPages - 3)
        {
            pagesToShow.AddRange(new object[] { 1, "...", totPages - 4, totPages - 3, totPages - 2, totPages - 1, totPages });
        }
        else
        {
            pagesToShow.AddRange(new object[] { 1, "...", curPage - 1, curPage, curPage + 1, "...", totPages });
        }
    }

    <div class="admin-pagination-wrap p-3 d-flex flex-wrap justify-content-between align-items-center border-top bg-white">
        <div class="pagination-info small text-muted">
            Trang <strong>@curPage</strong> / <strong>@totPages</strong> (Hiển thị <strong>@startItem - @endItem</strong> trong tổng số <strong>@totCount</strong> sản phẩm)
        </div>
        <ul class="admin-pagination m-0 d-flex gap-1 list-unstyled align-items-center">
            
            <li class="admin-page-item @(curPage <= 1 ? "disabled" : "")">
                <a href="javascript:void(0)" 
                   onclick="@(curPage <= 1 ? "" : $"loadProductPage({curPage - 1})")" 
                   class="btn btn-sm btn-light border @(curPage <= 1 ? "disabled opacity-50" : "text-dark")"
                   title="Trang trước"
                   style="min-width: 34px; height: 34px; border-radius: 6px; display: inline-flex; align-items: center; justify-content: center;">
                    <i class="bi bi-chevron-left"></i> Trước
                </a>
            </li>

            @foreach (var pageItem in pagesToShow)
            {
                if (pageItem is string)
                {
                    <li class="admin-page-item disabled">
                        <span class="d-inline-flex align-items-center justify-content-center text-muted px-1" style="min-width: 24px; height: 34px; font-weight: bold; user-select: none;">...</span>
                    </li>
                }
                else
                {
                    int p = (int)pageItem;
                    <li class="admin-page-item">
                        <a href="javascript:void(0)" 
                           onclick="loadProductPage(@p)" 
                           class="btn btn-sm @(p == curPage ? "btn-dark text-white fw-bold shadow-sm" : "btn-light border text-dark")"
                           title="Trang @p"
                           style="min-width: 34px; height: 34px; border-radius: 6px; display: inline-flex; align-items: center; justify-content: center;">
                            @p
                        </a>
                    </li>
                }
            }

            
            <li class="admin-page-item @(curPage >= totPages ? "disabled" : "")">
                <a href="javascript:void(0)" 
                   onclick="@(curPage >= totPages ? "" : $"loadProductPage({curPage + 1})")" 
                   class="btn btn-sm btn-light border @(curPage >= totPages ? "disabled opacity-50" : "text-dark")"
                   title="Trang tiếp theo"
                   style="min-width: 34px; height: 34px; border-radius: 6px; display: inline-flex; align-items: center; justify-content: center;">
                    Sau <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        </ul>
    </div>
}
