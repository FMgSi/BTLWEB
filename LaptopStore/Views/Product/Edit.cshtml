@model LaptopStore.ViewModels.ProductEditViewModel
@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm #" + Model.ProductId;
}

<div class="page-header">
    <div>
        <h2 class="page-title">Chỉnh sửa sản phẩm #SP@Model.ProductId.ToString("D3")</h2>
        <p class="text-muted small mb-0">Cập nhật thông tin chi tiết, giá bán, tồn kho và cấu hình máy</p>
    </div>
    <div class="page-actions">
        <a asp-action="Index" class="btn-secondary-custom">
            <i class="bi bi-arrow-left"></i> Trở lại danh sách
        </a>
    </div>
</div>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ProductId" />
    <input type="hidden" asp-for="ExistingThumbnail" />

    <div class="row g-4">
        <!-- ==================== CỘT TRÁI: THÔNG TIN SẢN PHẨM ==================== -->
        <div class="col-lg-6">
            <div class="admin-card h-100">
                <div class="admin-card-header">
                    <h5 class="card-title-text">
                        <i class="bi bi-info-circle text-primary"></i> Thông tin sản phẩm
                    </h5>
                </div>

                <!-- Tên sản phẩm -->
                <div class="mb-3">
                    <label asp-for="ProductName" class="form-label-dark">Tên sản phẩm *</label>
                    <input asp-for="ProductName" class="form-control-dark" />
                    <span asp-validation-for="ProductName" class="text-danger small"></span>
                </div>

                <!-- Thương hiệu & Phân khúc -->
                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label asp-for="BrandId" class="form-label-dark">Thương hiệu *</label>
                        <select asp-for="BrandId" class="form-select-dark" asp-items="ViewBag.Brands"></select>
                        <span asp-validation-for="BrandId" class="text-danger small"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="CategoryId" class="form-label-dark">Phân khúc *</label>
                        <select asp-for="CategoryId" class="form-select-dark" asp-items="ViewBag.Categories"></select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Giá bán & Số lượng -->
                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label asp-for="Price" class="form-label-dark">Giá bán (VNĐ) *</label>
                        <input asp-for="Price" type="number" class="form-control-dark" />
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="StockQuantity" class="form-label-dark">Số lượng kho *</label>
                        <input asp-for="StockQuantity" type="number" class="form-control-dark" />
                        <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Giá khuyến mãi -->
                <div class="mb-3">
                    <label asp-for="DiscountPrice" class="form-label-dark">Giá khuyến mãi (VNĐ - tùy chọn)</label>
                    <input asp-for="DiscountPrice" type="number" class="form-control-dark" />
                </div>

                <!-- Mô tả sản phẩm -->
                <div class="mb-3">
                    <label asp-for="Description" class="form-label-dark">Mô tả sản phẩm</label>
                    <textarea asp-for="Description" class="form-control-dark" rows="5"></textarea>
                </div>
            </div>
        </div>

        <!-- ==================== CỘT PHẢI: CẤU HÌNH & HÌNH ẢNH ==================== -->
        <div class="col-lg-6">
            <div class="admin-card h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="admin-card-header">
                        <h5 class="card-title-text">
                            <i class="bi bi-cpu text-primary"></i> Cấu hình & Hình ảnh
                        </h5>
                    </div>

                    <!-- 1. Cấu hình chi tiết -->
                    <h6 class="text-dark fw-bold mb-3" style="font-size: 0.9rem;">
                        <i class="bi bi-motherboard text-primary me-1"></i> Cấu hình chi tiết
                    </h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6 col-12">
                            <label class="form-label-dark">Vi xử lý (CPU)</label>
                            <input asp-for="CPU" class="form-control-dark" placeholder="VD: Intel Core i7-13650HX hoặc AMD Ryzen 7" />
                        </div>
                        <div class="col-md-6 col-12">
                            <label class="form-label-dark">Card đồ họa (VGA)</label>
                            <input asp-for="GPU" class="form-control-dark" placeholder="VD: NVIDIA RTX 4060 8GB" />
                        </div>
                        <div class="col-md-4 col-12">
                            <label class="form-label-dark">Bộ nhớ RAM <span class="text-danger">*</span></label>
                            <select asp-for="RamGB" class="form-select-dark">
                                @{
                                    var stdRams = new[] { 4, 8, 12, 16, 24, 32, 48, 64, 96, 128 };
                                    int curRam = Model.RamGB ?? 16;
                                    bool matchedRam = false;
                                    foreach (var r in stdRams)
                                    {
                                        bool isSel = (r == curRam);
                                        if (isSel) matchedRam = true;
                                        <option value="@r" selected="@(isSel ? "selected" : null)">@r GB@(r == 16 ? " (Tiêu chuẩn)" : r == 32 ? " (Cao cấp)" : "")</option>
                                    }
                                    if (!matchedRam && curRam > 0)
                                    {
                                        <option value="@curRam" selected>@curRam GB (Hiện tại)</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-4 col-12">
                            <label class="form-label-dark">Dung lượng ổ cứng <span class="text-danger">*</span></label>
                            <select asp-for="StorageGB" class="form-select-dark">
                                @{
                                    var stdStorages = new (int val, string text)[] {
                                        (128, "128 GB"),
                                        (256, "256 GB"),
                                        (512, "512 GB (Tiêu chuẩn)"),
                                        (1024, "1 TB (1024 GB)"),
                                        (2048, "2 TB (2048 GB)"),
                                        (4096, "4 TB (4096 GB)")
                                    };
                                    int curStorage = Model.StorageGB ?? 512;
                                    bool matchedStorage = false;
                                    foreach (var s in stdStorages)
                                    {
                                        bool isSel = (s.val == curStorage);
                                        if (isSel) matchedStorage = true;
                                        <option value="@s.val" selected="@(isSel ? "selected" : null)">@s.text</option>
                                    }
                                    if (!matchedStorage && curStorage > 0)
                                    {
                                        <option value="@curStorage" selected>@curStorage GB (Hiện tại)</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-4 col-12">
                            <label class="form-label-dark">Loại ổ cứng <span class="text-danger">*</span></label>
                            <select asp-for="StorageType" class="form-select-dark">
                                @{
                                    var stdTypes = new[] { "SSD NVMe", "SSD SATA", "HDD" };
                                    string curType = Model.StorageType ?? "SSD NVMe";
                                    bool matchedType = false;
                                    foreach (var t in stdTypes)
                                    {
                                        bool isSel = (string.Equals(t, curType, StringComparison.OrdinalIgnoreCase));
                                        if (isSel) matchedType = true;
                                        <option value="@t" selected="@(isSel ? "selected" : null)">@t@(t == "SSD NVMe" ? " (Tốc độ cao)" : "")</option>
                                    }
                                    if (!matchedType && !string.IsNullOrWhiteSpace(curType))
                                    {
                                        <option value="@curType" selected>@curType (Hiện tại)</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <!-- 2. Hình ảnh sản phẩm -->
                    <h6 class="text-dark fw-bold mb-2" style="font-size: 0.9rem;">
                        <i class="bi bi-image text-warning me-1"></i> Hình ảnh sản phẩm
                    </h6>

                    @if (!string.IsNullOrEmpty(Model.ExistingThumbnail))
                    {
                        <div class="p-2 mb-3 rounded d-flex align-items-center gap-3 border" style="background: #f8fafc;">
                            <img src="@Model.ExistingThumbnail" onerror="this.src='/images/default.png'" 
                                 style="width: 50px; height: 50px; object-fit: contain; background: #ffffff; border-radius: 6px;" class="border" />
                            <div>
                                <span class="text-secondary small d-block">Ảnh đại diện hiện tại</span>
                                <span class="text-dark small fw-semibold">Đang sử dụng</span>
                            </div>
                        </div>
                    }

                    <div class="admin-dropzone" onclick="document.getElementById('imageFileInputEdit').click()">
                        <input asp-for="UploadedImage" id="imageFileInputEdit" type="file" class="d-none" accept="image/*" onchange="previewImageEdit(this)" />
                        <div id="dropzoneContentEdit">
                            <i class="bi bi-cloud-arrow-up dropzone-icon"></i>
                            <div class="dropzone-title">Kéo thả ảnh mới vào đây hoặc nhấp để thay ảnh</div>
                            <div class="dropzone-sub">Hỗ trợ định dạng JPG, PNG, WEBP, tối đa 5MB</div>
                        </div>
                        <div id="previewContainerEdit" class="d-none text-center">
                            <img id="imagePreviewEdit" src="#" alt="Preview" style="max-height: 120px; max-width: 100%; object-fit: contain; border-radius: 8px;" class="mb-2" />
                            <div class="text-primary small fw-semibold" id="fileNameDisplayEdit"></div>
                            <button type="button" class="btn btn-sm btn-link text-danger text-decoration-none mt-1 p-0" onclick="removeImageEdit(event)">
                                <i class="bi bi-x-circle"></i> Đổi ảnh khác
                            </button>
                        </div>
                    </div>
                </div>

                <!-- 3. Action Buttons -->
                <div class="d-flex align-items-center justify-content-end gap-3 mt-4 pt-3 border-top border-secondary">
                    <a asp-action="Index" class="btn-secondary-custom px-4">Hủy</a>
                    <button type="submit" class="btn-primary-custom px-4">
                        <i class="bi bi-check2-circle"></i> Lưu cập nhật
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        function previewImageEdit(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('imagePreviewEdit').src = e.target.result;
                    document.getElementById('fileNameDisplayEdit').innerText = input.files[0].name;
                    document.getElementById('dropzoneContentEdit').classList.add('d-none');
                    document.getElementById('previewContainerEdit').classList.remove('d-none');
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        function removeImageEdit(e) {
            e.stopPropagation();
            document.getElementById('imageFileInputEdit').value = '';
            document.getElementById('previewContainerEdit').classList.add('d-none');
            document.getElementById('dropzoneContentEdit').classList.remove('d-none');
        }
    </script>
}
