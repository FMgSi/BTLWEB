@model LaptopStore.ViewModels.ProductEditViewModel
@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm #" + Model.ProductId;
}

<div class="page-header">
    <div>
        <h2 class="page-title">Chỉnh sửa sản phẩm: @Model.ProductName <span class="text-muted font-monospace fs-6">#SP@(Model.ProductId.ToString("D3"))</span></h2>
        <p class="text-muted small mb-0">Cập nhật thông tin chi tiết, giá bán, tồn kho và cấu hình máy</p>
    </div>
    <div class="page-actions">
        <a asp-action="Index" class="btn-secondary-custom">
            <i class="bi bi-arrow-left"></i> Trở lại danh sách
        </a>
    </div>
</div>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ProductId" />
    <input type="hidden" asp-for="ExistingThumbnail" />

    <div class="row g-4">
        <!-- ==================== CỘT TRÁI: THÔNG TIN SẢN PHẨM ==================== -->
        <div class="col-lg-6">
            <div class="admin-card h-100">
                <div class="admin-card-header">
                    <h5 class="card-title-text">
                        <i class="bi bi-info-circle text-primary"></i> Thông tin sản phẩm
                    </h5>
                </div>

                <!-- Tên sản phẩm -->
                <div class="mb-3">
                    <label asp-for="ProductName" class="form-label-dark">Tên sản phẩm *</label>
                    <input asp-for="ProductName" class="form-control-dark" />
                    <span asp-validation-for="ProductName" class="text-danger small"></span>
                </div>

                <!-- Thương hiệu & Phân khúc -->
                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label asp-for="BrandId" class="form-label-dark">Thương hiệu *</label>
                        <select asp-for="BrandId" class="form-select-dark" asp-items="ViewBag.Brands"></select>
                        <span asp-validation-for="BrandId" class="text-danger small"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="CategoryId" class="form-label-dark">Phân khúc *</label>
                        <select asp-for="CategoryId" class="form-select-dark" asp-items="ViewBag.Categories"></select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Giá bán & Số lượng -->
                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label asp-for="Price" class="form-label-dark">Giá bán (VNĐ) *</label>
                        <input asp-for="Price" type="number" class="form-control-dark" />
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="StockQuantity" class="form-label-dark">Số lượng kho *</label>
                        <input asp-for="StockQuantity" type="number" class="form-control-dark" />
                        <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Giá khuyến mãi -->
                <div class="mb-3">
                    <label asp-for="DiscountPrice" class="form-label-dark">Giá khuyến mãi (VNĐ - tùy chọn)</label>
                    <input asp-for="DiscountPrice" type="number" class="form-control-dark" />
                </div>

                <!-- Mô tả sản phẩm -->
                <div class="mb-3">
                    <label asp-for="Description" class="form-label-dark">Mô tả sản phẩm</label>
                    <textarea asp-for="Description" class="form-control-dark" rows="5"></textarea>
                </div>
            </div>
        </div>

        <!-- ==================== CỘT PHẢI: CẤU HÌNH & HÌNH ẢNH ==================== -->
        <div class="col-lg-6">
            <div class="admin-card h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="admin-card-header">
                        <h5 class="card-title-text">
                            <i class="bi bi-cpu text-primary"></i> Cấu hình & Hình ảnh
                        </h5>
                    </div>

                    <!-- 1. Cấu hình chi tiết -->
                    <h6 class="text-dark fw-bold mb-3" style="font-size: 0.9rem;">
                        <i class="bi bi-motherboard text-primary me-1"></i> Cấu hình chi tiết
                    </h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6 col-12">
                            <label class="form-label-dark">Vi xử lý (CPU)</label>
                            <input asp-for="CPU" class="form-control-dark" placeholder="VD: Intel Core i7-13650HX hoặc AMD Ryzen 7" />
                        </div>
                        <div class="col-md-6 col-12">
                            <label class="form-label-dark">Card đồ họa (VGA)</label>
                            <input asp-for="GPU" class="form-control-dark" placeholder="VD: NVIDIA RTX 4060 8GB" />
                        </div>
                        <div class="col-md-4 col-12">
                            <label class="form-label-dark">Bộ nhớ RAM <span class="text-danger">*</span></label>
                            <select asp-for="RamGB" class="form-select-dark">
                                @{
                                    var stdRams = new[] { 4, 8, 12, 16, 24, 32, 48, 64, 96, 128 };
                                    int curRam = Model.RamGB ?? 16;
                                    bool matchedRam = false;
                                    foreach (var r in stdRams)
                                    {
                                        bool isSel = (r == curRam);
                                        if (isSel) matchedRam = true;
                                        <option value="@r" selected="@(isSel ? "selected" : null)">@r GB@(r == 16 ? " (Tiêu chuẩn)" : r == 32 ? " (Cao cấp)" : "")</option>
                                    }
                                    if (!matchedRam && curRam > 0)
                                    {
                                        <option value="@curRam" selected>@curRam GB (Hiện tại)</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-4 col-12">
                            <label class="form-label-dark">Dung lượng ổ cứng <span class="text-danger">*</span></label>
                            <select asp-for="StorageGB" class="form-select-dark">
                                @{
                                    var stdStorages = new (int val, string text)[] {
                                        (128, "128 GB"),
                                        (256, "256 GB"),
                                        (512, "512 GB (Tiêu chuẩn)"),
                                        (1024, "1 TB (1024 GB)"),
                                        (2048, "2 TB (2048 GB)"),
                                        (4096, "4 TB (4096 GB)")
                                    };
                                    int curStorage = Model.StorageGB ?? 512;
                                    bool matchedStorage = false;
                                    foreach (var s in stdStorages)
                                    {
                                        bool isSel = (s.val == curStorage);
                                        if (isSel) matchedStorage = true;
                                        <option value="@s.val" selected="@(isSel ? "selected" : null)">@s.text</option>
                                    }
                                    if (!matchedStorage && curStorage > 0)
                                    {
                                        <option value="@curStorage" selected>@curStorage GB (Hiện tại)</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-4 col-12">
                            <label class="form-label-dark">Loại ổ cứng <span class="text-danger">*</span></label>
                            <select asp-for="StorageType" class="form-select-dark">
                                @{
                                    var stdTypes = new[] { "SSD NVMe", "SSD SATA", "HDD" };
                                    string curType = Model.StorageType ?? "SSD NVMe";
                                    bool matchedType = false;
                                    foreach (var t in stdTypes)
                                    {
                                        bool isSel = (string.Equals(t, curType, StringComparison.OrdinalIgnoreCase));
                                        if (isSel) matchedType = true;
                                        <option value="@t" selected="@(isSel ? "selected" : null)">@t@(t == "SSD NVMe" ? " (Tốc độ cao)" : "")</option>
                                    }
                                    if (!matchedType && !string.IsNullOrWhiteSpace(curType))
                                    {
                                        <option value="@curType" selected>@curType (Hiện tại)</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <!-- 2. Quản lý hình ảnh sản phẩm (Tối đa 4 ảnh cho sản phẩm) -->
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="text-dark fw-bold mb-0" style="font-size: 0.9rem;">
                            <i class="bi bi-images text-danger me-1"></i> Bộ ảnh sản phẩm (Tối đa 4 ảnh cố định)
                        </h6>
                        <span class="badge bg-light text-muted border" style="font-size: 11px;">1 ảnh đại diện + 3 ảnh chi tiết</span>
                    </div>

                    <div class="alert alert-light border py-2 px-3 mb-3 small text-muted">
                        <i class="bi bi-info-circle text-primary me-1"></i> Sản phẩm có tối đa 4 ảnh dùng chung cho tất cả phiên bản màu sắc và cấu hình.
                    </div>

                    <input type="hidden" asp-for="DeleteSlot2" id="deleteSlot2Input" value="false" />
                    <input type="hidden" asp-for="DeleteSlot3" id="deleteSlot3Input" value="false" />
                    <input type="hidden" asp-for="DeleteSlot4" id="deleteSlot4Input" value="false" />

                    <!-- 4 Ô ảnh theo thứ tự 1-4 -->
                    <div class="row g-2 mb-3">
                        <!-- Ô 1: Ảnh đại diện -->
                        <div class="col-6 col-md-3">
                            <div class="card h-100 border p-2 text-center bg-white shadow-sm slot-card">
                                <span class="badge bg-dark mb-2 small text-truncate" title="Ô 1 · Ảnh đại diện">Ô 1 · Đại diện</span>
                                <div class="slot-preview-wrapper mb-2 d-flex align-items-center justify-content-center border rounded bg-light" style="height: 100px; overflow: hidden;">
                                    <img id="slot1Preview" src="@(string.IsNullOrEmpty(Model.Slot1Url) ? "/images/placeholder.png" : Model.Slot1Url)" alt="Ô 1" style="max-height: 90px; max-width: 100%; object-fit: contain;" />
                                </div>
                                <input asp-for="Slot1Image" id="slot1FileInput" type="file" class="d-none" accept="image/*" onchange="handleSlotFileChange(1, this)" />
                                <button type="button" class="btn btn-sm btn-outline-dark w-100 mt-auto" onclick="document.getElementById('slot1FileInput').click()">
                                    <i class="bi bi-camera"></i> Thay ảnh
                                </button>
                                <div id="slot1FileName" class="text-primary small text-truncate mt-1" style="font-size: 10px;"></div>
                            </div>
                        </div>

                        <!-- Ô 2: Ảnh phụ 1 -->
                        <div class="col-6 col-md-3">
                            <div class="card h-100 border p-2 text-center bg-white shadow-sm slot-card">
                                <span class="badge bg-secondary mb-2 small text-truncate" title="Ô 2 · Ảnh phụ">Ô 2 · Ảnh phụ</span>
                                <div class="slot-preview-wrapper mb-2 d-flex align-items-center justify-content-center border rounded bg-light" style="height: 100px; overflow: hidden;">
                                    <img id="slot2Preview" src="@(string.IsNullOrEmpty(Model.Slot2Url) ? "/images/placeholder.png" : Model.Slot2Url)" alt="Ô 2" style="max-height: 90px; max-width: 100%; object-fit: contain;" />
                                </div>
                                <input asp-for="Slot2Image" id="slot2FileInput" type="file" class="d-none" accept="image/*" onchange="handleSlotFileChange(2, this)" />
                                <div class="btn-group w-100 btn-group-sm mt-auto">
                                    <button type="button" class="btn btn-outline-dark" onclick="document.getElementById('slot2FileInput').click()" title="Thay hoặc thêm ảnh">
                                        <i class="bi bi-upload"></i> Thay
                                    </button>
                                    <button type="button" class="btn btn-outline-danger" id="slot2DeleteBtn" onclick="deleteSlotImage(2)" title="Xóa ảnh ô này" @(string.IsNullOrEmpty(Model.Slot2Url) ? "disabled" : "")>
                                        <i class="bi bi-trash"></i> Xóa
                                    </button>
                                </div>
                                <div id="slot2FileName" class="text-primary small text-truncate mt-1" style="font-size: 10px;"></div>
                            </div>
                        </div>

                        <!-- Ô 3: Ảnh phụ 2 -->
                        <div class="col-6 col-md-3">
                            <div class="card h-100 border p-2 text-center bg-white shadow-sm slot-card">
                                <span class="badge bg-secondary mb-2 small text-truncate" title="Ô 3 · Ảnh phụ">Ô 3 · Ảnh phụ</span>
                                <div class="slot-preview-wrapper mb-2 d-flex align-items-center justify-content-center border rounded bg-light" style="height: 100px; overflow: hidden;">
                                    <img id="slot3Preview" src="@(string.IsNullOrEmpty(Model.Slot3Url) ? "/images/placeholder.png" : Model.Slot3Url)" alt="Ô 3" style="max-height: 90px; max-width: 100%; object-fit: contain;" />
                                </div>
                                <input asp-for="Slot3Image" id="slot3FileInput" type="file" class="d-none" accept="image/*" onchange="handleSlotFileChange(3, this)" />
                                <div class="btn-group w-100 btn-group-sm mt-auto">
                                    <button type="button" class="btn btn-outline-dark" onclick="document.getElementById('slot3FileInput').click()" title="Thay hoặc thêm ảnh">
                                        <i class="bi bi-upload"></i> Thay
                                    </button>
                                    <button type="button" class="btn btn-outline-danger" id="slot3DeleteBtn" onclick="deleteSlotImage(3)" title="Xóa ảnh ô này" @(string.IsNullOrEmpty(Model.Slot3Url) ? "disabled" : "")>
                                        <i class="bi bi-trash"></i> Xóa
                                    </button>
                                </div>
                                <div id="slot3FileName" class="text-primary small text-truncate mt-1" style="font-size: 10px;"></div>
                            </div>
                        </div>

                        <!-- Ô 4: Ảnh phụ 3 -->
                        <div class="col-6 col-md-3">
                            <div class="card h-100 border p-2 text-center bg-white shadow-sm slot-card">
                                <span class="badge bg-secondary mb-2 small text-truncate" title="Ô 4 · Ảnh phụ">Ô 4 · Ảnh phụ</span>
                                <div class="slot-preview-wrapper mb-2 d-flex align-items-center justify-content-center border rounded bg-light" style="height: 100px; overflow: hidden;">
                                    <img id="slot4Preview" src="@(string.IsNullOrEmpty(Model.Slot4Url) ? "/images/placeholder.png" : Model.Slot4Url)" alt="Ô 4" style="max-height: 90px; max-width: 100%; object-fit: contain;" />
                                </div>
                                <input asp-for="Slot4Image" id="slot4FileInput" type="file" class="d-none" accept="image/*" onchange="handleSlotFileChange(4, this)" />
                                <div class="btn-group w-100 btn-group-sm mt-auto">
                                    <button type="button" class="btn btn-outline-dark" onclick="document.getElementById('slot4FileInput').click()" title="Thay hoặc thêm ảnh">
                                        <i class="bi bi-upload"></i> Thay
                                    </button>
                                    <button type="button" class="btn btn-outline-danger" id="slot4DeleteBtn" onclick="deleteSlotImage(4)" title="Xóa ảnh ô này" @(string.IsNullOrEmpty(Model.Slot4Url) ? "disabled" : "")>
                                        <i class="bi bi-trash"></i> Xóa
                                    </button>
                                </div>
                                <div id="slot4FileName" class="text-primary small text-truncate mt-1" style="font-size: 10px;"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. Action Buttons -->
                <div class="d-flex align-items-center justify-content-end gap-3 mt-4 pt-3 border-top border-secondary">
                    <a asp-action="Index" class="btn-secondary-custom px-4">Hủy</a>
                    <button type="submit" class="btn-primary-custom px-4">
                        <i class="bi bi-check2-circle"></i> Lưu cập nhật
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-lite.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-lite.min.js"></script>
    <script>
        $(document).ready(function() {
            $('#Description').summernote({
                placeholder: 'Nhập mô tả tính năng nổi bật, thiết kế, màn hình của máy...',
                tabsize: 2,
                height: 150,
                toolbar: [
                    ['style', ['bold', 'italic', 'underline', 'clear']],
                    ['font', ['strikethrough']],
                    ['para', ['ul', 'ol', 'paragraph']],
                    ['insert', ['link', 'table', 'hr']]
                ]
            });
        });

        function handleSlotFileChange(slot, input) {
            if (input.files && input.files[0]) {
                const file = input.files[0];
                const reader = new FileReader();
                reader.onload = function(e) {
                    const img = document.getElementById('slot' + slot + 'Preview');
                    if (img) img.src = e.target.result;
                    const nameDiv = document.getElementById('slot' + slot + 'FileName');
                    if (nameDiv) nameDiv.innerText = file.name;
                    if (slot > 1) {
                        const delInput = document.getElementById('deleteSlot' + slot + 'Input');
                        if (delInput) delInput.value = 'false';
                        const delBtn = document.getElementById('slot' + slot + 'DeleteBtn');
                        if (delBtn) delBtn.disabled = false;
                    }
                };
                reader.readAsDataURL(file);
            }
        }

        function deleteSlotImage(slot) {
            const input = document.getElementById('slot' + slot + 'FileInput');
            if (input) input.value = '';

            const img = document.getElementById('slot' + slot + 'Preview');
            if (img) img.src = '/images/placeholder.png';

            const nameDiv = document.getElementById('slot' + slot + 'FileName');
            if (nameDiv) nameDiv.innerText = '';

            const delInput = document.getElementById('deleteSlot' + slot + 'Input');
            if (delInput) delInput.value = 'true';

            const delBtn = document.getElementById('slot' + slot + 'DeleteBtn');
            if (delBtn) delBtn.disabled = true;
        }
    </script>
}
