@model LaptopStore.Models.Product

@{
    ViewData["Title"] = $"Quản lý phiên bản & màu sắc: {Model.ProductName}";
    var activeColors = ViewBag.ActiveColors as List<LaptopStore.Models.Color> ?? new List<LaptopStore.Models.Color>();
    int totalVariantStock = Model.Variants?.Sum(v => v.StockQuantity) ?? 0;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="/Product" class="text-decoration-none">Sản phẩm</a></li>
                <li class="breadcrumb-item active" aria-current="page">Phiên bản & Màu sắc</li>
            </ol>
        </nav>
        <h1 class="h3 text-primary mb-1"><i class="bi bi-palette-fill me-2"></i>Quản lý Phiên Bản: @Model.ProductName</h1>
        <p class="text-muted mb-0">Quản lý các biến thể màu sắc, cấu hình RAM/SSD và tồn kho độc lập cho từng phiên bản bán hàng</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/Product" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Danh sách laptop
        </a>
        <a href="/Catalog/Details/@Model.ProductId" target="_blank" class="btn btn-outline-primary">
            <i class="bi bi-box-arrow-up-right me-1"></i> Xem trang bán hàng
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- THÔNG TIN TỔNG QUAN LAPTOP -->
<div class="card shadow-sm border-0 rounded-3 mb-4">
    <div class="card-body p-3">
        <div class="row align-items-center g-3">
            <div class="col-auto">
                <img src="@(string.IsNullOrWhiteSpace(Model.ThumbnailUrl) ? "/images/placeholder.png" : Model.ThumbnailUrl)" 
                     alt="@Model.ProductName" 
                     class="rounded border bg-light p-1" 
                     style="width: 80px; height: 80px; object-fit: contain;" />
            </div>
            <div class="col">
                <h4 class="fw-bold mb-1">@Model.ProductName</h4>
                <div class="d-flex flex-wrap gap-2 text-muted small align-items-center">
                    <span><i class="bi bi-buildings me-1"></i>Hãng: <strong>@(Model.Brand?.BrandName ?? "-")</strong></span>
                    <span>•</span>
                    <span><i class="bi bi-tag me-1"></i>Danh mục: <strong>@(Model.Category?.CategoryName ?? "-")</strong></span>
                    <span>•</span>
                    <span><i class="bi bi-cpu me-1"></i>CPU: <strong>@(Model.Specification?.CPU ?? "-")</strong></span>
                </div>
            </div>
            <div class="col-auto text-end border-start ps-4">
                <div class="text-muted small">Tổng tồn kho (các phiên bản)</div>
                <div class="fs-3 fw-bold @(totalVariantStock > 0 ? "text-success" : "text-danger")">
                    @totalVariantStock <span class="fs-6 fw-normal text-muted">máy</span>
                </div>
                <div class="small text-muted">Đang có @(Model.Variants?.Count ?? 0) phiên bản</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- FORM THÊM MỚI PHIÊN BẢN -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 rounded-3 h-100">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="card-title mb-0 fs-6 fw-bold">
                    <i class="bi bi-plus-circle me-1"></i> Thêm phiên bản mới
                </h5>
            </div>
            <div class="card-body p-3">
                <form asp-action="AddVariant" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ProductId" value="@Model.ProductId" />

                    <!-- Chọn Màu Sắc -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Màu sắc <span class="text-danger">*</span></label>
                        <select name="ColorId" class="form-select" required>
                            <option value="">-- Chọn màu sắc --</option>
                            @foreach (var c in activeColors)
                            {
                                <option value="@c.ColorId">@c.Name (@c.HexCode)</option>
                            }
                        </select>
                        <div class="form-text small">
                            Chưa có màu bạn cần? <a href="/Colors/Create" target="_blank" class="text-decoration-none">Thêm màu mới tại đây</a>
                        </div>
                    </div>

                    <!-- RAM & Storage -->
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold small">RAM (GB) <span class="text-danger">*</span></label>
                            <input type="number" name="RamGB" class="form-control" value="@(Model.Specification?.RamGB ?? 16)" min="4" max="128" step="4" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold small">SSD (GB) <span class="text-danger">*</span></label>
                            <input type="number" name="StorageGB" class="form-control" value="@(Model.Specification?.StorageGB ?? 512)" min="128" max="4096" step="128" required />
                        </div>
                    </div>

                    <!-- Số lượng tồn ban đầu -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Số lượng tồn kho ban đầu <span class="text-danger">*</span></label>
                        <input type="number" name="StockQuantity" class="form-control" value="1" min="0" required />
                        <div class="form-text small">Số máy màu/cấu hình này hiện có trong kho hàng</div>
                    </div>

                    <!-- Giá bán riêng (nếu khác giá gốc) -->
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Giá niêm yết (₫)</label>
                            <input type="number" name="Price" class="form-control" value="@Model.Price" min="0" step="100000" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Giá khuyến mãi (₫)</label>
                            <input type="number" name="DiscountPrice" class="form-control" value="@(Model.DiscountPrice?.ToString() ?? "")" min="0" step="100000" placeholder="Tùy chọn" />
                        </div>
                    </div>

                    <!-- Mã SKU tùy chỉnh -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Mã SKU (Tùy chọn)</label>
                        <input type="text" name="SKU" class="form-control font-monospace" placeholder="Tự sinh nếu để trống" />
                    </div>

                    <button type="submit" class="btn btn-primary w-100 shadow-sm">
                        <i class="bi bi-save me-1"></i> Lưu phiên bản
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- BẢNG DANH SÁCH PHIÊN BẢN -->
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-light py-3 d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 fs-6 fw-bold">
                    <i class="bi bi-list-stars me-1"></i> Danh sách các phiên bản đang có
                </h5>
                <span class="badge bg-secondary">@(Model.Variants?.Count ?? 0) phiên bản</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th class="ps-3">Màu sắc</th>
                                <th>Cấu hình</th>
                                <th>Mã SKU</th>
                                <th>Giá bán</th>
                                <th style="width: 170px;">Tồn kho</th>
                                <th>Trạng thái</th>
                                <th class="text-end pe-3">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (Model.Variants != null && Model.Variants.Any())
                        {
                            @foreach (var v in Model.Variants.OrderBy(v => v.Color?.Name))
                            {
                                <tr>
                                    <td class="ps-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="rounded-circle border shadow-sm" 
                                                  style="width: 22px; height: 22px; background-color: @(v.Color?.HexCode ?? "#ccc"); flex-shrink: 0;"></span>
                                            <span class="fw-semibold">@(v.Color?.Name ?? "Chưa rõ")</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @v.RamGB GB / @(v.StorageGB >= 1024 ? $"{v.StorageGB / 1024}TB" : $"{v.StorageGB}GB")
                                        </span>
                                    </td>
                                    <td>
                                        <code class="small">@v.SKU</code>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-danger small">
                                            @((v.EffectivePrice > 0 ? v.EffectivePrice : (Model.DiscountPrice ?? Model.Price)).ToString("N0")) ₫
                                        </div>
                                        @if (v.DiscountPrice.HasValue && v.Price > v.DiscountPrice.Value)
                                        {
                                            <del class="text-muted small">@((v.Price ?? 0).ToString("N0")) ₫</del>
                                        }
                                    </td>
                                    <td>
                                        <!-- Form điều chỉnh tồn kho trực tiếp -->
                                        <form asp-action="AdjustVariantStock" method="post" class="d-flex gap-1 align-items-center">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="VariantId" value="@v.VariantId" />
                                            <input type="number" name="NewStockQuantity" value="@v.StockQuantity" min="0" class="form-control form-control-sm text-center" style="width: 70px;" />
                                            <button type="submit" class="btn btn-sm btn-outline-success" title="Cập nhật số lượng kho">
                                                <i class="bi bi-check"></i>
                                            </button>
                                        </form>
                                    </td>
                                    <td>
                                        <form asp-action="ToggleVariant" asp-route-id="@v.VariantId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            @if (v.IsActive)
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-success rounded-pill py-0 px-2 small" title="Bấm để vô hiệu hóa">
                                                    Đang bán
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill py-0 px-2 small" title="Bấm để kích hoạt lại">
                                                    Ngừng bán
                                                </button>
                                            }
                                        </form>
                                    </td>
                                    <td class="text-end pe-3">
                                        @if (v.StockQuantity == 0)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle small">Hết hàng</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle small">Còn @v.StockQuantity</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    <i class="bi bi-palette fs-2 text-secondary d-block mb-1"></i>
                                    Sản phẩm này chưa được cấu hình phiên bản màu sắc nào.<br />
                                    Vui lòng dùng form bên trái để thêm phiên bản đầu tiên!
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
