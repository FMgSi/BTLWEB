@model LaptopStore.ViewModels.ProductDetailDto
@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = Model.Name;
    var related = ViewBag.RelatedProducts as List<LaptopStore.ViewModels.ProductApiDto> ?? new();
}

<div class="container">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="/Catalog" class="text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="/Catalog?category=@Uri.EscapeDataString(Model.Category)" class="text-decoration-none">@Model.Category</a></li>
            <li class="breadcrumb-item"><a href="/Catalog?brand=@Uri.EscapeDataString(Model.Brand)" class="text-decoration-none">@Model.Brand</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <!-- Khối Thông tin chính của Laptop -->
    <div class="row g-4 mb-5">
        <!-- Cột trái: Ảnh sản phẩm và Thư viện ảnh -->
        <div class="col-12 col-lg-6">
            <div class="detail-gallery-main shadow-sm mb-3">
                <img id="mainProductImg" 
                     src="@(string.IsNullOrEmpty(Model.Image) ? "/images/products/placeholder.png" : Model.Image)" 
                     alt="@Model.Name" 
                     class="img-fluid" 
                     onerror="this.src='/images/products/placeholder.png'" />
            </div>

            @if (Model.Images != null && Model.Images.Count > 1)
            {
                <div class="d-flex gap-2 overflow-x-auto pb-2">
                    @for (int i = 0; i < Model.Images.Count; i++)
                    {
                        var imgUrl = Model.Images[i];
                        <button type="button" class="btn p-1 border rounded @(i == 0 ? "border-primary" : "border-light") bg-white" 
                                onclick="document.getElementById('mainProductImg').src = '@imgUrl'">
                            <img src="@imgUrl" alt="Thumbnail @i" style="width: 70px; height: 55px; object-fit: contain;" />
                        </button>
                    }
                </div>
            }
        </div>

        <!-- Cột phải: Giá, Cấu hình nổi bật và Đặt mua -->
        <div class="col-12 col-lg-6">
            <div class="bg-white p-4 rounded-3 border shadow-sm">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge bg-primary">@Model.Brand</span>
                    <span class="badge bg-light text-secondary border">@Model.Category</span>
                    <span id="stockBadgeWrap">
                        @if (Model.StockQuantity > 0)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                <i class="bi bi-check-circle-fill me-1"></i> Còn @Model.StockQuantity máy
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                <i class="bi bi-x-circle-fill me-1"></i> Tạm hết hàng
                            </span>
                        }
                    </span>
                </div>

                <h1 class="h4 fw-bold text-dark mb-3">@Model.Name</h1>

                <!-- Hộp giá -->
                <div class="detail-price-box mb-4">
                    <div class="d-flex align-items-baseline gap-3">
                        <span class="fs-2 fw-extrabold text-danger" id="detailDisplayPrice">@Model.Price.ToString("N0")đ</span>
                        @if (Model.OriginalPrice.HasValue && Model.OriginalPrice > Model.Price)
                        {
                            <span class="text-muted text-decoration-line-through fs-5">@Model.OriginalPrice.Value.ToString("N0")đ</span>
                            <span class="badge bg-danger fs-6">-@Model.DiscountPercent%</span>
                        }
                    </div>
                    <div class="small text-muted mt-1">
                        <i class="bi bi-shield-check text-success me-1"></i> Đã bao gồm thuế VAT • Bảo hành chính hãng
                    </div>
                </div>

                <!-- Cấu hình tóm tắt -->
                @if (Model.Specification != null)
                {
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <div class="p-2 border rounded bg-light small">
                                <div class="text-muted">Vi xử lý (CPU)</div>
                                <strong class="text-dark">@Model.Specification.CPU</strong>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-2 border rounded bg-light small">
                                <div class="text-muted">Card đồ họa</div>
                                <strong class="text-dark">@Model.Specification.GPU</strong>
                            </div>
                        </div>
                    </div>
                }

                <!-- CHỌN PHIÊN BẢN & MÀU SẮC (PRODUCT VARIANTS) -->
                @if (Model.Variants != null && Model.Variants.Any())
                {
                    <div class="mb-4 p-3 bg-light rounded-3 border">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label fw-bold text-dark small text-uppercase mb-0">
                                <i class="bi bi-palette-fill text-primary me-1"></i> 1. Chọn màu sắc máy:
                            </label>
                            <span id="selectedColorNameBadge" class="badge bg-primary"></span>
                        </div>
                        
                        <!-- Danh sách Màu sắc Swatches -->
                        <div class="d-flex flex-wrap gap-2 mb-3" id="colorSelectorWrap"></div>

                        <!-- Cấu hình RAM & SSD tương ứng với màu -->
                        <label class="form-label fw-bold text-dark small text-uppercase mb-1">
                            <i class="bi bi-cpu text-primary me-1"></i> 2. Cấu hình có sẵn:
                        </label>
                        <div class="d-flex flex-wrap gap-2 mb-2" id="configSelectorWrap"></div>

                        <!-- Trạng thái tồn kho của màu/cấu hình đã chọn -->
                        <div id="variantStockInfo" class="mt-2 pt-2 border-top small"></div>
                    </div>
                }

                <!-- Nút hành động đặt hàng -->
                <div id="orderActionButtonsWrap" class="mb-3">
                    <div class="row g-2">
                        @if (Model.StockQuantity > 0)
                        {
                            <div class="col-12 col-md-6">
                                <button type="button" id="btnBuyFull" class="btn btn-danger btn-lg fw-bold w-100 py-3 shadow-sm" onclick="openOrderModal('Full')">
                                    <i class="bi bi-cart-check me-1"></i> MUA TRẢ THẲNG
                                    <span class="d-block small fw-normal" style="font-size: 0.75rem;">Giao tận nơi hoặc nhận tại cửa hàng</span>
                                </button>
                            </div>
                            <div class="col-12 col-md-6">
                                <button type="button" id="btnBuyInstallment" class="btn btn-primary btn-lg fw-bold w-100 py-3 shadow-sm" onclick="openOrderModal('Installment')">
                                    <i class="bi bi-credit-card-2-front me-1"></i> MUA TRẢ GÓP 0%
                                    <span class="d-block small fw-normal" style="font-size: 0.75rem;">Trả trước 30% • Duyệt nhanh</span>
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="col-12">
                                <button class="btn btn-secondary btn-lg fw-bold w-100 py-3" disabled>
                                    <i class="bi bi-bell me-2"></i> SẢN PHẨM TẠM HẾT HÀNG
                                </button>
                            </div>
                        }
                    </div>
                </div>

                <!-- Thông tin khuyến mãi bổ sung -->
                <div class="p-3 border rounded bg-light-subtle small">
                    <div class="fw-bold mb-2 text-primary"><i class="bi bi-gift-fill me-1"></i> Quà tặng & Ưu đãi đặc quyền:</div>
                    <ul class="mb-0 ps-3 text-muted">
                        <li>Tặng balo laptop cao cấp chống sốc và chuột không dây chính hãng.</li>
                        <li>Cài đặt hệ điều hành và phần mềm tiện ích văn phòng miễn phí trọn đời máy.</li>
                        <li>Vệ sinh máy và tra keo tản nhiệt miễn phí định kỳ trong 2 năm.</li>
                        <li>Hỗ trợ trả góp lãi suất 0% qua thẻ tín dụng hoặc hồ sơ CMND/CCCD.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng thông số kỹ thuật chi tiết & Mô tả sản phẩm -->
    <div class="row g-4 mb-5">
        <!-- Bảng chi tiết cấu hình -->
        <div class="col-12 col-lg-7">
            <div class="bg-white p-4 rounded-3 border shadow-sm">
                <h2 class="h5 fw-bold mb-3 border-bottom pb-2">
                    <i class="bi bi-sliders text-primary me-2"></i> Thông số kỹ thuật chi tiết
                </h2>

                @if (Model.Specification != null)
                {
                    <table class="table detail-specs-table mb-0">
                        <tbody>
                            <tr>
                                <td class="text-muted" style="width: 35%;">CPU (Bộ vi xử lý)</td>
                                <td class="fw-semibold">@Model.Specification.CPU</td>
                            </tr>
                            <tr>
                                <td class="text-muted">RAM</td>
                                <td class="fw-semibold">@Model.Specification.RamGB GB</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Ổ cứng</td>
                                <td class="fw-semibold">@Model.Specification.StorageGB GB @Model.Specification.StorageType</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Card đồ họa (GPU)</td>
                                <td class="fw-semibold">@Model.Specification.GPU</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Màn hình</td>
                                <td class="fw-semibold">@Model.Specification.ScreenSizeInch inch (@Model.Specification.RefreshRateHz Hz)</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Trọng lượng</td>
                                <td class="fw-semibold">@Model.Specification.WeightKg kg</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Dung lượng Pin</td>
                                <td class="fw-semibold">@Model.Specification.BatteryWh Wh</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Hệ điều hành</td>
                                <td class="fw-semibold">@Model.Specification.OS</td>
                            </tr>
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted small mb-0">Đang cập nhật thông số chi tiết của sản phẩm...</p>
                }
            </div>
        </div>

        <!-- Mô tả đánh giá sản phẩm -->
        <div class="col-12 col-lg-5">
            <div class="bg-white p-4 rounded-3 border shadow-sm">
                <h2 class="h5 fw-bold mb-3 border-bottom pb-2">
                    <i class="bi bi-card-text text-primary me-2"></i> Giới thiệu sản phẩm
                </h2>
                <div class="small text-secondary lh-lg">
                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p>@Model.Description</p>
                    }
                    else
                    {
                        <p>Sản phẩm @Model.Name thuộc thương hiệu @Model.Brand, phân khúc @Model.Category, được trang bị cấu hình tối ưu đáp ứng xuất sắc mọi nhu cầu làm việc, học tập và giải trí đỉnh cao.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Sản phẩm tương tự / Cùng thương hiệu -->
    @if (related.Any())
    {
        <div class="mb-5">
            <h3 class="h5 fw-bold mb-3"><i class="bi bi-stars text-warning me-2"></i> Sản phẩm tương tự bạn có thể thích</h3>
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-3">
                @foreach (var item in related)
                {
                    <div class="col">
                        <div class="product-card shadow-sm h-100">
                            <div class="product-card-img-wrap">
                                <a href="/Catalog/Details/@item.Id">
                                    <img src="@item.Image" alt="@item.Name" class="product-card-img" onerror="this.src='/images/products/placeholder.png'" />
                                </a>
                            </div>
                            <div class="p-3 d-flex flex-column justify-content-between flex-grow-1">
                                <div>
                                    <span class="product-brand-tag">@item.Brand</span>
                                    <h4 class="h6 mb-2">
                                        <a href="/Catalog/Details/@item.Id" class="product-title" title="@item.Name">@item.Name</a>
                                    </h4>
                                </div>
                                <div class="pt-2 border-top">
                                    <span class="product-price-current">@item.Price.ToString("N0")đ</span>
                                    <div class="d-grid mt-2">
                                        <a href="/Catalog/Details/@item.Id" class="btn btn-outline-primary btn-sm fw-semibold">Xem ngay</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- MODAL ĐẶT HÀNG TRẢ THẲNG & TRẢ GÓP (MỐC 1) -->
<div class="modal fade" id="orderModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-3">
            <div class="modal-header border-bottom bg-light">
                <h5 class="modal-title fs-5 fw-bold text-dark" id="orderModalTitle">
                    <i class="bi bi-cart3 text-primary me-2"></i>Đặt mua laptop
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4" id="orderModalBody">
                <!-- Chọn hình thức mua -->
                <div class="mb-4">
                    <label class="form-label fw-bold small text-muted text-uppercase mb-2">1. Chọn hình thức mua hàng</label>
                    <div class="row g-2">
                        <div class="col-6">
                            <input type="radio" class="btn-check" name="purchaseModeRadio" id="modeFull" value="Full" autocomplete="off" onchange="onModeChange('Full')">
                            <label class="btn btn-outline-primary w-100 py-3 text-start h-100" for="modeFull">
                                <div class="fw-bold"><i class="bi bi-cash-stack me-1"></i> Trả toàn bộ (Trả thẳng)</div>
                                <div class="small text-muted mt-1">Thanh toán 100% khi nhận hàng hoặc qua VietQR</div>
                                <div class="fw-bold text-danger mt-2">@Model.Price.ToString("N0")đ</div>
                            </label>
                        </div>
                        <div class="col-6">
                            <input type="radio" class="btn-check" name="purchaseModeRadio" id="modeInstallment" value="Installment" autocomplete="off" onchange="onModeChange('Installment')">
                            <label class="btn btn-outline-primary w-100 py-3 text-start h-100" for="modeInstallment">
                                <div class="fw-bold"><i class="bi bi-credit-card-2-front me-1"></i> Trả góp lãi suất 0%</div>
                                <div class="small text-muted mt-1">Trả trước 30% • Còn lại chia đều theo tháng</div>
                                <div class="fw-bold text-primary mt-2">Chỉ từ @(Math.Round(Model.Price * 0.30m).ToString("N0"))đ hôm nay</div>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Khung cấu hình trả góp nếu chọn Trả góp -->
                <div id="installmentConfigBox" class="p-3 rounded-3 border bg-light-subtle mb-4" style="display: none;">
                    <label class="form-label fw-bold small text-primary text-uppercase mb-2">
                        <i class="bi bi-calendar-range me-1"></i> 2. Chọn kỳ hạn trả góp (Lãi suất 0%)
                    </label>
                    <div class="d-flex gap-2 mb-3">
                        <button type="button" class="btn btn-outline-secondary term-btn flex-fill" data-term="3" onclick="selectTerm(3)">3 tháng</button>
                        <button type="button" class="btn btn-primary term-btn flex-fill" data-term="6" onclick="selectTerm(6)">6 tháng</button>
                        <button type="button" class="btn btn-outline-secondary term-btn flex-fill" data-term="9" onclick="selectTerm(9)">9 tháng</button>
                        <button type="button" class="btn btn-outline-secondary term-btn flex-fill" data-term="12" onclick="selectTerm(12)">12 tháng</button>
                    </div>

                    <!-- Bảng tóm tắt tài chính -->
                    <div class="row g-2 text-center small mb-3">
                        <div class="col-4">
                            <div class="p-2 bg-white rounded border">
                                <div class="text-muted">Trả trước (30%)</div>
                                <div class="fw-bold text-success fs-6" id="summaryPrepay">0đ</div>
                                <small class="text-muted">Cần thanh toán ngay</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 bg-white rounded border">
                                <div class="text-muted">Còn lại (70%)</div>
                                <div class="fw-bold text-dark fs-6" id="summaryFinanced">0đ</div>
                                <small class="text-muted">Chia đều các kỳ</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 bg-white rounded border">
                                <div class="text-muted">Mỗi tháng trả</div>
                                <div class="fw-bold text-primary fs-6" id="summaryMonthly">0đ</div>
                                <small class="text-muted" id="summaryTermText">6 kỳ hạn</small>
                            </div>
                        </div>
                    </div>

                    <!-- Lịch trả dự kiến -->
                    <div class="small">
                        <div class="fw-semibold text-muted mb-1"><i class="bi bi-info-circle me-1"></i> Lịch thanh toán dự kiến:</div>
                        <div id="schedulePreviewTable" class="table-responsive bg-white rounded border" style="max-height: 160px; overflow-y: auto;">
                            <!-- Đổ dữ liệu từ JS -->
                        </div>
                    </div>
                </div>

                <!-- Form thông tin khách hàng -->
                <form id="orderForm" onsubmit="submitCustomerOrder(event)">
                    <label class="form-label fw-bold small text-muted text-uppercase mb-2">3. Thông tin người nhận hàng</label>
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                            <input type="text" id="custName" class="form-control" placeholder="Ví dụ: Nguyễn Văn A" required />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold">Số điện thoại nhận hàng <span class="text-danger">*</span></label>
                            <input type="tel" id="custPhone" class="form-control" placeholder="Ví dụ: 0912345678" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Địa chỉ giao hàng tận nơi <span class="text-danger">*</span></label>
                            <input type="text" id="custAddress" class="form-control" placeholder="Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành..." required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Ghi chú giao hàng (nếu có)</label>
                            <input type="text" id="custNotes" class="form-control" placeholder="Ví dụ: Giao giờ hành chính, gọi trước khi đến..." />
                        </div>
                    </div>

                    <!-- Phương thức thanh toán khoản trả ngay -->
                    <div class="mb-4">
                        <label class="form-label fw-bold small text-muted text-uppercase mb-2">4. Phương thức thanh toán khoản trả ngay</label>
                        <div class="form-check p-3 border rounded mb-2">
                            <input class="form-check-input ms-0 me-2" type="radio" name="payMethodRadio" id="payVietQR" value="VietQR" checked>
                            <label class="form-check-label fw-semibold" for="payVietQR">
                                <i class="bi bi-qr-code text-primary me-1"></i> Chuyển khoản quét mã VietQR (Tự động điền số tiền & nội dung)
                            </label>
                        </div>
                        <div class="form-check p-3 border rounded">
                            <input class="form-check-input ms-0 me-2" type="radio" name="payMethodRadio" id="payCOD" value="COD">
                            <label class="form-check-label fw-semibold" for="payCOD">
                                <i class="bi bi-truck text-success me-1"></i> Thanh toán tiền mặt khi nhận máy (COD)
                            </label>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-danger btn-lg fw-bold py-3 shadow" id="btnSubmitOrder">
                            <i class="bi bi-check2-circle me-1"></i> <span id="submitBtnText">XÁC NHẬN ĐẶT HÀNG</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    const PRODUCT_ID = @Model.Id;
    let TOTAL_PRICE = @Model.Price;
    let selectedMode = 'Full';
    let selectedTerm = 6;
    const VARIANTS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Variants));
    let selectedColorId = null;
    let selectedVariant = null;

    function formatVND(num) {
        return num.toLocaleString('vi-VN') + 'đ';
    }

    // Khởi tạo bộ chọn màu sắc và cấu hình
    function initVariantSelector() {
        if (!VARIANTS || VARIANTS.length === 0) return;

        const colorMap = new Map();
        VARIANTS.forEach(v => {
            if (!colorMap.has(v.ColorId)) {
                colorMap.set(v.ColorId, {
                    colorId: v.ColorId,
                    colorName: v.ColorName,
                    hexCode: v.HexCode || '#6B7280',
                    variants: []
                });
            }
            colorMap.get(v.ColorId).variants.push(v);
        });

        const colorSelectorWrap = document.getElementById('colorSelectorWrap');
        if (!colorSelectorWrap) return;

        colorSelectorWrap.innerHTML = '';
        const colors = Array.from(colorMap.values());

        // Ưu tiên chọn màu đầu tiên có hàng, nếu không thì chọn màu đầu tiên
        let defaultColor = colors.find(c => c.variants.some(v => v.StockQuantity > 0)) || colors[0];
        selectedColorId = defaultColor.colorId;

        colors.forEach(c => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = `btn btn-sm d-flex align-items-center gap-2 p-2 rounded-3 border color-btn ${c.colorId === selectedColorId ? 'btn-primary text-white border-primary shadow-sm' : 'btn-outline-secondary bg-white'}`;
            btn.setAttribute('data-color-id', c.colorId);

            const totalColorStock = c.variants.reduce((acc, curr) => acc + curr.StockQuantity, 0);

            btn.innerHTML = `
                <span class="rounded-circle border shadow-sm" style="width: 18px; height: 18px; background-color: ${c.hexCode};"></span>
                <span class="fw-semibold">${c.colorName}</span>
                <small class="${totalColorStock > 0 ? (c.colorId === selectedColorId ? 'text-white-50' : 'text-muted') : 'text-danger'}" style="font-size: 0.7rem;">(${totalColorStock > 0 ? 'còn ' + totalColorStock : 'hết'})</small>
            `;

            btn.onclick = () => selectColor(c.colorId);
            colorSelectorWrap.appendChild(btn);
        });

        renderConfigOptions(colorMap.get(selectedColorId).variants);
    }

    function selectColor(colorId) {
        selectedColorId = colorId;

        document.querySelectorAll('.color-btn').forEach(btn => {
            const cid = parseInt(btn.getAttribute('data-color-id'));
            if (cid === colorId) {
                btn.className = 'btn btn-sm d-flex align-items-center gap-2 p-2 rounded-3 border color-btn btn-primary text-white border-primary shadow-sm';
            } else {
                btn.className = 'btn btn-sm d-flex align-items-center gap-2 p-2 rounded-3 border color-btn btn-outline-secondary bg-white';
            }
        });

        const colorVariants = VARIANTS.filter(v => v.ColorId === colorId);
        renderConfigOptions(colorVariants);
    }

    function renderConfigOptions(variants) {
        const configWrap = document.getElementById('configSelectorWrap');
        if (!configWrap) return;

        configWrap.innerHTML = '';
        if (!variants || variants.length === 0) return;

        // Chọn biến thể đầu tiên còn hàng, hoặc biến thể đầu tiên
        let chosen = variants.find(v => v.StockQuantity > 0) || variants[0];
        selectedVariant = chosen;

        variants.forEach(v => {
            const btn = document.createElement('button');
            btn.type = 'button';
            const isSelected = (v.VariantId === chosen.VariantId);
            const inStock = v.StockQuantity > 0;

            btn.className = `btn btn-sm config-btn p-2 rounded-3 border text-start ${isSelected ? 'btn-primary text-white border-primary shadow-sm' : 'btn-outline-secondary bg-white'}`;
            btn.setAttribute('data-variant-id', v.VariantId);

            const storageText = (v.StorageGB >= 1024) ? `${v.StorageGB / 1024}TB` : `${v.StorageGB}GB`;
            const priceText = formatVND(v.EffectivePrice > 0 ? v.EffectivePrice : TOTAL_PRICE);

            btn.innerHTML = `
                <div class="fw-bold">RAM ${v.RamGB}GB • ${storageText}</div>
                <div class="small ${isSelected ? 'text-white-50' : 'text-muted'}" style="font-size: 0.72rem;">${priceText} • ${inStock ? 'Còn ' + v.StockQuantity + ' máy' : '<span class="text-danger">Hết hàng</span>'}</div>
            `;

            btn.onclick = () => selectVariant(v);
            configWrap.appendChild(btn);
        });

        applySelectedVariant(chosen);
    }

    function selectVariant(variant) {
        selectedVariant = variant;

        document.querySelectorAll('.config-btn').forEach(btn => {
            const vid = parseInt(btn.getAttribute('data-variant-id'));
            if (vid === variant.VariantId) {
                btn.className = 'btn btn-sm config-btn p-2 rounded-3 border text-start btn-primary text-white border-primary shadow-sm';
            } else {
                btn.className = 'btn btn-sm config-btn p-2 rounded-3 border text-start btn-outline-secondary bg-white';
            }
        });

        applySelectedVariant(variant);
    }

    function applySelectedVariant(variant) {
        selectedVariant = variant;
        const colorBadge = document.getElementById('selectedColorNameBadge');
        if (colorBadge) colorBadge.textContent = variant.ColorName;

        // Cập nhật giá theo biến thể
        TOTAL_PRICE = (variant.EffectivePrice > 0) ? variant.EffectivePrice : @Model.Price;
        const displayPriceEl = document.getElementById('detailDisplayPrice');
        if (displayPriceEl) displayPriceEl.textContent = formatVND(TOTAL_PRICE);

        // Cập nhật tình trạng kho của biến thể
        const stockInfo = document.getElementById('variantStockInfo');
        const stockBadgeWrap = document.getElementById('stockBadgeWrap');
        const buyFullBtn = document.getElementById('btnBuyFull');
        const buyInstallmentBtn = document.getElementById('btnBuyInstallment');

        if (variant.StockQuantity > 0) {
            if (stockInfo) {
                stockInfo.innerHTML = `
                    <span class="text-success fw-bold"><i class="bi bi-check-circle-fill me-1"></i> Có sẵn ${variant.StockQuantity} máy</span>
                    <span class="text-muted ms-2">• Màu ${variant.ColorName} (RAM ${variant.RamGB}GB/SSD ${variant.StorageGB}GB) • Mã SKU: <code>${variant.SKU}</code></span>
                `;
            }
            if (stockBadgeWrap) {
                stockBadgeWrap.innerHTML = `<span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-check-circle-fill me-1"></i> Còn ${variant.StockQuantity} máy</span>`;
            }
            if (buyFullBtn) {
                buyFullBtn.disabled = false;
                buyFullBtn.className = "btn btn-danger btn-lg fw-bold w-100 py-3 shadow-sm";
            }
            if (buyInstallmentBtn) {
                buyInstallmentBtn.disabled = false;
                buyInstallmentBtn.className = "btn btn-primary btn-lg fw-bold w-100 py-3 shadow-sm";
            }
        } else {
            if (stockInfo) {
                stockInfo.innerHTML = `
                    <span class="text-danger fw-bold"><i class="bi bi-exclamation-triangle-fill me-1"></i> Tạm hết hàng</span>
                    <span class="text-muted ms-2">• Màu ${variant.ColorName} (RAM ${variant.RamGB}GB/SSD ${variant.StorageGB}GB) hiện có 0 máy trong kho. Vui lòng chọn màu hoặc cấu hình khác!</span>
                `;
            }
            if (stockBadgeWrap) {
                stockBadgeWrap.innerHTML = `<span class="badge bg-danger-subtle text-danger border border-danger-subtle"><i class="bi bi-x-circle-fill me-1"></i> Tạm hết hàng</span>`;
            }
            if (buyFullBtn) {
                buyFullBtn.disabled = true;
                buyFullBtn.className = "btn btn-secondary btn-lg fw-bold w-100 py-3";
            }
            if (buyInstallmentBtn) {
                buyInstallmentBtn.disabled = true;
                buyInstallmentBtn.className = "btn btn-secondary btn-lg fw-bold w-100 py-3";
            }
        }

        // Cập nhật tính toán trả góp
        if (selectedMode === 'Installment') {
            selectTerm(selectedTerm);
        }
    }

    document.addEventListener('DOMContentLoaded', initVariantSelector);

    function openOrderModal(mode) {
        selectedMode = mode;
        const modalEl = document.getElementById('orderModal');
        const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
        
        if (mode === 'Installment') {
            document.getElementById('modeInstallment').checked = true;
            onModeChange('Installment');
        } else {
            document.getElementById('modeFull').checked = true;
            onModeChange('Full');
        }
        
        modal.show();
    }

    function onModeChange(mode) {
        selectedMode = mode;
        const configBox = document.getElementById('installmentConfigBox');
        const btnText = document.getElementById('submitBtnText');
        
        if (mode === 'Installment') {
            configBox.style.display = 'block';
            selectTerm(selectedTerm);
            const prepay = Math.round(TOTAL_PRICE * 0.3);
            btnText.textContent = `ĐẶT HÀNG TRẢ GÓP (TRẢ TRƯỚC ${formatVND(prepay)})`;
        } else {
            configBox.style.display = 'none';
            btnText.textContent = `XÁC NHẬN ĐẶT HÀNG (${formatVND(TOTAL_PRICE)})`;
        }
    }

    function selectTerm(term) {
        selectedTerm = term;
        document.querySelectorAll('.term-btn').forEach(b => {
            if (parseInt(b.dataset.term) === term) {
                b.className = 'btn btn-primary term-btn flex-fill';
            } else {
                b.className = 'btn btn-outline-secondary term-btn flex-fill';
            }
        });

        // Tính toán nghiệp vụ trả góp chuẩn Mốc 1:
        // Trả trước đúng 30% làm tròn đến đồng
        const prepayAmount = Math.round(TOTAL_PRICE * 0.30);
        const financedAmount = TOTAL_PRICE - prepayAmount;
        const basePeriodAmount = Math.floor(financedAmount / term);
        const lastPeriodAmount = financedAmount - (basePeriodAmount * (term - 1));

        document.getElementById('summaryPrepay').textContent = formatVND(prepayAmount);
        document.getElementById('summaryFinanced').textContent = formatVND(financedAmount);
        document.getElementById('summaryMonthly').textContent = formatVND(basePeriodAmount);
        document.getElementById('summaryTermText').textContent = `${term} kỳ hạn (lãi 0%)`;

        // Render lịch dự kiến
        const today = new Date();
        let tableHtml = `<table class="table table-sm table-borderless mb-0 align-middle">
            <thead class="table-light"><tr><th class="ps-2">Kỳ</th><th>Hạn dự kiến</th><th class="text-end pe-2">Số tiền</th></tr></thead><tbody>`;
        
        for (let i = 1; i <= term; i++) {
            const dueDate = new Date(today);
            dueDate.setMonth(dueDate.getMonth() + i);
            const dateStr = dueDate.toLocaleDateString('vi-VN');
            const amt = (i === term) ? lastPeriodAmount : basePeriodAmount;
            tableHtml += `<tr>
                <td class="ps-2 fw-semibold">Kỳ #${i}</td>
                <td class="text-muted">${dateStr}</td>
                <td class="text-end pe-2 fw-bold text-primary">${formatVND(amt)}</td>
            </tr>`;
        }
        tableHtml += '</tbody></table>';
        document.getElementById('schedulePreviewTable').innerHTML = tableHtml;

        const btnText = document.getElementById('submitBtnText');
        btnText.textContent = `ĐẶT HÀNG TRẢ GÓP (TRẢ TRƯỚC ${formatVND(prepayAmount)})`;
    }

    async function submitCustomerOrder(e) {
        e.preventDefault();
        const submitBtn = document.getElementById('btnSubmitOrder');
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Đang tạo đơn hàng...';

        const name = document.getElementById('custName').value.trim();
        const phone = document.getElementById('custPhone').value.trim();
        const address = document.getElementById('custAddress').value.trim();
        const notes = document.getElementById('custNotes').value.trim();
        const payMethod = document.querySelector('input[name="payMethodRadio"]:checked').value;

        const specText = selectedVariant
            ? `Màu ${selectedVariant.ColorName} • RAM ${selectedVariant.RamGB}GB • SSD ${selectedVariant.StorageGB}GB`
            : '@(Model.Specification != null ? $"RAM {Model.Specification.RamGB}GB • {Model.Specification.StorageGB}GB {Model.Specification.StorageType}" : "Tiêu chuẩn")';

        const payload = {
            customerName: name,
            phoneNumber: phone,
            shippingAddress: address,
            notes: notes,
            paymentMethod: payMethod,
            purchaseMode: selectedMode,
            termMonths: selectedMode === 'Installment' ? selectedTerm : null,
            items: [{
                productId: PRODUCT_ID,
                variantId: selectedVariant ? selectedVariant.VariantId : null,
                colorName: selectedVariant ? selectedVariant.ColorName : null,
                quantity: 1,
                selectedSpecs: specText
            }]
        };

        try {
            const resp = await fetch('/api/orders', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            const data = await resp.json();
            if (!resp.ok || !data.success) {
                alert(data.message || 'Lỗi khi đặt hàng. Vui lòng thử lại!');
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="bi bi-check2-circle me-1"></i> XÁC NHẬN ĐẶT HÀNG';
                return;
            }

            // Đặt hàng thành công: hiển thị thông báo kết quả
            renderOrderSuccess(data.orderCode, payMethod, selectedMode, selectedTerm, phone, specText);
        } catch (err) {
            alert('Lỗi kết nối máy chủ: ' + err.message);
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<i class="bi bi-check2-circle me-1"></i> XÁC NHẬN ĐẶT HÀNG';
        }
    }

    function renderOrderSuccess(orderCode, payMethod, mode, term, phone, specText) {
        const modalBody = document.getElementById('orderModalBody');
        const prepayAmount = Math.round(TOTAL_PRICE * 0.30);
        const amountToPayNow = (mode === 'Installment') ? prepayAmount : TOTAL_PRICE;

        let qrSection = '';
        if (payMethod === 'VietQR') {
            const qrUrl = `https://api.vietqr.io/image/970422-0988668866-compact2.png?amount=${amountToPayNow}&addInfo=${encodeURIComponent((mode === 'Installment' ? 'TT TRAGOP ' : 'THANHTOAN ') + orderCode)}&accountName=HE%20THONG%20LAPTOP%20WORLD`;
            qrSection = `
                <div class="text-center p-3 my-3 bg-light rounded border">
                    <div class="fw-bold text-dark mb-1">Mã QR Thanh toán chính xác ${formatVND(amountToPayNow)}</div>
                    <div class="small text-muted mb-2">Mở App ngân hàng quét mã QR dưới đây để chuyển khoản tự động:</div>
                    <img src="${qrUrl}" alt="VietQR" class="img-fluid rounded border shadow-sm" style="max-width: 250px;" />
                    <div class="small text-secondary mt-2">
                        Tài khoản: <strong>0988668866</strong> - MBBank<br/>
                        Chủ TK: <strong>HE THONG LAPTOP WORLD</strong><br/>
                        Nội dung: <strong>${(mode === 'Installment' ? 'TT TRAGOP ' : 'THANHTOAN ') + orderCode}</strong>
                    </div>
                </div>
            `;
        }

        modalBody.innerHTML = `
            <div class="text-center py-3">
                <div class="d-inline-flex p-3 rounded-circle bg-success-subtle text-success mb-3">
                    <i class="bi bi-check-circle-fill fs-1"></i>
                </div>
                <h4 class="fw-bold text-dark">Đặt hàng ${mode === 'Installment' ? 'trả góp ' : ''}thành công!</h4>
                <div class="fs-5 text-primary fw-bold my-2">Mã đơn hàng: #${orderCode}</div>
                ${specText ? `<div class="badge bg-light text-dark border p-2 mb-2">${specText}</div>` : ''}
                <p class="text-muted small">
                    ${mode === 'Installment' 
                        ? `Đơn hàng trả góp <strong>${term} tháng</strong> đã được chuyển tới bộ phận kế toán. Vui lòng hoàn tất khoản trả trước <strong>${formatVND(prepayAmount)} (30%)</strong> để nhân viên kích hoạt hợp đồng và giao máy.`
                        : 'Đơn hàng của bạn đã được ghi nhận vào hệ thống và đang được xử lý đóng gói.'}
                </p>
                ${qrSection}
                <div class="d-flex justify-content-center gap-2 mt-4">
                    <a href="/Catalog/Lookup?orderCode=${orderCode}&phone=${encodeURIComponent(phone)}" class="btn btn-primary px-4 fw-semibold">
                        <i class="bi bi-truck me-1"></i> Tra cứu tiến độ đơn hàng
                    </a>
                    <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Đóng</button>
                </div>
            </div>
        `;
    }
</script>
