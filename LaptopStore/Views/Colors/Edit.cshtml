@model LaptopStore.Models.Color

@{
    ViewData["Title"] = $"Chỉnh sửa màu sắc: {Model.Name}";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-warning text-dark py-3">
                <h5 class="card-title mb-0"><i class="bi bi-pencil-square me-2"></i>Chỉnh sửa Màu Sắc: @Model.Name</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ColorId" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Tên màu sắc <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="VD: Bạc, Đen nhám..." />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="HexCode" class="form-label fw-semibold">Mã màu HEX <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input type="color" id="colorPicker" class="form-control form-control-color" value="@Model.HexCode" title="Chọn màu trực quan" />
                            <input asp-for="HexCode" id="hexInput" class="form-control font-monospace" />
                        </div>
                        <span asp-validation-for="HexCode" class="text-danger small"></span>
                    </div>

                    <div class="mb-4 form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" asp-for="IsActive" />
                        <label class="form-check-label fw-semibold" asp-for="IsActive">Kích hoạt sử dụng màu này</label>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Quay lại
                        </a>
                        <button type="submit" class="btn btn-warning px-4 text-dark fw-semibold">
                            <i class="bi bi-save me-1"></i> Cập nhật
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        const colorPicker = document.getElementById('colorPicker');
        const hexInput = document.getElementById('hexInput');

        colorPicker.addEventListener('input', (e) => {
            hexInput.value = e.target.value.toUpperCase();
        });

        hexInput.addEventListener('input', (e) => {
            if (/^#[0-9A-F]{6}$/i.test(e.target.value)) {
                colorPicker.value = e.target.value;
            }
        });
    </script>
}
