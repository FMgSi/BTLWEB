@model IEnumerable<LaptopStore.Models.Color>

@{
    ViewData["Title"] = "Quản lý Bảng màu Laptop (Colors)";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h3 text-primary mb-1"><i class="bi bi-palette-fill me-2"></i>Quản lý Bảng Màu Sắc (Colors)</h1>
        <p class="text-muted mb-0">Quản lý danh mục màu sắc laptop theo mô hình MVC, liên kết trực tiếp với các phiên bản và kiểm soát tồn kho theo màu</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Thêm mới màu sắc
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Bộ lọc tìm kiếm nhanh -->
<div class="card shadow-sm border-0 rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control border-start-0" placeholder="Tìm theo tên màu hoặc mã HEX (#FFFFFF)..." />
                </div>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary"><i class="bi bi-funnel me-1"></i> Tìm kiếm</button>
                @if (!string.IsNullOrWhiteSpace(ViewBag.Keyword))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-circle me-1"></i> Bỏ lọc</a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Mã Màu</th>
                        <th>Hiển thị (Swatch)</th>
                        <th>Tên màu sắc</th>
                        <th>Mã màu HEX</th>
                        <th>Số phiên bản laptop</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-secondary">#@item.ColorId</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="rounded-circle border shadow-sm" 
                                          style="display: inline-block; width: 28px; height: 28px; background-color: @item.HexCode; flex-shrink: 0;"></span>
                                </div>
                            </td>
                            <td class="fw-semibold text-dark">
                                <a asp-action="Details" asp-route-id="@item.ColorId" class="text-decoration-none text-primary">
                                    @item.Name
                                </a>
                            </td>
                            <td>
                                <code class="px-2 py-1 bg-light border rounded text-dark">@item.HexCode</code>
                            </td>
                            <td>
                                <span class="badge @(item.Variants?.Count > 0 ? "bg-info text-dark" : "bg-light text-muted border") rounded-pill">
                                    @(item.Variants?.Count ?? 0) phiên bản
                                </span>
                            </td>
                            <td>
                                <form asp-action="ToggleActive" asp-route-id="@item.ColorId" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    @if (item.IsActive)
                                    {
                                        <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 py-0" title="Bấm để vô hiệu hóa">
                                            <i class="bi bi-check-circle me-1"></i> Đang kích hoạt
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-0" title="Bấm để kích hoạt lại">
                                            <i class="bi bi-pause-circle me-1"></i> Ngừng áp dụng
                                        </button>
                                    }
                                </form>
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@item.ColorId" class="btn btn-outline-warning" title="Chỉnh sửa màu">
                                        <i class="bi bi-pencil"></i> Sửa
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.ColorId" class="btn btn-outline-info" title="Xem phiên bản sử dụng">
                                        <i class="bi bi-info-circle"></i> Chi tiết
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.ColorId" class="btn btn-outline-danger" title="Xóa màu">
                                        <i class="bi bi-trash"></i> Xóa
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-palette fs-1 text-secondary d-block mb-2"></i>
                            Chưa có màu sắc nào phù hợp trong hệ thống.
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
