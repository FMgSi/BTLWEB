@model IEnumerable<LaptopStore.Models.Category>

@{
    ViewData["Title"] = "Quản lý Thể loại / Danh mục Laptop";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 text-primary mb-1"><i class="bi bi-tags-fill me-2"></i>Quản lý Thể loại / Danh mục (Categories)</h1>
        <p class="text-muted mb-0">Quản lý phân loại sản phẩm laptop với Entity Framework Core</p>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> Thêm mới thể loại
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0 rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4 text-nowrap" style="width: 80px;">Mã</th>
                        <th class="text-nowrap" style="width: 220px;">Tên thể loại</th>
                        <th>Mô tả</th>
                        <th class="text-center text-nowrap" style="width: 140px;">Số laptop</th>
                        <th class="text-end pe-4 text-nowrap" style="width: 220px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-secondary text-nowrap">#@item.CategoryId</td>
                            <td class="fw-semibold text-primary text-nowrap">@item.CategoryName</td>
                            <td class="text-muted" style="max-width: 380px;">
                                <div class="text-truncate" title="@(item.Description ?? "Chưa có mô tả")">
                                    @(item.Description ?? "Chưa có mô tả")
                                </div>
                            </td>
                            <td class="text-center text-nowrap">
                                <span class="badge bg-info text-dark rounded-pill px-3 py-1">
                                    @(item.Products?.Count ?? 0) sản phẩm
                                </span>
                            </td>
                            <td class="text-end pe-4 text-nowrap">
                                <div class="d-inline-flex gap-1 align-items-center justify-content-end text-nowrap">
                                    <a asp-action="Edit" asp-route-id="@item.CategoryId" class="btn btn-sm btn-outline-warning px-2 py-1 text-nowrap" title="Chỉnh sửa">
                                        <i class="bi bi-pencil"></i> Sửa
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.CategoryId" class="btn btn-sm btn-outline-info px-2 py-1 text-nowrap" title="Xem chi tiết">
                                        <i class="bi bi-info-circle"></i> Chi tiết
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.CategoryId" class="btn btn-sm btn-outline-danger px-2 py-1 text-nowrap" title="Xóa danh mục">
                                        <i class="bi bi-trash"></i> Xóa
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">Chưa có danh mục thể loại nào được tạo.</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
