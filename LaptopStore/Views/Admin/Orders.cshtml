@model IEnumerable<LaptopStore.ViewModels.OrderResponseDto>
@{
    ViewData["Title"] = "Quản lý đơn hàng";
    var currentStatus = ViewBag.Status as string ?? "all";
    var currentSearch = ViewBag.Search as string ?? "";
}

<div class="page-header">
    <div>
        <h2 class="page-title">Quản lý đơn hàng</h2>
        <p class="text-muted small mb-0">Theo dõi trạng thái đơn hàng thời gian thực, hóa đơn và quy trình xử lý giao hàng</p>
    </div>
    <div class="page-actions">
        <a href="/Admin/ExportProducts" class="btn-secondary-custom">
            <i class="bi bi-file-earmark-excel"></i> Xuất dữ liệu
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show bg-success-subtle text-success border border-success mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show bg-danger-subtle text-danger border border-danger mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="admin-card mb-4 p-3 shadow-sm border">
    <form method="get" asp-action="Orders" class="d-flex flex-wrap align-items-center gap-2">
        <div class="position-relative" style="width: 340px; max-width: 100%;">
            <i class="bi bi-search position-absolute top-50 translate-middle-y text-muted" style="left: 12px;"></i>
            <input type="text" name="search" value="@currentSearch" class="form-control-dark ps-5" placeholder="Tìm theo mã đơn, tên khách, SĐT..." />
        </div>
        <div style="width: 230px; max-width: 100%;">
            <select name="status" class="form-select-dark" onchange="this.form.submit()">
                <option value="all" selected="@(currentStatus == "all" ? "selected" : null)">Tất cả trạng thái</option>
                <option value="Chờ xác nhận" selected="@(currentStatus == "Chờ xác nhận" ? "selected" : null)">Chờ xác nhận</option>
                <option value="Đang xử lý" selected="@(currentStatus == "Đang xử lý" ? "selected" : null)">Đang xử lý</option>
                <option value="Đã xác nhận" selected="@(currentStatus == "Đã xác nhận" ? "selected" : null)">Đã xác nhận</option>
                <option value="Đang giao" selected="@(currentStatus == "Đang giao" ? "selected" : null)">Đang giao hàng</option>
                <option value="Hoàn thành" selected="@(currentStatus == "Hoàn thành" ? "selected" : null)">Hoàn thành</option>
                <option value="Đã hủy" selected="@(currentStatus == "Đã hủy" ? "selected" : null)">Đã hủy</option>
                <option value="Installment" selected="@(currentStatus == "Installment" ? "selected" : null)">Đơn hàng trả góp (0%)</option>
            </select>
        </div>
        <button type="submit" class="btn-action-tool">
            <i class="bi bi-funnel"></i> Lọc đơn
        </button>
        <a href="/Admin/Orders" class="btn-action-tool d-inline-flex align-items-center gap-1" title="Làm mới bộ lọc và danh sách">
            <i class="bi bi-arrow-clockwise"></i> Làm mới
        </a>
    </form>
</div>

<div class="admin-card">
    <div class="admin-card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title-text mb-0"><i class="bi bi-box-seam text-primary me-2"></i> Danh sách tất cả đơn hàng (@(ViewBag.TotalCount ?? Model.Count()))</h5>
    </div>
    <div class="admin-table-container">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Mã đơn</th>
                    <th>Khách hàng</th>
                    <th>Chi tiết sản phẩm</th>
                    <th>Tổng tiền</th>
                    <th>Thanh toán</th>
                    <th>Trạng thái đơn</th>
                    <th>Ngày đặt</th>
                    <th class="text-end">Cập nhật</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var o in Model)
                    {
                        var statusClass = o.OrderStatus switch
                        {
                            "Hoàn thành" => "badge-paid",
                            "Đang xử lý" => "badge-processing",
                            "Đã xác nhận" => "badge-confirmed",
                            "Đã hủy" => "badge-out-of-stock",
                            _ => "badge-low-stock"
                        };

                        var paymentBadgeClass = o.PaymentStatus == "Đã thanh toán" ? "badge-in-stock" : "badge-low-stock";

                        <tr>
                            <td class="fw-bold text-primary">
                                <div>#@o.OrderCode</div>
                                @if (o.PurchaseMode == "Installment")
                                {
                                    <span class="badge bg-warning text-dark border small mt-1" style="font-size: 0.68rem;">
                                        <i class="bi bi-credit-card-2-front"></i> Trả góp @(o.InstallmentContract?.TermMonths ?? 6)T
                                    </span>
                                    @if (o.InstallmentContract != null)
                                    {
                                        <div class="mt-1">
                                            <a href="/Admin/InstallmentDetails/@o.InstallmentContract.ContractId" class="small text-decoration-none">
                                                <i class="bi bi-file-earmark-text"></i> Xem HĐ
                                            </a>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-light text-secondary border small mt-1" style="font-size: 0.68rem;">
                                        Trả thẳng
                                    </span>
                                }
                            </td>
                            <td>
                                <div class="text-dark fw-semibold">@o.CustomerName</div>
                                <div class="text-muted small"><i class="bi bi-telephone me-1"></i>@o.PhoneNumber</div>
                                <div class="text-secondary small text-truncate" style="max-width: 180px;" title="@o.ShippingAddress">
                                    <i class="bi bi-geo-alt me-1"></i>@o.ShippingAddress
                                </div>
                            </td>
                            <td>
                                @if (o.Items != null && o.Items.Any())
                                {
                                    foreach (var item in o.Items.Take(2))
                                    {
                                        <div class="text-dark small fw-medium">
                                            @item.ProductName <span class="text-primary">x@(item.Quantity)</span>
                                        </div>
                                        <div class="d-flex flex-wrap gap-1 my-1">
                                            @if (!string.IsNullOrEmpty(item.ColorName))
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary border" style="font-size: 0.68rem;">Màu: @item.ColorName</span>
                                            }
                                            @if (!string.IsNullOrEmpty(item.SKU))
                                            {
                                                <span class="badge bg-light text-dark border font-monospace" style="font-size: 0.68rem;">@item.SKU</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(item.SelectedSpecs))
                                        {
                                            <div class="text-muted" style="font-size: 0.72rem;">@item.SelectedSpecs</div>
                                        }
                                    }
                                    @if (o.Items.Count > 2)
                                    {
                                        <div class="text-secondary small fst-italic">+@(o.Items.Count - 2) sản phẩm khác</div>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">Chưa có chi tiết</span>
                                }
                            </td>
                            <td class="fw-bold text-dark text-nowrap">
                                @string.Format("{0:N0}đ", o.TotalAmount)
                            </td>
                            <td>
                                <div class="text-dark small fw-medium">@o.PaymentMethod</div>
                                <span class="badge-status @paymentBadgeClass" style="font-size: 0.72rem;">
                                    @o.PaymentStatus
                                </span>
                                @if (o.PurchaseMode == "Installment" && o.PrepayAmount.HasValue)
                                {
                                    <div class="text-muted small" style="font-size: 0.7rem;">
                                        Trả trước: @string.Format("{0:N0}đ", o.PrepayAmount.Value)
                                    </div>
                                    @if (o.RemainingDebt.HasValue && o.RemainingDebt.Value > 0)
                                    {
                                        <div class="text-danger small fw-semibold" style="font-size: 0.7rem;">
                                            Nợ: @string.Format("{0:N0}đ", o.RemainingDebt.Value)
                                        </div>
                                    }
                                }
                            </td>
                            <td>
                                <span class="badge-status @statusClass">
                                    @o.OrderStatus
                                </span>
                            </td>
                            <td class="text-muted small text-nowrap">
                                @o.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td class="text-end text-nowrap">
                                <button type="button" class="btn-action-tool btn-sm me-1" 
                                        data-bs-toggle="modal" data-bs-target="#modal-serial-@o.OrderId" title="Gán số Serial">
                                    <i class="bi bi-upc-scan"></i> Serial
                                </button>
                                <button type="button" class="btn-action-tool btn-sm" 
                                        data-bs-toggle="modal" data-bs-target="#modal-order-@o.OrderId" title="Xử lý đơn">
                                    <i class="bi bi-pencil-square"></i> Xử lý
                                </button>
                            </td>
                        </tr>

                        
                        <div class="modal fade" id="modal-serial-@o.OrderId" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content bg-white text-dark border-0 shadow-lg rounded-3">
                                    <div class="modal-header border-bottom bg-light">
                                        <h5 class="modal-title fs-6 fw-bold">
                                            <i class="bi bi-upc-scan text-primary me-2"></i>Gán số Serial - Đơn hàng #@o.OrderCode
                                        </h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <form method="post" asp-action="AssignOrderSerials">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="orderId" value="@o.OrderId" />
                                        <input type="hidden" name="returnUrl" value="/Admin/Orders" />

                                        <div class="modal-body text-start">
                                            <div class="alert alert-info py-2 px-3 small mb-3">
                                                <i class="bi bi-info-circle-fill me-1"></i> Nhập đúng số lượng Serial tương ứng cho từng sản phẩm. Mỗi máy 1 số Serial (phân cách bằng dấu phẩy hoặc xuống dòng).
                                            </div>

                                            @if (o.Items != null && o.Items.Any())
                                            {
                                                foreach (var item in o.Items)
                                                {
                                                    <div class="mb-3 p-3 bg-light rounded border">
                                                        <div class="fw-bold text-dark small mb-1">
                                                            @item.ProductName 
                                                            <span class="badge bg-primary ms-1">Số lượng: @item.Quantity chiếc</span>
                                                        </div>
                                                        @if (!string.IsNullOrEmpty(item.SKU))
                                                        {
                                                            <div class="small text-muted font-monospace mb-2">SKU: @item.SKU</div>
                                                        }
                                                        <input type="hidden" name="orderItemIds" value="@item.OrderItemId" />
                                                        <label class="form-label-dark small">Nhập @item.Quantity số Serial:</label>
                                                        <textarea name="serialLists" class="form-control-dark font-monospace" rows="@Math.Min(4, Math.Max(2, item.Quantity))" placeholder="VD:&#10;SN-DELL-1001&#10;SN-DELL-1002" required></textarea>
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <div class="text-muted small">Đơn hàng không có sản phẩm nào.</div>
                                            }
                                        </div>
                                        <div class="modal-footer border-top bg-light">
                                            <button type="button" class="btn-secondary-custom" data-bs-dismiss="modal">Đóng</button>
                                            <button type="submit" class="btn-primary-custom">
                                                <i class="bi bi-check2-circle"></i> Lưu danh sách Serial
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>

                        
                        <div class="modal fade" id="modal-order-@o.OrderId" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content bg-white text-dark border-0 shadow-lg rounded-3">
                                    <div class="modal-header border-bottom bg-light">
                                        <h5 class="modal-title fs-6 fw-bold">
                                            <i class="bi bi-box-seam text-primary me-2"></i>Đơn hàng #@o.OrderCode
                                        </h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <form method="post" asp-action="UpdateOrderStatus">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="orderId" value="@o.OrderId" />
                                        <div class="modal-body text-start">
                                            <div class="mb-3 p-3 rounded" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                                                <div class="small text-secondary mb-1">Khách hàng: <strong class="text-dark">@o.CustomerName</strong> (@o.PhoneNumber)</div>
                                                <div class="small text-secondary mb-1">Địa chỉ: <span class="text-dark">@o.ShippingAddress</span></div>
                                                <div class="small text-secondary mb-1">Tổng tiền: <strong class="text-success">@string.Format("{0:N0}đ", o.TotalAmount)</strong> (@o.PaymentMethod)</div>
                                                <div class="small text-secondary">Trạng thái hiện tại: <span class="badge-status @statusClass">@o.OrderStatus</span></div>
                                            </div>

                                            @if (o.PurchaseMode == "Installment")
                                            {
                                                <div class="alert alert-info py-2 px-3 small mb-3">
                                                    <i class="bi bi-info-circle-fill me-1"></i> <strong>Đơn hàng trả góp:</strong> Giao máy xong khách hàng vẫn tiếp tục trả góp theo từng kỳ. Chuyển trạng thái sang "Hoàn thành" sẽ xác nhận giao máy xong nhưng không xóa dư nợ của hợp đồng.
                                                </div>
                                            }

                                            <div class="mb-3">
                                                <label class="form-label-dark">Chuyển sang trạng thái mới *</label>
                                                <select name="status" class="form-select-dark">
                                                    <option value="Chờ xác nhận" selected="@(o.OrderStatus == "Chờ xác nhận" ? "selected" : null)">0. Chờ xác nhận (Chờ khách thanh toán/duyệt)</option>
                                                    <option value="Đang xử lý" selected="@(o.OrderStatus == "Đang xử lý" ? "selected" : null)">1. Đang xử lý (Mới nhận đơn)</option>
                                                    <option value="Đã xác nhận" selected="@(o.OrderStatus == "Đã xác nhận" ? "selected" : null)">2. Đã xác nhận (Đã duyệt thông tin / tiền đã về)</option>
                                                    <option value="Đang giao" selected="@(o.OrderStatus == "Đang giao" || o.OrderStatus == "Đang giao hàng" ? "selected" : null)">3. Đang giao hàng (Đã gửi shipper)</option>
                                                    <option value="Hoàn thành" selected="@(o.OrderStatus == "Hoàn thành" ? "selected" : null)">4. Hoàn thành (Khách đã nhận máy & thanh toán)</option>
                                                    <option value="Đã hủy" selected="@(o.OrderStatus == "Đã hủy" ? "selected" : null)">5. Hủy đơn hàng (Hoàn lại kho)</option>
                                                </select>
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label-dark">Ghi chú xử lý đơn</label>
                                                <input type="text" name="note" class="form-control-dark" placeholder="VD: Khách hẹn giao sau 18h..." />
                                            </div>
                                        </div>
                                        <div class="modal-footer border-top bg-light">
                                            <button type="button" class="btn-secondary-custom" data-bs-dismiss="modal">Đóng</button>
                                            <button type="submit" class="btn-primary-custom">
                                                <i class="bi bi-check2-circle"></i> Lưu cập nhật
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            Không có đơn hàng nào phù hợp với điều kiện tìm kiếm.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    
    @if ((ViewBag.TotalPages ?? 1) > 1)
    {
        int curPage = ViewBag.CurrentPage ?? 1;
        int totPages = ViewBag.TotalPages ?? 1;
        int totCount = ViewBag.TotalCount ?? (Model != null ? Model.Count() : 0);

        var pagesToShow = new List<object>();
        if (totPages <= 7)
        {
            for (int i = 1; i <= totPages; i++) { pagesToShow.Add(i); }
        }
        else
        {
            if (curPage <= 4)
            {
                pagesToShow.AddRange(new object[] { 1, 2, 3, 4, 5, "...", totPages });
            }
            else if (curPage >= totPages - 3)
            {
                pagesToShow.AddRange(new object[] { 1, "...", totPages - 4, totPages - 3, totPages - 2, totPages - 1, totPages });
            }
            else
            {
                pagesToShow.AddRange(new object[] { 1, "...", curPage - 1, curPage, curPage + 1, "...", totPages });
            }
        }

        <div class="admin-pagination-wrap p-3 d-flex flex-wrap justify-content-between align-items-center border-top bg-white">
            <div class="pagination-info small text-muted">
                Trang <strong>@curPage</strong> / <strong>@totPages</strong> (Tổng số <strong>@totCount</strong> đơn hàng)
            </div>
            <ul class="admin-pagination m-0 d-flex gap-1 list-unstyled align-items-center">
                <li class="admin-page-item @(curPage <= 1 ? "disabled" : "")">
                    <a href="@(curPage <= 1 ? "javascript:void(0)" : $"/Admin/Orders?page={curPage - 1}&search={ViewBag.Search}&status={ViewBag.Status}")" 
                       class="btn btn-sm btn-light border @(curPage <= 1 ? "disabled opacity-50" : "text-dark")"
                       title="Trang trước"
                       style="min-width: 34px; height: 34px; border-radius: 6px; display: inline-flex; align-items: center; justify-content: center;">
                        <i class="bi bi-chevron-left"></i> Trước
                    </a>
                </li>
                @foreach (var pageItem in pagesToShow)
                {
                    if (pageItem is string)
                    {
                        <li class="admin-page-item disabled">
                            <span class="d-inline-flex align-items-center justify-content-center text-muted px-1" style="min-width: 24px; height: 34px; font-weight: bold; user-select: none;">...</span>
                        </li>
                    }
                    else
                    {
                        int p = (int)pageItem;
                        <li class="admin-page-item">
                            <a href="/Admin/Orders?page=@p&search=@ViewBag.Search&status=@ViewBag.Status" 
                               class="btn btn-sm @(p == curPage ? "btn-dark text-white fw-bold shadow-sm" : "btn-light border text-dark")"
                               title="Trang @p"
                               style="min-width: 34px; height: 34px; border-radius: 6px; display: inline-flex; align-items: center; justify-content: center;">
                                @p
                            </a>
                        </li>
                    }
                }
                <li class="admin-page-item @(curPage >= totPages ? "disabled" : "")">
                    <a href="@(curPage >= totPages ? "javascript:void(0)" : $"/Admin/Orders?page={curPage + 1}&search={ViewBag.Search}&status={ViewBag.Status}")" 
                       class="btn btn-sm btn-light border @(curPage >= totPages ? "disabled opacity-50" : "text-dark")"
                       title="Trang tiếp theo"
                       style="min-width: 34px; height: 34px; border-radius: 6px; display: inline-flex; align-items: center; justify-content: center;">
                        Sau <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </div>
    }
</div>
