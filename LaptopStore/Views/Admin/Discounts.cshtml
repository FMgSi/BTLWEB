@model IEnumerable<LaptopStore.ViewModels.DiscountDto>
@{
    ViewData["Title"] = "Quản lý mã giảm giá & Khuyến mãi";
    string currentStatus = ViewBag.Status ?? "all";
    string currentType = ViewBag.DiscountType ?? "all";
    string currentSearch = ViewBag.Search ?? "";
}

<div class="page-header">
    <div>
        <h2 class="page-title">Quản lý mã giảm giá &amp; Khuyến mãi</h2>
        <p class="text-muted small mb-0">Hệ thống khuyến mãi hợp nhất trên SQL Server cho Website khách hàng, nhân viên và giỏ hàng</p>
    </div>
    <div class="page-actions">
        <button class="btn-primary-custom" data-bs-toggle="modal" data-bs-target="#createDiscountModal">
            <i class="bi bi-plus-lg"></i> Tạo mã giảm giá mới
        </button>
        <a href="/Admin/ExportDiscounts" class="btn-secondary-custom">
            <i class="bi bi-file-earmark-arrow-down"></i> Xuất file
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert" style="background: rgba(16, 185, 129, 0.2); border-color: rgba(16, 185, 129, 0.4); color: #34d399;">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
    </div>
}

<div class="admin-card mb-3">
    <form method="get" action="/Admin/Discounts" id="discountFilterForm">
        <div class="row g-3 align-items-center">
            
            <div class="col-lg-4 col-md-12">
                <div class="d-flex align-items-center gap-2">
                    <div class="position-relative flex-grow-1">
                        <i class="bi bi-search position-absolute top-50 translate-middle-y text-muted" style="left: 12px;"></i>
                        <input type="text" name="search" value="@currentSearch" class="form-control-dark ps-5" 
                               placeholder="Tìm theo mã hoặc tên voucher..." onchange="this.form.submit()" />
                    </div>
                    <a href="/Admin/Discounts" class="btn-action-tool d-inline-flex align-items-center gap-1 text-nowrap" title="Làm mới bộ lọc và danh sách">
                        <i class="bi bi-arrow-clockwise"></i> Làm mới
                    </a>
                </div>
            </div>

            
            <div class="col-lg-4 col-md-6">
                <div class="d-flex align-items-center gap-2">
                    <span class="text-secondary small fw-semibold text-nowrap">Trạng thái:</span>
                    <input type="hidden" name="status" id="discountStatusInput" value="@currentStatus" />
                    <div class="filter-btn-group">
                        <button type="button" class="filter-btn-item @(currentStatus == "all" ? "active" : "")" onclick="setDiscountStatus('all')">Tất cả</button>
                        <button type="button" class="filter-btn-item @(currentStatus == "active" ? "active" : "")" onclick="setDiscountStatus('active')">Đang chạy</button>
                        <button type="button" class="filter-btn-item @(currentStatus == "upcoming" ? "active" : "")" onclick="setDiscountStatus('upcoming')">Sắp tới</button>
                        <button type="button" class="filter-btn-item @(currentStatus == "expired" ? "active" : "")" onclick="setDiscountStatus('expired')">Hết hạn/Ngừng</button>
                    </div>
                </div>
            </div>

            
            <div class="col-lg-4 col-md-6">
                <div class="d-flex align-items-center gap-2">
                    <span class="text-secondary small fw-semibold text-nowrap">Loại giảm:</span>
                    <input type="hidden" name="discountType" id="discountTypeInput" value="@currentType" />
                    <div class="filter-btn-group">
                        <button type="button" class="filter-btn-item @(currentType == "all" ? "active" : "")" onclick="setDiscountType('all')">Tất cả</button>
                        <button type="button" class="filter-btn-item @(currentType == "percent" ? "active" : "")" onclick="setDiscountType('percent')">Giảm %</button>
                        <button type="button" class="filter-btn-item @(currentType == "fixed" ? "active" : "")" onclick="setDiscountType('fixed')">Số tiền</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<div class="admin-card">
    <div class="admin-card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title-text mb-0">
            <i class="bi bi-tag-fill text-primary me-2"></i>Danh sách mã giảm giá trong CSDL
        </h5>
        <span class="text-muted small">Tổng số: <strong>@Model.Count()</strong> mã</span>
    </div>

    <div class="admin-table-container">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Mã Voucher</th>
                    <th>Tên chương trình</th>
                    <th>Loại &amp; Mức giảm</th>
                    <th>Điều kiện áp dụng</th>
                    <th>Lượt dùng / Hạn mức</th>
                    <th>Thời gian hiệu lực</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr id="row-discount-@d.DiscountId">
                        <td>
                            <span class="fw-bold px-2 py-1 rounded" style="background-color: #eff6ff; color: #1d4ed8; border: 1px dashed #bfdbfe; font-family: monospace; font-size: 0.95rem;">
                                @d.Code
                            </span>
                        </td>
                        <td>
                            <div class="fw-semibold text-dark">@d.Title</div>
                            @if (!string.IsNullOrEmpty(d.Description))
                            {
                                <div class="text-muted small" style="font-size: 0.8rem; max-width: 260px;">@d.Description</div>
                            }
                        </td>
                        <td>
                            <div class="fw-bold text-danger">@d.DiscountValueText</div>
                            <span class="badge bg-light text-secondary border" style="font-size: 11px;">@d.DiscountTypeDisplay</span>
                        </td>
                        <td class="small">
                            <div>@d.ConditionText</div>
                        </td>
                        <td>
                            <div class="fw-semibold text-dark">@d.UsageText</div>
                        </td>
                        <td class="text-muted small">
                            <div>@d.ExpiryText</div>
                        </td>
                        <td>
                            <span class="badge-status @d.StatusBadgeClass">
                                @d.Status
                            </span>
                        </td>
                        <td class="text-end text-nowrap">
                            <button type="button" 
                                    class="btn btn-sm @(d.IsActive ? "btn-outline-warning" : "btn-outline-success") me-1" 
                                    onclick="toggleDiscount(@d.DiscountId, '@d.Code', @d.IsActive.ToString().ToLower())"
                                    title="@(d.IsActive ? "Ngừng áp dụng voucher này" : "Kích hoạt lại voucher này")">
                                <i class="bi @(d.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i> 
                                @(d.IsActive ? "Ngừng" : "Bật")
                            </button>

                            <button type="button" 
                                    class="btn btn-sm btn-outline-danger" 
                                    onclick="deleteDiscount(@d.DiscountId, '@d.Code', @d.UsedCount)"
                                    title="Xóa voucher khỏi hệ thống">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="createDiscountModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="background-color: var(--bg-card); border: 1px solid var(--border-color); color: #fff;">
            <div class="modal-header border-secondary">
                <h5 class="modal-title"><i class="bi bi-tag-fill text-primary me-2"></i>Tạo mã giảm giá mới vào CSDL</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" action="/Admin/CreateDiscount">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label-dark">Mã voucher (Code) *</label>
                            <input type="text" name="Code" class="form-control-dark" placeholder="VD: TET2026, GAMING1TR" required style="text-transform: uppercase;" />
                            <small class="text-muted">Viết hoa, viết liền, không dấu</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-dark">Tên chương trình khuyến mãi *</label>
                            <input type="text" name="Title" class="form-control-dark" placeholder="Khuyến mãi Lễ Hội Công Nghệ" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label-dark">Mô tả thể lệ &amp; quà tặng kèm</label>
                        <textarea name="Description" class="form-control-dark" rows="2" placeholder="Chi tiết ưu đãi hiển thị cho khách hàng xem trên website"></textarea>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label-dark">Loại giảm giá *</label>
                            <select name="DiscountType" id="discountTypeSelect" class="form-select-dark" onchange="handleDiscountTypeChange()">
                                <option value="Percentage">Giảm theo %</option>
                                <option value="FixedAmount">Giảm số tiền cố định (VNĐ)</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label-dark">Giá trị giảm *</label>
                            <input type="number" step="0.01" name="DiscountValue" class="form-control-dark" placeholder="VD: 10 (%) hoặc 500000 (đ)" required />
                        </div>
                        <div class="col-md-4" id="maxDiscountAmountWrap">
                            <label class="form-label-dark">Trần giảm tối đa (VNĐ)</label>
                            <input type="number" step="1000" name="MaxDiscountAmount" class="form-control-dark" placeholder="VD: 1000000 (để trống nếu không trần)" />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label-dark">Đơn hàng tối thiểu (VNĐ)</label>
                            <input type="number" step="1000" name="MinOrderAmount" class="form-control-dark" value="0" placeholder="VD: 10000000" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-dark">Phạm vi áp dụng</label>
                            <select name="ApplicableScope" class="form-select-dark">
                                <option value="All">Toàn bộ sản phẩm</option>
                                <option value="GamingOnly">Chỉ áp dụng Laptop Gaming</option>
                                <option value="OfficeOnly">Chỉ áp dụng Laptop Văn phòng &amp; Học tập</option>
                                <option value="AppleOnly">Chỉ áp dụng Apple MacBook</option>
                                <option value="FirstOrderOnly">Chỉ áp dụng cho Khách mua đơn đầu tiên</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label-dark">Số lượng lượt dùng tối đa</label>
                            <input type="number" name="UsageLimit" class="form-control-dark" placeholder="Để trống nếu không giới hạn" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label-dark">Ngày bắt đầu</label>
                            <input type="datetime-local" name="StartDate" class="form-control-dark" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label-dark">Ngày kết thúc (Hạn dùng)</label>
                            <input type="datetime-local" name="EndDate" class="form-control-dark" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn-secondary-custom" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn-primary-custom">Lưu voucher vào CSDL</button>
                </div>
            </form>
        </div>
    </div>
</div>

<form id="antiForgeryForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        function setDiscountStatus(val) {
            document.getElementById('discountStatusInput').value = val;
            document.getElementById('discountFilterForm').submit();
        }

        function setDiscountType(val) {
            document.getElementById('discountTypeInput').value = val;
            document.getElementById('discountFilterForm').submit();
        }

        function handleDiscountTypeChange() {
            const type = document.getElementById('discountTypeSelect').value;
            const wrap = document.getElementById('maxDiscountAmountWrap');
            if (wrap) {
                wrap.style.display = type === 'Percentage' ? 'block' : 'none';
            }
        }

        function getAntiForgeryToken() {
            const input = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]');
            return input ? input.value : '';
        }

        function toggleDiscount(id, code, currentIsActive) {
            const actionText = currentIsActive ? 'ngừng áp dụng' : 'kích hoạt lại';
            if (!confirm(`Bạn có chắc chắn muốn ${actionText} mã giảm giá "${code}"?`)) return;

            const token = getAntiForgeryToken();
            fetch('/Admin/ToggleDiscountStatus', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: `id=${id}`
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert('Lỗi: ' + data.message);
                }
            })
            .catch(err => {
                alert('Không thể kết nối đến máy chủ: ' + err);
            });
        }

        function deleteDiscount(id, code, usedCount) {
            let msg = `Bạn có chắc chắn muốn xóa mã giảm giá "${code}"?`;
            if (usedCount > 0) {
                msg = `Mã "${code}" đã có ${usedCount} lượt sử dụng. Để bảo vệ dữ liệu lịch sử hóa đơn, hệ thống sẽ tự động chuyển sang trạng thái "Ngừng áp dụng" thay vì xóa vĩnh viễn. Bạn có đồng ý tiếp tục?`;
            }

            if (!confirm(msg)) return;

            const token = getAntiForgeryToken();
            fetch('/Admin/DeleteDiscount', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: `id=${id}`
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    location.reload();
                } else {
                    alert('Lỗi: ' + data.message);
                }
            })
            .catch(err => {
                alert('Không thể kết nối đến máy chủ: ' + err);
            });
        }
    </script>
}
