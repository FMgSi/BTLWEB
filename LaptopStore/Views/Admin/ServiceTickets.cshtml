@model IEnumerable<LaptopStore.ViewModels.ServiceTicketDetailDto>
@{
    ViewData["Title"] = "Quản lý Bảo hành & Sửa chữa";
    var currentStatus = ViewBag.Status as string ?? "all";
    var currentType = ViewBag.Type as string ?? "all";
    var currentSearch = ViewBag.Search as string ?? "";
    var serviceCatalog = ViewBag.Services as IEnumerable<LaptopStore.Models.ServiceCatalogItem> ?? Enumerable.Empty<LaptopStore.Models.ServiceCatalogItem>();
    var customerLookup = ViewBag.CustomerLookup as IEnumerable<LaptopStore.ViewModels.SoldDeviceDto> ?? Enumerable.Empty<LaptopStore.ViewModels.SoldDeviceDto>();
}

<div class="page-header">
    <div>
        <h2 class="page-title"><i class="bi bi-tools text-primary me-2"></i>Dịch vụ sau bán hàng (Bảo hành & Sửa chữa)</h2>
        <p class="text-muted small mb-0">Tiếp nhận yêu cầu bảo hành & sửa chữa (tại quầy hoặc online), kiểm tra kỹ thuật, báo giá và bàn giao máy cho khách</p>
    </div>
    <div class="page-actions d-flex gap-2">
        <a href="/Admin/SoldDevices" class="btn-secondary-custom">
            <i class="bi bi-laptop"></i> Tra cứu Serial máy đã bán
        </a>
        <a href="/Admin/ServiceCatalog" class="btn-secondary-custom">
            <i class="bi bi-list-task"></i> Bảng giá dịch vụ
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show bg-success-subtle text-success border border-success mb-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show bg-danger-subtle text-danger border border-danger mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- THỐNG KÊ NHANH -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="admin-card p-3 d-flex align-items-center gap-3">
            <div class="rounded-3 p-3 bg-warning-subtle text-warning fs-3">
                <i class="bi bi-hourglass-split"></i>
            </div>
            <div>
                <div class="text-muted small">Chờ tiếp nhận máy</div>
                <h4 class="fw-bold mb-0 text-dark">@(ViewBag.PendingCount ?? 0)</h4>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="admin-card p-3 d-flex align-items-center gap-3">
            <div class="rounded-3 p-3 bg-primary-subtle text-primary fs-3">
                <i class="bi bi-gear-wide-connected"></i>
            </div>
            <div>
                <div class="text-muted small">Đang xử lý / Kiểm tra</div>
                <h4 class="fw-bold mb-0 text-dark">@(ViewBag.ProcessingCount ?? 0)</h4>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="admin-card p-3 d-flex align-items-center gap-3">
            <div class="rounded-3 p-3 bg-info-subtle text-info fs-3">
                <i class="bi bi-box2-heart"></i>
            </div>
            <div>
                <div class="text-muted small">Chờ trả máy</div>
                <h4 class="fw-bold mb-0 text-dark">@(ViewBag.WaitingReturnCount ?? 0)</h4>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="admin-card p-3 d-flex align-items-center gap-3">
            <div class="rounded-3 p-3 bg-success-subtle text-success fs-3">
                <i class="bi bi-cash-stack"></i>
            </div>
            <div>
                <div class="text-muted small">Tiền sửa chữa đã thu</div>
                <h4 class="fw-bold mb-0 text-success">@string.Format("{0:N0}đ", ViewBag.TotalRevenue ?? 0)</h4>
            </div>
        </div>
    </div>
</div>

<!-- ==================== KHUNG CÔNG CỤ & FORM TIẾP NHẬN (THÊM, SỬA, XÓA, LƯU, HỦY, THOÁT) ==================== -->
<div class="admin-card mb-4 shadow-sm border">
    <!-- THANH CÔNG CỤ NÚT BẤM TRÊN CÙNG THEO MẪU CHUẨN: THAO TÁC / [ THÊM ] [ SỬA ] [ XÓA ] [ LƯU ] [ HỦY ] [ THOÁT ] -->
    <div class="p-3 bg-white border-bottom">
        <div class="operation-label fw-bold mb-2 text-dark" style="font-size: 0.95rem;">Thao tác</div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <!-- 1. NÚT THÊM -->
            <button type="button" class="btn-action-tool" id="btnThemTicket" onclick="onThemTicketClick()">
                Thêm
            </button>

            <!-- 2. NÚT SỬA -->
            <button type="button" class="btn-action-tool" id="btnSuaTicket" onclick="onSuaTicketClick()" disabled>
                Sửa
            </button>

            <!-- 3. NÚT XÓA -->
            <button type="button" class="btn-action-tool" id="btnXoaTicket" onclick="onXoaTicketClick()" disabled>
                Xóa
            </button>

            <!-- 4. NÚT LƯU -->
            <button type="button" class="btn-action-tool" id="btnLuuTicket" onclick="onLuuTicketClick()" disabled>
                Lưu
            </button>

            <!-- 5. NÚT HỦY -->
            <button type="button" class="btn-action-tool" id="btnHuyTicket" onclick="onHuyTicketClick()" disabled>
                Hủy
            </button>

            <!-- 6. NÚT THOÁT -->
            <button type="button" class="btn-action-tool" id="btnThoatTicket" onclick="onThoatTicketClick()">
                Thoát
            </button>

            <!-- DÒNG TRẠNG THÁI / HƯỚNG DẪN THAO TÁC -->
            <div class="ms-auto text-muted small" id="toolbarTicketHint">
                <i class="bi bi-info-circle me-1"></i> Nhấp chọn 1 dòng trong bảng để <strong>Sửa</strong> hoặc <strong>Xóa</strong>. Bấm <strong>Thêm</strong> để tạo phiếu tiếp nhận máy tại quầy.
            </div>
        </div>
    </div>

    <!-- KHUNG NHẬP LIỆU PHIẾU TIẾP NHẬN DỊCH VỤ (SẮP XẾP THEO DẠNG 3 CỘT RÕ RÀNG) -->
    <form id="ticketForm" method="post" asp-action="SaveServiceTicket" class="p-3 bg-light">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ticketId" id="inpTicketId" value="0" />

        <div class="row g-3">
            <!-- CỘT 1: THÔNG TIN TIẾP NHẬN & KHÁCH HÀNG -->
            <div class="col-lg-4 col-md-12">
                <div class="bg-white p-3 rounded-3 border h-100 shadow-sm">
                    <div class="d-flex align-items-center justify-content-between pb-2 mb-3 border-bottom">
                        <span class="fw-bold text-dark">
                            <i class="bi bi-person-lines-fill text-primary me-2"></i>1. Khách hàng & Tiếp nhận
                        </span>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle small">Cột 1</span>
                    </div>

                    <!-- Loại dịch vụ -->
                    <div class="mb-3">
                        <label class="form-label-dark small fw-bold mb-1">Loại dịch vụ <span class="text-danger">*</span></label>
                        <select name="ticketType" id="inpTicketType" class="form-select-dark" disabled onchange="handleTicketTypeChange(true)">
                            <option value="Sửa chữa">Sửa chữa dịch vụ</option>
                            <option value="Bảo hành">Bảo hành chính hãng</option>
                        </select>
                    </div>

                    <!-- Mã phiếu -->
                    <div class="mb-3">
                        <label class="form-label-dark small fw-bold mb-1">Mã phiếu tiếp nhận</label>
                        <input type="text" name="ticketCode" id="inpTicketCode" class="form-control-dark font-monospace fw-bold" placeholder="Tự sinh nếu để trống" disabled />
                    </div>

                    <!-- Ô CHỌN SỐ ĐIỆN THOẠI (Dành riêng cho phần Bảo hành để tự điền tên) -->
                    <div class="mb-3" id="divSelectPhone" style="display: none;">
                        <label class="form-label-dark small fw-bold mb-1 text-primary">
                            <i class="bi bi-telephone-inbound me-1"></i>Chọn số điện thoại khách hàng <span class="text-danger">*</span>
                        </label>
                        <select id="selCustomerPhone" class="form-select-dark border-primary" disabled onchange="handleCustomerPhoneSelect(this)">
                            <option value="">-- Chọn SĐT khách đã mua máy --</option>
                            @if (customerLookup != null)
                            {
                                foreach (var c in customerLookup)
                                {
                                    <option value="@c.PhoneNumber"
                                            data-name="@c.CustomerName"
                                            data-device="@c.ProductName"
                                            data-serial="@c.SerialNumber"
                                            data-warranty="@(c.IsUnderWarranty ? "Còn BH" : "Hết BH")">
                                        @c.PhoneNumber - @c.CustomerName (@c.ProductName - @c.SerialNumber)
                                    </option>
                                }
                            }
                        </select>
                        <small class="text-muted d-block mt-1" style="font-size: 0.78rem;">
                            <i class="bi bi-magic text-primary"></i> Chọn SĐT để tự động điền Tên, Thiết bị & Serial máy.
                        </small>
                    </div>

                    <!-- Ô NHẬP SỐ ĐIỆN THOẠI THỦ CÔNG (Dành cho Sửa chữa máy ngoài) -->
                    <div class="mb-3" id="divInputPhone">
                        <label class="form-label-dark small fw-bold mb-1">Số điện thoại khách hàng <span class="text-danger">*</span></label>
                        <input type="text" name="phoneNumber" id="inpPhoneNumber" class="form-control-dark" placeholder="VD: 0912345678" disabled required />
                    </div>

                    <!-- Tên khách hàng (Tự điền khi chọn SĐT ở phần bảo hành) -->
                    <div class="mb-3">
                        <label class="form-label-dark small fw-bold mb-1">
                            Tên khách hàng <span class="text-danger">*</span>
                            <span id="lblAutoFillNameHint" class="badge bg-success-subtle text-success ms-1 small d-none">
                                <i class="bi bi-magic"></i> Tự động điền theo SĐT
                            </span>
                        </label>
                        <input type="text" name="customerName" id="inpCustomerName" class="form-control-dark" placeholder="VD: Nguyễn Văn A" disabled required />
                    </div>

                    <!-- Email liên hệ -->
                    <div class="mb-2">
                        <label class="form-label-dark small fw-bold mb-1">Email liên hệ (tùy chọn)</label>
                        <input type="email" name="email" id="inpEmail" class="form-control-dark" placeholder="khachhang@gmail.com" disabled />
                    </div>
                </div>
            </div>

            <!-- CỘT 2: THÔNG TIN MÁY & NGOẠI QUAN -->
            <div class="col-lg-4 col-md-12">
                <div class="bg-white p-3 rounded-3 border h-100 shadow-sm">
                    <div class="d-flex align-items-center justify-content-between pb-2 mb-3 border-bottom">
                        <span class="fw-bold text-dark">
                            <i class="bi bi-laptop text-primary me-2"></i>2. Thông tin máy & Ngoại quan
                        </span>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle small">Cột 2</span>
                    </div>

                    <!-- Tên thiết bị / Model máy -->
                    <div class="mb-3">
                        <label class="form-label-dark small fw-bold mb-1">Thiết bị / Model máy <span class="text-danger">*</span></label>
                        <input type="text" name="deviceModel" id="inpDeviceModel" class="form-control-dark" placeholder="VD: ASUS TUF Gaming A15..." disabled required />
                    </div>

                    <!-- Số Serial / Service Tag -->
                    <div class="mb-3">
                        <label class="form-label-dark small fw-bold mb-1">Số Serial / Service Tag</label>
                        <input type="text" name="serialNumber" id="inpSerialNumber" class="form-control-dark font-monospace" placeholder="VD: SN-DELL-1002" disabled />
                    </div>

                    <!-- Tình trạng ngoại quan -->
                    <div class="mb-3">
                        <label class="form-label-dark small fw-bold mb-1">Tình trạng ngoại quan lúc nhận</label>
                        <input type="text" name="physicalCondition" id="inpPhysicalCondition" class="form-control-dark" placeholder="VD: Vỏ xước nhẹ góc trái, màn hình nguyên vẹn" disabled />
                    </div>

                    <!-- Phụ kiện nhận kèm -->
                    <div class="mb-2">
                        <label class="form-label-dark small fw-bold mb-1">Phụ kiện nhận kèm theo</label>
                        <input type="text" name="accessories" id="inpAccessories" class="form-control-dark" placeholder="VD: Thân máy + Sạc zin 65W" disabled />
                    </div>
                </div>
            </div>

            <!-- CỘT 3: HẠNG MỤC DỊCH VỤ, CHI PHÍ & TRẠNG THÁI -->
            <div class="col-lg-4 col-md-12">
                <div class="bg-white p-3 rounded-3 border h-100 shadow-sm">
                    <div class="d-flex align-items-center justify-content-between pb-2 mb-3 border-bottom">
                        <span class="fw-bold text-dark">
                            <i class="bi bi-tools text-primary me-2"></i>3. Dịch vụ, Chi phí & Trạng thái
                        </span>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle small">Cột 3</span>
                    </div>

                    <!-- Hạng mục dịch vụ -->
                    <div class="mb-3">
                        <label class="form-label-dark small fw-bold mb-1">Hạng mục dịch vụ (Bảng giá niêm yết)</label>
                        <select name="serviceId" id="inpServiceId" class="form-select-dark" disabled onchange="handleCatalogServiceChange()">
                            <option value="">-- Chọn hạng mục bảng giá --</option>
                            @foreach (var s in serviceCatalog)
                            {
                                <option value="@s.ServiceId" data-type="@s.ServiceType" data-cost="@s.EstimatedCost">
                                    [@s.ServiceCode] @s.ServiceName (@(s.ServiceType == "Bảo hành" ? "0đ" : string.Format("{0:N0}đ", s.EstimatedCost)))
                                </option>
                            }
                        </select>
                    </div>

                    <!-- Triệu chứng / Lỗi khách phản ánh -->
                    <div class="mb-3">
                        <label class="form-label-dark small fw-bold mb-1">Triệu chứng / Lỗi khách phản ánh <span class="text-danger">*</span></label>
                        <input type="text" name="faultDescription" id="inpFaultDescription" class="form-control-dark" placeholder="VD: Bật không lên màn hình, cắm sạc chập chờn..." disabled required />
                    </div>

                    <!-- Chi phí & Kỹ thuật viên (2 ô nhỏ cùng hàng) -->
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label-dark small fw-bold mb-1">Chi phí (VNĐ)</label>
                            <input type="number" name="finalCost" id="inpFinalCost" class="form-control-dark fw-bold" placeholder="0" min="0" step="10000" disabled />
                        </div>
                        <div class="col-6">
                            <label class="form-label-dark small fw-bold mb-1">Kỹ thuật phụ trách</label>
                            <input type="text" name="assignedStaff" id="inpAssignedStaff" class="form-control-dark" value="@(User.Identity?.Name ?? "Quản Trị Viên")" disabled />
                        </div>
                    </div>

                    <!-- Trạng thái phiếu tiếp nhận -->
                    <div class="mb-2">
                        <label class="form-label-dark small fw-bold mb-1">Trạng thái phiếu</label>
                        <select name="status" id="inpStatus" class="form-select-dark" disabled>
                            <option value="Chờ tiếp nhận">1. Chờ tiếp nhận (Khách gửi online)</option>
                            <option value="Đã tiếp nhận" selected>2. Đã tiếp nhận (Cầm máy tại quầy)</option>
                            <option value="Đang kiểm tra">3. Đang kiểm tra kỹ thuật</option>
                            <option value="Chờ duyệt báo giá">4. Chờ duyệt báo giá</option>
                            <option value="Đang xử lý">5. Đang xử lý / Sửa chữa</option>
                            <option value="Chờ trả máy">6. Chờ trả máy (Đã sửa xong)</option>
                            <option value="Đã trả máy">7. Đã trả máy (Bàn giao xong)</option>
                            <option value="Đã hủy/Từ chối">8. Đã hủy / Từ chối</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- FORM ẨN DÙNG ĐỂ GỬI YÊU CẦU XÓA PHIẾU -->
<form id="deleteTicketForm" method="post" asp-action="DeleteServiceTicket" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deleteTicketIdInput" value="0" />
</form>

<!-- FILTER BAR (CĂN LỀ TRÁI GỌN GÀNG) -->
<div class="admin-card mb-4 p-3 shadow-sm border">
    <form method="get" asp-action="ServiceTickets" class="d-flex flex-wrap align-items-center gap-2">
        <div class="position-relative" style="width: 300px; max-width: 100%;">
            <i class="bi bi-search position-absolute top-50 translate-middle-y text-muted" style="left: 12px;"></i>
            <input type="text" name="search" value="@currentSearch" class="form-control-dark ps-5" placeholder="Tìm theo mã phiếu, Serial, tên, SĐT..." />
        </div>
        <div style="width: 180px; max-width: 100%;">
            <select name="type" class="form-select-dark" onchange="this.form.submit()">
                <option value="all" selected="@(currentType == "all" ? "selected" : null)">Tất cả loại dịch vụ</option>
                <option value="Bảo hành" selected="@(currentType == "Bảo hành" ? "selected" : null)">Bảo hành máy đã mua</option>
                <option value="Sửa chữa" selected="@(currentType == "Sửa chữa" ? "selected" : null)">Sửa chữa dịch vụ</option>
            </select>
        </div>
        <div style="width: 210px; max-width: 100%;">
            <select name="status" class="form-select-dark" onchange="this.form.submit()">
                <option value="all" selected="@(currentStatus == "all" ? "selected" : null)">Tất cả trạng thái</option>
                <option value="Chờ tiếp nhận" selected="@(currentStatus == "Chờ tiếp nhận" ? "selected" : null)">1. Chờ tiếp nhận</option>
                <option value="Đã tiếp nhận" selected="@(currentStatus == "Đã tiếp nhận" ? "selected" : null)">2. Đã tiếp nhận vật lý</option>
                <option value="Đang kiểm tra" selected="@(currentStatus == "Đang kiểm tra" ? "selected" : null)">3. Đang kiểm tra</option>
                <option value="Chờ duyệt báo giá" selected="@(currentStatus == "Chờ duyệt báo giá" ? "selected" : null)">4. Chờ duyệt báo giá</option>
                <option value="Đang xử lý" selected="@(currentStatus == "Đang xử lý" ? "selected" : null)">5. Đang xử lý</option>
                <option value="Chờ trả máy" selected="@(currentStatus == "Chờ trả máy" ? "selected" : null)">6. Chờ trả máy</option>
                <option value="Đã trả máy" selected="@(currentStatus == "Đã trả máy" ? "selected" : null)">7. Đã trả máy (Hoàn tất)</option>
                <option value="Đã hủy/Từ chối" selected="@(currentStatus == "Đã hủy/Từ chối" ? "selected" : null)">8. Đã hủy / Từ chối</option>
            </select>
        </div>
        <button type="submit" class="btn-action-tool">
            <i class="bi bi-funnel"></i> Lọc
        </button>
        @if (!string.IsNullOrEmpty(currentSearch) || currentStatus != "all" || currentType != "all")
        {
            <a href="/Admin/ServiceTickets" class="btn-action-tool" title="Đặt lại bộ lọc">
                <i class="bi bi-x-circle"></i> Xóa lọc
            </a>
        }
    </form>
</div>

<!-- BẢNG PHIẾU DỊCH VỤ -->
<div class="admin-card shadow-sm border">
    <div class="admin-card-header d-flex justify-content-between align-items-center py-3 bg-white border-bottom">
        <h5 class="card-title-text mb-0 fw-bold">
            <i class="bi bi-card-checklist text-primary me-2"></i> Danh sách phiếu tiếp nhận (@Model.Count())
        </h5>
        <span class="badge bg-light text-muted border small">Bấm vào hàng để chọn phiếu</span>
    </div>
    <div class="admin-table-container">
        <table class="admin-table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th style="width: 120px;">Mã phiếu</th>
                    <th style="width: 180px;">Loại & Thiết bị</th>
                    <th style="width: 160px;">Khách hàng</th>
                    <th>Hạng mục & Triệu chứng</th>
                    <th style="width: 130px;">Chi phí</th>
                    <th style="width: 130px;">Trạng thái</th>
                    <th style="width: 130px;">Ngày tạo</th>
                    <th class="text-end pe-3" style="width: 150px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var t in Model)
                    {
                        var statusBadgeClass = t.Status switch
                        {
                            "Chờ tiếp nhận" => "bg-warning text-dark border",
                            "Đã tiếp nhận" => "bg-info text-white",
                            "Đang kiểm tra" => "bg-primary text-white",
                            "Chờ duyệt báo giá" => "bg-danger text-white",
                            "Đang xử lý" => "bg-secondary text-white",
                            "Chờ trả máy" => "bg-success-subtle text-success border border-success",
                            "Đã trả máy" => "badge-paid",
                            _ => "badge-out-of-stock"
                        };

                        <tr class="ticket-row"
                            style="cursor: pointer; transition: all 0.15s ease;"
                            data-id="@t.TicketId"
                            data-code="@t.TicketCode"
                            data-type="@t.TicketType"
                            data-status="@t.Status"
                            data-name="@t.CustomerName"
                            data-phone="@t.PhoneNumber"
                            data-email="@t.Email"
                            data-device="@t.DeviceDisplayName"
                            data-serial="@t.SerialNumber"
                            data-serviceid="@(t.ServiceId ?? 0)"
                            data-fault="@t.FaultDescription"
                            data-physical="@t.PhysicalCondition"
                            data-acc="@t.Accessories"
                            data-cost="@Convert.ToInt64(t.FinalCost)"
                            data-staff="@t.AssignedStaff"
                            onclick="handleTicketRowClick(this)"
                            ondblclick="handleTicketRowDblClick(this)">
                            <td class="fw-bold font-monospace">
                                <a href="/Admin/ServiceTicketDetails/@t.TicketId" class="text-primary text-decoration-none" onclick="event.stopPropagation()">
                                    #@t.TicketCode
                                </a>
                            </td>
                            <td>
                                <div>
                                    @if (t.TicketType == "Bảo hành")
                                    {
                                        <span class="badge bg-success-subtle text-success border small mb-1">
                                            <i class="bi bi-shield-check"></i> Bảo hành
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border small mb-1">
                                            <i class="bi bi-wrench"></i> Sửa chữa
                                        </span>
                                    }
                                </div>
                                <div class="fw-semibold text-dark small">@t.DeviceDisplayName</div>
                                @if (!string.IsNullOrEmpty(t.SerialNumber))
                                {
                                    <div class="text-muted font-monospace small" style="font-size: 11px;">SN: @t.SerialNumber</div>
                                }
                            </td>
                            <td>
                                <div class="text-dark fw-semibold small">@t.CustomerName</div>
                                <div class="text-muted small"><i class="bi bi-telephone me-1"></i>@t.PhoneNumber</div>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(t.ServiceName))
                                {
                                    <div class="text-primary small fw-semibold">@t.ServiceName</div>
                                }
                                <div class="text-secondary small text-truncate" style="max-width: 240px;" title="@t.FaultDescription">
                                    @t.FaultDescription
                                </div>
                                @if (!string.IsNullOrEmpty(t.PhysicalCondition))
                                {
                                    <div class="text-muted" style="font-size: 11px;">Ngoại quan: @t.PhysicalCondition</div>
                                }
                            </td>
                            <td class="fw-bold text-dark text-nowrap">
                                @if (t.TicketType == "Bảo hành" && t.FinalCost == 0)
                                {
                                    <span class="text-success">0đ (BH)</span>
                                }
                                else
                                {
                                    <span>@string.Format("{0:N0}đ", t.FinalCost)</span>
                                }
                            </td>
                            <td>
                                <span class="badge @statusBadgeClass">
                                    @t.Status
                                </span>
                            </td>
                            <td class="text-muted small text-nowrap">
                                @t.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td class="text-end pe-3 text-nowrap" onclick="event.stopPropagation()">
                                <div class="d-inline-flex gap-1">
                                    <a href="/Admin/ServiceTicketDetails/@t.TicketId" class="btn-action-tool btn-sm" title="Xem chi tiết phiếu & Báo giá">
                                        <i class="bi bi-eye"></i> Xem
                                    </a>
                                    <button type="button" class="btn-action-tool btn-sm" onclick="quickEditTicket(@t.TicketId)" title="Sửa phiếu này">
                                        <i class="bi bi-pencil"></i> Sửa
                                    </button>
                                    <button type="button" class="btn-action-tool btn-sm" onclick="quickDeleteTicket(@t.TicketId, '@t.TicketCode', '@t.CustomerName')" title="Xóa phiếu này">
                                        <i class="bi bi-trash"></i> Xóa
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            Không có phiếu dịch vụ nào phù hợp với bộ lọc tìm kiếm.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .ticket-row.row-selected {
        background-color: #eff6ff !important;
        border-left: 4px solid #2563eb !important;
    }
    .ticket-row.row-selected td {
        background-color: transparent !important;
    }
</style>

@section Scripts {
    <script>
        let selectedTicketRow = null;
        let ticketMode = 'view'; // 'view' | 'add' | 'edit'

        const ticketInputs = [
            'inpTicketType', 'inpTicketCode', 'inpCustomerName', 'inpPhoneNumber', 'inpEmail',
            'inpDeviceModel', 'inpSerialNumber', 'inpServiceId', 'inpFaultDescription',
            'inpPhysicalCondition', 'inpAccessories', 'inpStatus', 'inpFinalCost', 'inpAssignedStaff',
            'selCustomerPhone'
        ];

        function setTicketInputsDisabled(disabled) {
            ticketInputs.forEach(id => {
                const el = document.getElementById(id);
                if (el) el.disabled = disabled;
            });
        }

        function handleTicketTypeChange(isUserAction = true) {
            const type = document.getElementById('inpTicketType').value;
            const codeInput = document.getElementById('inpTicketCode');
            const costInput = document.getElementById('inpFinalCost');
            const divSelect = document.getElementById('divSelectPhone');
            const divInput = document.getElementById('divInputPhone');
            const nameInput = document.getElementById('inpCustomerName');
            const nameHint = document.getElementById('lblAutoFillNameHint');

            if (type === 'Bảo hành') {
                // Hiển thị ô chọn số điện thoại, ẩn ô nhập SĐT tự do
                if (divSelect) divSelect.style.display = 'block';
                if (divInput) divInput.style.display = 'none';
                if (nameHint) nameHint.classList.remove('d-none');
                if (nameInput) {
                    nameInput.readOnly = true;
                    nameInput.placeholder = 'Hệ thống tự động điền Tên khi chọn SĐT bên trên';
                }

                if (ticketMode === 'add' && isUserAction) {
                    if (codeInput.value.startsWith('SC-')) {
                        codeInput.value = codeInput.value.replace('SC-', 'BH-');
                    }
                    costInput.value = '0';
                }
            } else {
                // Hiển thị ô nhập SĐT tự do cho khách sửa ngoài
                if (divSelect) divSelect.style.display = 'none';
                if (divInput) divInput.style.display = 'block';
                if (nameHint) nameHint.classList.add('d-none');
                if (nameInput) {
                    nameInput.readOnly = false;
                    nameInput.placeholder = 'VD: Nguyễn Văn A';
                }

                if (ticketMode === 'add' && isUserAction) {
                    if (codeInput.value.startsWith('BH-')) {
                        codeInput.value = codeInput.value.replace('BH-', 'SC-');
                    }
                }
            }
        }

        function handleCustomerPhoneSelect(selectEl) {
            if (!selectEl) return;
            const opt = selectEl.options[selectEl.selectedIndex];
            if (opt && opt.value) {
                // Tự động điền số điện thoại
                document.getElementById('inpPhoneNumber').value = opt.value;

                // Tự động điền tên khách hàng
                if (opt.dataset.name) {
                    document.getElementById('inpCustomerName').value = opt.dataset.name;
                }

                // Tự động điền email nếu có
                if (opt.dataset.email) {
                    document.getElementById('inpEmail').value = opt.dataset.email;
                }

                // Tự động điền Thiết bị & Serial máy đã mua
                if (opt.dataset.device) {
                    document.getElementById('inpDeviceModel').value = opt.dataset.device;
                }
                if (opt.dataset.serial) {
                    document.getElementById('inpSerialNumber').value = opt.dataset.serial;
                }

                // Bảo hành thì tiền dịch vụ là 0đ
                document.getElementById('inpFinalCost').value = '0';
            } else {
                document.getElementById('inpPhoneNumber').value = '';
                document.getElementById('inpCustomerName').value = '';
            }
        }

        function clearTicketForm() {
            document.getElementById('inpTicketId').value = '0';
            document.getElementById('inpTicketType').value = 'Sửa chữa';
            document.getElementById('inpTicketCode').value = '';
            document.getElementById('inpCustomerName').value = '';
            document.getElementById('inpPhoneNumber').value = '';
            document.getElementById('inpEmail').value = '';
            document.getElementById('inpDeviceModel').value = '';
            document.getElementById('inpSerialNumber').value = '';
            document.getElementById('inpServiceId').value = '';
            document.getElementById('inpFaultDescription').value = '';
            document.getElementById('inpPhysicalCondition').value = '';
            document.getElementById('inpAccessories').value = '';
            document.getElementById('inpStatus').value = 'Đã tiếp nhận';
            document.getElementById('inpFinalCost').value = '0';

            const sel = document.getElementById('selCustomerPhone');
            if (sel) sel.value = '';

            handleTicketTypeChange(false);
        }

        function populateTicketForm(row) {
            if (!row) return;
            document.getElementById('inpTicketId').value = row.dataset.id || '0';
            document.getElementById('inpTicketType').value = row.dataset.type || 'Sửa chữa';
            document.getElementById('inpTicketCode').value = row.dataset.code || '';
            document.getElementById('inpCustomerName').value = row.dataset.name || '';
            document.getElementById('inpPhoneNumber').value = row.dataset.phone || '';
            document.getElementById('inpEmail').value = row.dataset.email || '';
            document.getElementById('inpDeviceModel').value = row.dataset.device || '';
            document.getElementById('inpSerialNumber').value = row.dataset.serial || '';
            document.getElementById('inpServiceId').value = (row.dataset.serviceid && row.dataset.serviceid !== '0') ? row.dataset.serviceid : '';
            document.getElementById('inpFaultDescription').value = row.dataset.fault || '';
            document.getElementById('inpPhysicalCondition').value = row.dataset.physical || '';
            document.getElementById('inpAccessories').value = row.dataset.acc || '';
            document.getElementById('inpStatus').value = row.dataset.status || 'Đã tiếp nhận';
            document.getElementById('inpFinalCost').value = row.dataset.cost || '0';
            document.getElementById('inpAssignedStaff').value = row.dataset.staff || '';

            handleTicketTypeChange(false);

            if (row.dataset.type === 'Bảo hành') {
                const sel = document.getElementById('selCustomerPhone');
                if (sel) {
                    sel.value = row.dataset.phone || '';
                    if (row.dataset.phone && sel.value !== row.dataset.phone) {
                        const opt = document.createElement('option');
                        opt.value = row.dataset.phone;
                        opt.text = row.dataset.phone + ' - ' + (row.dataset.name || '') + ' (' + (row.dataset.device || '') + ')';
                        sel.add(opt);
                        sel.value = row.dataset.phone;
                    }
                }
            }
        }

        function handleTicketRowClick(row) {
            if (ticketMode === 'add' || ticketMode === 'edit') {
                const ok = confirm('Bạn đang trong chế độ nhập liệu (' + (ticketMode === 'add' ? 'Thêm mới' : 'Chỉnh sửa') + '). Chọn dòng khác sẽ hủy các thay đổi chưa lưu?');
                if (!ok) return;
            }

            if (selectedTicketRow) {
                selectedTicketRow.classList.remove('row-selected');
            }

            selectedTicketRow = row;
            selectedTicketRow.classList.add('row-selected');
            ticketMode = 'view';

            populateTicketForm(row);
            setTicketInputsDisabled(true);

            document.getElementById('btnThemTicket').disabled = false;
            document.getElementById('btnSuaTicket').disabled = false;
            document.getElementById('btnXoaTicket').disabled = false;
            document.getElementById('btnLuuTicket').disabled = true;
            document.getElementById('btnHuyTicket').disabled = true;

            const code = row.dataset.code;
            const name = row.dataset.name;
            document.getElementById('toolbarTicketHint').innerHTML = 
                '<span class="badge bg-primary-subtle text-primary border border-primary-subtle me-1">Đã chọn: #' + code + '</span> ' +
                'Khách hàng <strong>' + name + '</strong>. Bấm <strong>[Sửa]</strong> để chỉnh sửa hoặc <strong>[Xóa]</strong> để gỡ bỏ.';
        }

        function handleTicketRowDblClick(row) {
            handleTicketRowClick(row);
            onSuaTicketClick();
        }

        function onThemTicketClick() {
            ticketMode = 'add';
            if (selectedTicketRow) {
                selectedTicketRow.classList.remove('row-selected');
                selectedTicketRow = null;
            }

            clearTicketForm();
            setTicketInputsDisabled(false);

            // Sinh mã phiếu dự kiến theo ngày
            const now = new Date();
            const yyyy = now.getFullYear();
            const mm = String(now.getMonth() + 1).padStart(2, '0');
            const dd = String(now.getDate()).padStart(2, '0');
            const randomSuffix = Math.floor(1000 + Math.random() * 9000);
            const prefix = document.getElementById('inpTicketType').value === 'Bảo hành' ? 'BH' : 'SC';
            document.getElementById('inpTicketCode').value = prefix + '-' + yyyy + mm + dd + '-' + randomSuffix;

            document.getElementById('btnThemTicket').disabled = true;
            document.getElementById('btnSuaTicket').disabled = true;
            document.getElementById('btnXoaTicket').disabled = true;
            document.getElementById('btnLuuTicket').disabled = false;
            document.getElementById('btnHuyTicket').disabled = false;

            handleTicketTypeChange(false);

            document.getElementById('toolbarTicketHint').innerHTML = 
                '<span class="badge bg-success-subtle text-success border border-success-subtle me-1">Chế độ Thêm phiếu mới</span> ' +
                'Chọn loại dịch vụ, chọn/nhập thông tin khách hàng rồi nhấn <strong>[Lưu]</strong>.';

            if (document.getElementById('inpTicketType').value === 'Bảo hành') {
                document.getElementById('selCustomerPhone').focus();
            } else {
                document.getElementById('inpCustomerName').focus();
            }
        }

        function onSuaTicketClick() {
            if (!selectedTicketRow) {
                alert('Vui lòng nhấp chọn 1 phiếu trong bảng trước khi bấm Sửa.');
                return;
            }

            ticketMode = 'edit';
            setTicketInputsDisabled(false);
            handleTicketTypeChange(false);

            document.getElementById('btnThemTicket').disabled = true;
            document.getElementById('btnSuaTicket').disabled = true;
            document.getElementById('btnXoaTicket').disabled = true;
            document.getElementById('btnLuuTicket').disabled = false;
            document.getElementById('btnHuyTicket').disabled = false;

            const code = selectedTicketRow.dataset.code;
            document.getElementById('toolbarTicketHint').innerHTML = 
                '<span class="badge bg-warning-subtle text-dark border border-warning me-1">Chế độ Chỉnh sửa</span> ' +
                'Đang sửa phiếu <strong>#' + code + '</strong>. Sửa các thông tin cần thiết rồi nhấn <strong>[Lưu]</strong> hoặc <strong>[Hủy]</strong>.';

            if (document.getElementById('inpTicketType').value === 'Bảo hành') {
                document.getElementById('selCustomerPhone').focus();
            } else {
                document.getElementById('inpCustomerName').focus();
            }
        }

        function onXoaTicketClick() {
            if (!selectedTicketRow) {
                alert('Vui lòng nhấp chọn 1 phiếu trong bảng trước khi bấm Xóa.');
                return;
            }

            const id = selectedTicketRow.dataset.id;
            const code = selectedTicketRow.dataset.code;
            const name = selectedTicketRow.dataset.name;

            quickDeleteTicket(id, code, name);
        }

        function quickDeleteTicket(id, code, name) {
            const confirmed = confirm('Bạn có chắc chắn muốn xóa vĩnh viễn phiếu tiếp nhận sau khỏi hệ thống?\n\n- Mã phiếu: #' + code + '\n- Khách hàng: ' + name + '\n\n* Lưu ý: Thao tác này sẽ xóa toàn bộ nhật ký và báo giá kèm theo của phiếu.');
            if (confirmed) {
                document.getElementById('deleteTicketIdInput').value = id;
                document.getElementById('deleteTicketForm').submit();
            }
        }

        function quickEditTicket(id) {
            const row = document.querySelector('.ticket-row[data-id="' + id + '"]');
            if (row) {
                handleTicketRowClick(row);
                onSuaTicketClick();
            }
        }

        function onLuuTicketClick() {
            const type = document.getElementById('inpTicketType').value;
            const nameInput = document.getElementById('inpCustomerName');
            const phoneInput = document.getElementById('inpPhoneNumber');
            const selPhone = document.getElementById('selCustomerPhone');
            const faultInput = document.getElementById('inpFaultDescription');
            const deviceInput = document.getElementById('inpDeviceModel');

            if (type === 'Bảo hành') {
                if (!phoneInput.value.trim() && selPhone && selPhone.value) {
                    phoneInput.value = selPhone.value;
                }
                if (!phoneInput.value.trim()) {
                    alert('Vui lòng chọn Số điện thoại khách hàng bảo hành.');
                    selPhone.focus();
                    return;
                }
            } else {
                if (!phoneInput.value.trim()) {
                    alert('Vui lòng nhập Số điện thoại của khách.');
                    phoneInput.focus();
                    return;
                }
            }

            if (!nameInput.value.trim()) {
                alert('Vui lòng nhập hoặc chọn Tên khách hàng.');
                nameInput.focus();
                return;
            }

            if (!deviceInput.value.trim()) {
                alert('Vui lòng nhập Thiết bị / Model máy.');
                deviceInput.focus();
                return;
            }

            if (!faultInput.value.trim()) {
                alert('Vui lòng nhập Triệu chứng / Lỗi khách phản ánh.');
                faultInput.focus();
                return;
            }

            document.getElementById('ticketForm').submit();
        }

        function onHuyTicketClick() {
            setTicketInputsDisabled(true);
            ticketMode = 'view';

            document.getElementById('btnThemTicket').disabled = false;
            document.getElementById('btnLuuTicket').disabled = true;
            document.getElementById('btnHuyTicket').disabled = true;

            if (selectedTicketRow) {
                populateTicketForm(selectedTicketRow);
                document.getElementById('btnSuaTicket').disabled = false;
                document.getElementById('btnXoaTicket').disabled = false;
                document.getElementById('toolbarTicketHint').innerHTML = 
                    '<span class="badge bg-primary-subtle text-primary border border-primary-subtle me-1">Đã chọn: #' + selectedTicketRow.dataset.code + '</span> ' +
                    'Khách hàng <strong>' + selectedTicketRow.dataset.name + '</strong>. Bấm <strong>[Sửa]</strong> để chỉnh sửa hoặc <strong>[Xóa]</strong> để gỡ bỏ.';
            } else {
                clearTicketForm();
                document.getElementById('btnSuaTicket').disabled = true;
                document.getElementById('btnXoaTicket').disabled = true;
                document.getElementById('toolbarTicketHint').innerHTML = 
                    '<i class="bi bi-info-circle me-1 text-primary"></i> Nhấp chọn 1 dòng trong bảng để <strong>Sửa</strong> hoặc <strong>Xóa</strong>. Bấm <strong>Thêm</strong> để tạo phiếu tiếp nhận máy tại quầy.';
            }
        }

        function onThoatTicketClick() {
            if (ticketMode !== 'view' && ticketMode !== 'idle') {
                if (confirm('Bạn đang có thao tác nhập phiếu chưa lưu. Bạn có muốn hủy và thoát không?')) {
                    onHuyTicketClick();
                }
            } else {
                window.location.href = '/Admin/Orders';
            }
        }

        function handleCatalogServiceChange() {
            const select = document.getElementById('inpServiceId');
            const selectedOpt = select.options[select.selectedIndex];
            if (!selectedOpt || !selectedOpt.value) return;

            const cost = selectedOpt.dataset.cost;
            const costInput = document.getElementById('inpFinalCost');
            if (cost && (!costInput.value || costInput.value === '0')) {
                costInput.value = cost;
            }
        }
    </script>
}
