@model LaptopStore.ViewModels.ServiceTicketDetailDto
@{
    ViewData["Title"] = $"Chi tiết phiếu #{Model.TicketCode}";
}

<div class="page-header">
    <div>
        <a href="/Admin/ServiceTickets" class="btn btn-sm btn-secondary-custom mb-2">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách
        </a>
        <h2 class="page-title">
            <i class="bi bi-tools text-primary me-2"></i>Phiếu dịch vụ #@Model.TicketCode
            <span class="badge @(Model.TicketType == "Bảo hành" ? "bg-success" : "bg-warning text-dark") fs-6 ms-2">
                @Model.TicketType
            </span>
        </h2>
    </div>
    <div class="page-actions d-flex gap-2">
        <button type="button" class="btn btn-primary-custom" data-bs-toggle="modal" data-bs-target="#modal-update-status">
            <i class="bi bi-pencil-square"></i> Cập nhật trạng thái
        </button>
        <button type="button" class="btn btn-secondary-custom" data-bs-toggle="modal" data-bs-target="#modal-create-quote">
            <i class="bi bi-cash"></i> Tạo báo giá
        </button>
        <button type="button" class="btn btn-secondary-custom" onclick="window.print()">
            <i class="bi bi-printer"></i> In phiếu
        </button>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show bg-success-subtle text-success border border-success mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show bg-danger-subtle text-danger border border-danger mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    
    <div class="col-lg-8">
        
        <div class="admin-card mb-4">
            <div class="admin-card-header">
                <h5 class="card-title-text mb-0"><i class="bi bi-laptop text-primary me-2"></i>Thông tin thiết bị & Triệu chứng tiếp nhận</h5>
            </div>
            <div class="p-3">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="small text-muted">Tên thiết bị:</div>
                        <div class="fw-bold fs-6 text-dark">@Model.DeviceDisplayName</div>
                        @if (Model.IsStoreDevice)
                        {
                            <span class="badge bg-success-subtle text-success border mt-1">
                                <i class="bi bi-check-circle-fill"></i> Máy mua tại Laptop World
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary border mt-1">
                                <i class="bi bi-box-arrow-in-right"></i> Máy mua ngoài
                            </span>
                        }
                    </div>
                    <div class="col-md-6">
                        <div class="small text-muted">Số Serial máy:</div>
                        <div class="font-monospace fw-bold fs-6 text-primary">@Model.SerialNumber</div>
                        @if (Model.IsStoreDevice)
                        {
                            <div class="small text-muted mt-1">
                                Hạn bảo hành máy: 
                                <strong class="@(Model.IsUnderWarranty ? "text-success" : "text-danger")">
                                    @(Model.WarrantyEndDate?.ToString("dd/MM/yyyy") ?? "Chưa rõ") 
                                    @(Model.IsUnderWarranty ? "(Còn hạn)" : "(Đã hết hạn)")
                                </strong>
                            </div>
                        }
                    </div>

                    <div class="col-12 border-top pt-2">
                        <div class="small text-muted">Mô tả triệu chứng / lỗi khách báo:</div>
                        <div class="p-3 rounded bg-light border text-dark mt-1 fw-medium">
                            @Model.FaultDescription
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="small text-muted">Ngoại quan tiếp nhận:</div>
                        <div class="text-dark">@(string.IsNullOrEmpty(Model.PhysicalCondition) ? "Chưa ghi nhận" : Model.PhysicalCondition)</div>
                    </div>
                    <div class="col-md-6">
                        <div class="small text-muted">Phụ kiện đi kèm:</div>
                        <div class="text-dark">@(string.IsNullOrEmpty(Model.Accessories) ? "Không có" : Model.Accessories)</div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.RejectReason))
                    {
                        <div class="col-12 border-top pt-2">
                            <div class="small text-danger fw-bold">Lý do từ chối bảo hành:</div>
                            <div class="alert alert-danger py-2 px-3 mt-1 small">
                                @Model.RejectReason
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        
        <div class="admin-card mb-4">
            <div class="admin-card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title-text mb-0"><i class="bi bi-cash-stack text-success me-2"></i>Báo giá chi phí sửa chữa & linh kiện</h5>
                <button type="button" class="btn btn-sm btn-primary-custom" data-bs-toggle="modal" data-bs-target="#modal-create-quote">
                    <i class="bi bi-plus-lg"></i> Thêm báo giá
                </button>
            </div>
            <div class="p-3">
                @if (Model.Quotes != null && Model.Quotes.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-bordered table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Nội dung công việc / Linh kiện</th>
                                    <th>Số tiền</th>
                                    <th>Quyết định của khách</th>
                                    <th>Thời điểm phản hồi</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var q in Model.Quotes)
                                {
                                    var decisionBadge = q.CustomerDecision switch
                                    {
                                        "Đồng ý" => "bg-success text-white",
                                        "Từ chối" => "bg-danger text-white",
                                        _ => "bg-warning text-dark border"
                                    };
                                    <tr>
                                        <td>@q.Description</td>
                                        <td class="fw-bold text-success text-nowrap">@string.Format("{0:N0}đ", q.Amount)</td>
                                        <td><span class="badge @decisionBadge">@q.CustomerDecision</span></td>
                                        <td class="small text-muted">@(q.DecisionAt?.ToString("dd/MM/yyyy HH:mm") ?? "Chờ khách duyệt")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-muted small text-center py-3">
                        Chưa có báo giá nào được tạo. Với dịch vụ bảo hành hợp lệ, chi phí mặc định là 0đ.
                    </div>
                }
            </div>
        </div>

        
        <div class="admin-card">
            <div class="admin-card-header">
                <h5 class="card-title-text mb-0"><i class="bi bi-clock-history text-primary me-2"></i>Nhật ký hành trình xử lý (Timeline)</h5>
            </div>
            <div class="p-3">
                @if (Model.Histories != null && Model.Histories.Any())
                {
                    <div class="position-relative ps-4 border-start border-2 border-primary ms-3">
                        @foreach (var h in Model.Histories)
                        {
                            <div class="mb-3 position-relative">
                                <div class="position-absolute rounded-circle bg-primary" style="width: 10px; height: 10px; left: -21px; top: 5px;"></div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="badge bg-light text-dark border fw-bold">@h.NewStatus</span>
                                    <span class="small text-muted">@h.ActionAt.ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                                <div class="small text-dark mt-1">@h.Notes</div>
                                <div class="small text-muted fst-italic">Thực hiện bởi: @h.ActionBy</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-muted small text-center py-3">Chưa có nhật ký ghi nhận.</div>
                }
            </div>
        </div>
    </div>

    
    <div class="col-lg-4">
        
        <div class="admin-card mb-4 p-3">
            <div class="small text-muted mb-1">Trạng thái hiện tại:</div>
            <h5 class="fw-bold text-primary mb-3">@Model.Status</h5>

            <div class="border-top pt-2 mb-2">
                <div class="small text-muted">Tổng chi phí chốt:</div>
                <h4 class="fw-bold text-success mb-0">@string.Format("{0:N0}đ", Model.FinalCost)</h4>
                @if (Model.TicketType == "Bảo hành" && Model.FinalCost == 0)
                {
                    <small class="text-success"><i class="bi bi-check-circle"></i> Miễn phí theo chính sách bảo hành</small>
                }
            </div>

            @if (Model.ServiceWarrantyUntil.HasValue)
            {
                <div class="border-top pt-2 mb-2">
                    <div class="small text-muted">Bảo hành sau sửa đến:</div>
                    <strong class="text-primary">@Model.ServiceWarrantyUntil.Value.ToString("dd/MM/yyyy")</strong>
                </div>
            }

            <div class="border-top pt-2 small text-muted">
                <div>Ngày gửi online: <strong>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</strong></div>
                @if (Model.ReceivedAt.HasValue)
                {
                    <div>Ngày nhận vật lý: <strong>@Model.ReceivedAt.Value.ToString("dd/MM/yyyy HH:mm")</strong></div>
                }
                @if (Model.CompletedAt.HasValue)
                {
                    <div>Ngày sửa xong: <strong>@Model.CompletedAt.Value.ToString("dd/MM/yyyy HH:mm")</strong></div>
                }
                @if (Model.ReturnedAt.HasValue)
                {
                    <div>Ngày bàn giao: <strong>@Model.ReturnedAt.Value.ToString("dd/MM/yyyy HH:mm")</strong></div>
                }
                @if (!string.IsNullOrEmpty(Model.AssignedStaff))
                {
                    <div>Kỹ thuật phụ trách: <strong>@Model.AssignedStaff</strong></div>
                }
            </div>
        </div>

        
        <div class="admin-card p-3">
            <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">
                <i class="bi bi-person text-primary me-2"></i>Thông tin người liên hệ
            </h6>
            <div class="mb-2">
                <div class="small text-muted">Họ và tên:</div>
                <div class="fw-semibold text-dark">@Model.CustomerName</div>
            </div>
            <div class="mb-2">
                <div class="small text-muted">Số điện thoại:</div>
                <div class="fw-semibold text-primary"><i class="bi bi-telephone me-1"></i>@Model.PhoneNumber</div>
            </div>
            @if (!string.IsNullOrEmpty(Model.Email))
            {
                <div class="mb-2">
                    <div class="small text-muted">Email:</div>
                    <div class="text-dark small"><i class="bi bi-envelope me-1"></i>@Model.Email</div>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.Address))
            {
                <div class="mb-2">
                    <div class="small text-muted">Địa chỉ nhận trả:</div>
                    <div class="text-dark small"><i class="bi bi-geo-alt me-1"></i>@Model.Address</div>
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="modal-update-status" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-white text-dark border-0 shadow-lg rounded-3">
            <div class="modal-header border-bottom bg-light">
                <h5 class="modal-title fs-6 fw-bold">
                    <i class="bi bi-pencil-square text-primary me-2"></i>Cập nhật tiến độ phiếu #@Model.TicketCode
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-action="UpdateServiceTicket">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ticketId" value="@Model.TicketId" />
                <input type="hidden" name="returnUrl" value="/Admin/ServiceTicketDetails/@Model.TicketId" />

                <div class="modal-body text-start">
                    <div class="mb-3">
                        <label class="form-label-dark">Chuyển sang trạng thái mới *</label>
                        <select name="newStatus" class="form-select-dark">
                            <option value="Chờ tiếp nhận" selected="@(Model.Status == "Chờ tiếp nhận" ? "selected" : null)">1. Chờ tiếp nhận (Khách vừa gửi online)</option>
                            <option value="Đã tiếp nhận" selected="@(Model.Status == "Đã tiếp nhận" ? "selected" : null)">2. Đã tiếp nhận vật lý (Cửa hàng đã nhận máy)</option>
                            <option value="Đang kiểm tra" selected="@(Model.Status == "Đang kiểm tra" ? "selected" : null)">3. Đang kiểm tra lỗi</option>
                            <option value="Chờ duyệt báo giá" selected="@(Model.Status == "Chờ duyệt báo giá" ? "selected" : null)">4. Chờ duyệt báo giá</option>
                            <option value="Đang xử lý" selected="@(Model.Status == "Đang xử lý" ? "selected" : null)">5. Đang xử lý / Sửa chữa</option>
                            <option value="Chờ trả máy" selected="@(Model.Status == "Chờ trả máy" ? "selected" : null)">6. Chờ trả máy (Kỹ thuật đã hoàn tất)</option>
                            <option value="Đã trả máy" selected="@(Model.Status == "Đã trả máy" ? "selected" : null)">7. Đã trả máy (Bàn giao xong cho khách)</option>
                            <option value="Đã hủy/Từ chối" selected="@(Model.Status == "Đã hủy/Từ chối" ? "selected" : null)">8. Đã hủy / Từ chối</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label-dark">Tình trạng ngoại quan</label>
                        <input type="text" name="physicalCondition" value="@Model.PhysicalCondition" class="form-control-dark" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label-dark">Phụ kiện đi kèm</label>
                        <input type="text" name="accessories" value="@Model.Accessories" class="form-control-dark" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label-dark">Chi phí thực thu (VND)</label>
                        <input type="number" step="1000" name="finalCost" value="@Convert.ToInt64(Model.FinalCost)" class="form-control-dark" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label-dark">Bảo hành sau sửa (tháng)</label>
                        <input type="number" name="warrantyMonthsAfterRepair" value="1" min="0" max="36" class="form-control-dark" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label-dark">Lý do từ chối (nếu từ chối bảo hành/sửa)</label>
                        <input type="text" name="rejectReason" value="@Model.RejectReason" class="form-control-dark" placeholder="VD: Lỗi do rơi vỡ, tem bảo hành rách..." />
                    </div>

                    <div class="mb-3">
                        <label class="form-label-dark">Ghi chú thao tác</label>
                        <input type="text" name="notes" class="form-control-dark" placeholder="VD: Đã thay thế xong chip nguồn..." />
                    </div>
                </div>
                <div class="modal-footer border-top bg-light">
                    <button type="button" class="btn-secondary-custom" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn-primary-custom">
                        <i class="bi bi-check2-circle"></i> Lưu cập nhật
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="modal-create-quote" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-white text-dark border-0 shadow-lg rounded-3">
            <div class="modal-header border-bottom bg-light">
                <h5 class="modal-title fs-6 fw-bold">
                    <i class="bi bi-cash text-success me-2"></i>Tạo báo giá dịch vụ cho khách duyệt
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-action="CreateServiceQuote">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ticketId" value="@Model.TicketId" />
                <input type="hidden" name="returnUrl" value="/Admin/ServiceTicketDetails/@Model.TicketId" />

                <div class="modal-body text-start">
                    <div class="mb-3">
                        <label class="form-label-dark">Nội dung công việc & Linh kiện thay thế *</label>
                        <textarea name="description" class="form-control-dark" rows="3" required placeholder="VD: Thay thế màn hình Full HD IPS 144Hz chính hãng + Vệ sinh bôi keo gốm MX4"></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label-dark">Số tiền báo giá (VND) *</label>
                        <input type="number" step="1000" name="amount" required class="form-control-dark" placeholder="VD: 1650000" />
                        <small class="text-muted">Khách hàng sẽ nhìn thấy báo giá này trên trang theo dõi và bấm Đồng ý / Từ chối.</small>
                    </div>
                </div>
                <div class="modal-footer border-top bg-light">
                    <button type="button" class="btn-secondary-custom" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn-primary-custom">
                        <i class="bi bi-send"></i> Gửi báo giá
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
