@model LaptopStore.ViewModels.AdminReportsViewModel
@using System.Globalization
@{
    Layout = "_Layout";
    ViewData["Title"] = "Báo cáo & Thống kê Quản trị";
    var viCulture = CultureInfo.GetCultureInfo("vi-VN");
    string FormatVND(decimal amount) => amount.ToString("#,##0", viCulture) + " ₫";
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="page-title text-dark fw-bold mb-1">
            <i class="bi bi-graph-up-arrow text-dark me-2"></i>Báo cáo & Thống kê Đa chiều
        </h2>
        <p class="text-muted small mb-0">
            Theo dõi hiệu suất bán hàng, dòng tiền thực thu trả góp, biến thể laptop và quy trình dịch vụ bảo hành
        </p>
    </div>
    <div class="page-actions d-flex gap-2">
        <a href="/Admin/ExportProducts" class="btn-action-tool">
            <i class="bi bi-download"></i> Xuất dữ liệu sản phẩm (CSV)
        </a>
    </div>
</div>

<div class="admin-card p-3 shadow-sm border rounded-3 mb-4 bg-white">
    <div class="d-flex flex-wrap align-items-center gap-3 justify-content-start">
        
        <div class="d-flex flex-wrap gap-1 align-items-center">
            <span class="small fw-semibold text-dark me-1">
                <i class="bi bi-calendar-event me-1"></i>Khoảng thời gian:
            </span>
            <a href="/Admin/Reports?period=today" class="btn-action-tool @(Model.Period == "today" ? "active" : "")">
                Hôm nay
            </a>
            <a href="/Admin/Reports?period=7days" class="btn-action-tool @(Model.Period == "7days" ? "active" : "")">
                7 ngày qua
            </a>
            <a href="/Admin/Reports?period=month" class="btn-action-tool @(Model.Period == "month" ? "active" : "")">
                Tháng này
            </a>
        </div>

        <span class="text-muted d-none d-md-inline">|</span>

        
        <form method="get" action="/Admin/Reports" class="d-flex flex-wrap gap-2 align-items-center m-0">
            <input type="hidden" name="period" value="custom" />
            <span class="small text-dark">Từ ngày:</span>
            <input type="date" name="fromDate" class="form-control form-control-dark" style="width: 145px; height: 36px;" value="@Model.FromDate.ToString("yyyy-MM-dd")" />
            <span class="small text-dark">Đến ngày:</span>
            <input type="date" name="toDate" class="form-control form-control-dark" style="width: 145px; height: 36px;" value="@Model.ToDate.ToString("yyyy-MM-dd")" />
            <button type="submit" class="btn-action-tool">
                <i class="bi bi-funnel"></i> Lọc tùy chọn
            </button>
        </form>

        <span class="text-muted d-none d-md-inline">|</span>

        
        <a href="/Admin/Reports?period=today" class="btn-action-tool d-inline-flex align-items-center gap-1" title="Làm mới về thống kê ngày hôm nay">
            <i class="bi bi-arrow-clockwise"></i> Làm mới
        </a>
    </div>
    <div class="small text-muted mt-2 border-top pt-2">
        Đang hiển thị số liệu từ: <strong>@Model.FromDate.ToString("dd/MM/yyyy HH:mm")</strong> đến <strong>@Model.ToDate.ToString("dd/MM/yyyy HH:mm")</strong>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card p-3 shadow-sm border rounded-3 bg-white h-100">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="text-secondary small fw-medium">Đơn hàng mới tiếp nhận</span>
                <span class="badge bg-light text-dark border">Mới</span>
            </div>
            <div class="fs-4 fw-bold text-dark mb-1">@Model.NewOrders <span class="fs-6 fw-normal text-muted">/ @Model.TotalOrders tổng</span></div>
            <div class="small text-muted">Đang xử lý/giao: <strong>@Model.ProcessingOrders</strong> • Đã hủy: <strong>@Model.CancelledOrders</strong></div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card p-3 shadow-sm border rounded-3 bg-white h-100">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="text-secondary small fw-medium">Đơn hàng hoàn tất</span>
                <span class="badge bg-light text-dark border">Thành công</span>
            </div>
            <div class="fs-4 fw-bold text-dark mb-1">@Model.CompletedOrders đơn</div>
            <div class="small text-muted">Tổng doanh thu đơn: <strong>@FormatVND(Model.TotalCompletedRevenue)</strong></div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card p-3 shadow-sm border rounded-3 bg-white h-100">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="text-secondary small fw-medium">Dòng tiền thực thu</span>
                <span class="badge bg-light text-dark border">Tiền mặt & QR</span>
            </div>
            <div class="fs-4 fw-bold text-dark mb-1">@FormatVND(Model.ActualCashCollected)</div>
            <div class="small text-muted">Thu thực tế từ đơn mua đứt & trả góp</div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card p-3 shadow-sm border rounded-3 bg-white h-100">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="text-secondary small fw-medium">Dòng tiền Trả góp 0%</span>
                <span class="badge bg-light text-dark border">Hợp đồng</span>
            </div>
            <div class="fs-4 fw-bold text-dark mb-1">@FormatVND(Model.InstallmentCashCollected)</div>
            <div class="small text-muted">Gồm trả trước 30% và các kỳ đã thu</div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="card shadow-sm border rounded-3 bg-white p-3 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                <h6 class="fw-bold text-dark mb-0">
                    <i class="bi bi-bar-chart-fill text-dark me-2"></i>Doanh thu bán hàng theo thời gian (Triệu VNĐ)
                </h6>
                <span class="badge bg-light text-secondary border small">Thời gian thực</span>
            </div>
            <div style="height: 300px; position: relative;">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        
        <div class="card shadow-sm border rounded-3 bg-white p-3 h-100">
            <h6 class="fw-bold text-dark mb-3 border-bottom pb-2">
                <i class="bi bi-tools text-dark me-2"></i>Hiệu suất Dịch vụ & Bảo hành
            </h6>
            <div class="d-flex flex-column gap-3">
                <div class="p-2 px-3 rounded bg-light border">
                    <div class="small text-muted">Phiếu tiếp nhận trong kỳ</div>
                    <div class="fs-5 fw-bold text-dark">@Model.TotalReceivedTickets</div>
                </div>

                <div class="p-2 px-3 rounded bg-light border">
                    <div class="small text-muted">Phiếu hoàn tất / Đã bàn giao</div>
                    <div class="fs-5 fw-bold text-dark">@Model.HandedOverTickets</div>
                </div>

                <div class="p-2 px-3 rounded bg-light border">
                    <div class="small text-muted">Phiếu chờ duyệt báo giá</div>
                    <div class="fs-5 fw-bold text-dark">@Model.AwaitingQuoteTickets</div>
                </div>

                <div class="p-2 px-3 rounded bg-light border">
                    <div class="small text-muted">Thời gian xử lý trung bình</div>
                    <div class="fs-5 fw-bold text-dark">@(Model.AverageProcessingHours > 0 ? $"{Model.AverageProcessingHours} giờ" : "---")</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    
    <div class="col-12">
        <div class="card shadow-sm border rounded-3 bg-white p-3 h-100">
            <h6 class="fw-bold text-dark mb-3 border-bottom pb-2">
                <i class="bi bi-star-fill text-dark me-2"></i>Sản phẩm bán chạy nhất trong kỳ
            </h6>
            @if (Model.TopSellingProducts.Any())
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Sản phẩm / Cấu hình</th>
                                <th class="text-center">Số lượng bán</th>
                                <th class="text-end">Doanh số</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.TopSellingProducts)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold text-dark small">@p.ProductName</div>
                                        <div class="text-muted" style="font-size: 11px;">@p.VariantSpecs</div>
                                    </td>
                                    <td class="text-center fw-bold fs-6 text-dark">@p.QuantitySold</td>
                                    <td class="text-end small fw-bold text-dark">@FormatVND(p.TotalRevenue)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted small">
                    Chưa có đơn hàng phát sinh trong khoảng thời gian này.
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('revenueChart').getContext('2d');
        const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartLabels));
        const values = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartValues));

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Doanh thu (Triệu VNĐ)',
                    data: values,
                    backgroundColor: 'rgba(15, 23, 42, 0.85)',
                    hoverBackgroundColor: '#0f172a',
                    borderColor: '#0f172a',
                    borderWidth: 1,
                    borderRadius: 4,
                    maxBarThickness: 38
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return ' Doanh thu: ' + context.parsed.y + ' tr VNĐ';
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: {
                            color: '#475569',
                            font: { size: 12 }
                        }
                    },
                    y: {
                        beginAtZero: true,
                        grid: {
                            color: '#f1f5f9'
                        },
                        ticks: {
                            color: '#475569',
                            font: { size: 12 },
                            callback: function(value) { return value + ' tr'; }
                        }
                    }
                }
            }
        });
    </script>
}
