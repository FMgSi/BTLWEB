@model IEnumerable<LaptopStore.ViewModels.CustomerDto>
@{
    ViewData["Title"] = "Quản lý tài khoản";
    string currentStatus = ViewBag.Status ?? "all";
    string currentTier = ViewBag.Tier ?? "all";
    string currentSearch = ViewBag.Search ?? "";
}

<div class="page-header">
    <div>
        <h2 class="page-title">Quản lý tài khoản</h2>
        <p class="text-muted small mb-0">Theo dõi thông tin khách hàng, phân hạng thành viên và trạng thái tài khoản</p>
    </div>
    <div class="page-actions">
        <button class="btn-primary-custom" data-bs-toggle="modal" data-bs-target="#addCustomerModal">
            + Thêm khách hàng
        </button>
    </div>
</div>

<!-- LỰA CHỌN MỤC KHÁCH HÀNG HOẶC NHÂN VIÊN -->
<div class="d-flex align-items-center gap-2 mb-3">
    <a href="/Admin/Customers" class="btn btn-sm btn-dark text-white fw-bold shadow-sm" style="min-height: 36px; display: inline-flex; align-items: center; border-radius: 6px;">
        Khách hàng (@ViewBag.CustomerCount)
    </a>
    <a href="/Admin/Staff" class="btn btn-sm btn-light border text-dark" style="min-height: 36px; display: inline-flex; align-items: center; border-radius: 6px;">
        Nhân viên (@ViewBag.StaffCount)
    </a>
</div>

<!-- FILTER CARD -->
<div class="admin-card mb-3">
    <form method="get" action="/Admin/Customers" id="filterForm">
        <div class="row g-3 align-items-center">
            <!-- Search Input & Nút Làm Mới -->
            <div class="col-lg-4 col-md-12">
                <div class="d-flex align-items-center gap-2">
                    <div class="position-relative flex-grow-1">
                        <i class="bi bi-search position-absolute top-50 translate-middle-y text-muted" style="left: 12px;"></i>
                        <input type="text" name="search" id="searchInput" value="@currentSearch" class="form-control-dark ps-5" 
                               placeholder="Tìm kiếm khách hàng (Tên, SĐT, Email...)" onchange="this.form.submit()" />
                    </div>
                    <a href="/Admin/Customers" class="btn-action-tool d-inline-flex align-items-center gap-1 text-nowrap" title="Làm mới bộ lọc và danh sách">
                        <i class="bi bi-arrow-clockwise"></i> Làm mới
                    </a>
                </div>
            </div>

            <!-- Trạng thái hoạt động -->
            <div class="col-lg-4 col-md-6">
                <div class="d-flex align-items-center gap-2">
                    <span class="text-secondary small fw-semibold text-nowrap">Trạng thái:</span>
                    <input type="hidden" name="status" id="statusInput" value="@currentStatus" />
                    <div class="filter-btn-group">
                        <button type="button" class="filter-btn-item @(currentStatus == "all" ? "active" : "")" onclick="setStatus('all')">Tất cả</button>
                        <button type="button" class="filter-btn-item @(currentStatus == "active" ? "active" : "")" onclick="setStatus('active')">Hoạt động</button>
                        <button type="button" class="filter-btn-item @(currentStatus == "locked" ? "active" : "")" onclick="setStatus('locked')">Bị khóa</button>
                    </div>
                </div>
            </div>

            <!-- Hạng thành viên -->
            <div class="col-lg-4 col-md-6">
                <div class="d-flex align-items-center gap-2">
                    <span class="text-secondary small fw-semibold text-nowrap">Hạng thành viên:</span>
                    <input type="hidden" name="tier" id="tierInput" value="@currentTier" />
                    <div class="filter-btn-group">
                        <button type="button" class="filter-btn-item @(currentTier == "all" ? "active" : "")" onclick="setTier('all')">Tất cả</button>
                        <button type="button" class="filter-btn-item @(currentTier == "dong" || currentTier == "Đồng" ? "active" : "")" onclick="setTier('dong')">Đồng</button>
                        <button type="button" class="filter-btn-item @(currentTier == "bac" || currentTier == "Bạc" ? "active" : "")" onclick="setTier('bac')">Bạc</button>
                        <button type="button" class="filter-btn-item @(currentTier == "vang" || currentTier == "Vàng" ? "active" : "")" onclick="setTier('vang')">Vàng</button>
                        <button type="button" class="filter-btn-item @(currentTier == "kimcuong" || currentTier == "Kim cương" ? "active" : "")" onclick="setTier('kimcuong')">Kim cương</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- CUSTOMER TABLE CARD -->
<div class="admin-card">
    <div class="admin-card-header">
        <h5 class="card-title-text">
            Bảng dữ liệu khách hàng
        </h5>
        <span class="text-muted small">Cập nhật theo thời gian thực</span>
    </div>

    <div class="admin-table-container">
        <table class="admin-table">
            <thead>
                <tr>
                    <th style="width: 40px;"><input type="checkbox" class="custom-checkbox" /></th>
                    <th>Mã KH</th>
                    <th>Khách hàng</th>
                    <th>Số điện thoại</th>
                    <th>Email</th>
                    <th>Tổng đơn hàng</th>
                    <th>Tổng chi tiêu</th>
                    <th>Hạng</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr id="row-@c.CustomerCode">
                        <td><input type="checkbox" class="custom-checkbox" /></td>
                        <td class="fw-semibold text-dark">@c.CustomerCode</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 30px; height: 30px; font-size: 0.8rem; background: #0f172a; color: #ffffff;">
                                    @c.FullName.Substring(0, 1)
                                </div>
                                <span class="fw-semibold text-dark">@c.FullName</span>
                            </div>
                        </td>
                        <td class="text-secondary">@c.PhoneNumber</td>
                        <td class="text-secondary small">@c.Email</td>
                        <td class="text-dark">@c.TotalOrders đơn</td>
                        <td class="fw-bold text-dark">@string.Format("{0:N0}đ", c.TotalSpent)</td>
                        <td>
                            <span class="badge-status @c.TierBadgeClass">
                                @c.MembershipTier
                            </span>
                        </td>
                        <td>
                            <span class="badge-status @(c.IsActive ? "badge-in-stock" : "badge-out-of-stock")" id="status-badge-@c.CustomerCode">
                                @(c.IsActive ? "Hoạt động" : "Bị khóa")
                            </span>
                        </td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm @(c.IsActive ? "btn-action-delete" : "btn-action-edit")" 
                                    id="btn-lock-@c.CustomerCode" onclick="toggleLock('@c.CustomerCode')">
                                <i class="bi @(c.IsActive ? "bi-lock" : "bi-unlock")"></i>
                                <span id="btn-text-@c.CustomerCode">@(c.IsActive ? "Khóa" : "Mở khóa")</span>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- PAGINATION -->
    @if ((ViewBag.TotalPages ?? 1) > 1)
    {
        int curPage = ViewBag.CurrentPage ?? 1;
        int totPages = ViewBag.TotalPages ?? 1;
        int totCount = ViewBag.TotalCount ?? (Model != null ? Model.Count() : 0);

        var pagesToShow = new List<object>();
        if (totPages <= 7)
        {
            for (int i = 1; i <= totPages; i++) { pagesToShow.Add(i); }
        }
        else
        {
            if (curPage <= 4)
            {
                pagesToShow.AddRange(new object[] { 1, 2, 3, 4, 5, "...", totPages });
            }
            else if (curPage >= totPages - 3)
            {
                pagesToShow.AddRange(new object[] { 1, "...", totPages - 4, totPages - 3, totPages - 2, totPages - 1, totPages });
            }
            else
            {
                pagesToShow.AddRange(new object[] { 1, "...", curPage - 1, curPage, curPage + 1, "...", totPages });
            }
        }

        <div class="admin-pagination-wrap p-3 d-flex flex-wrap justify-content-between align-items-center border-top bg-white">
            <div class="pagination-info small text-muted">
                Trang <strong>@curPage</strong> / <strong>@totPages</strong> (Tổng số <strong>@totCount</strong> khách hàng)
            </div>
            <ul class="admin-pagination m-0 d-flex gap-1 list-unstyled align-items-center">
                <li class="admin-page-item @(curPage <= 1 ? "disabled" : "")">
                    <a href="@(curPage <= 1 ? "javascript:void(0)" : $"/Admin/Customers?page={curPage - 1}&search={ViewBag.Search}&status={ViewBag.Status}&tier={ViewBag.Tier}")" 
                       class="btn btn-sm btn-light border @(curPage <= 1 ? "disabled opacity-50" : "text-dark")"
                       title="Trang trước"
                       style="min-width: 34px; height: 34px; border-radius: 6px; display: inline-flex; align-items: center; justify-content: center;">
                        <i class="bi bi-chevron-left"></i> Trước
                    </a>
                </li>
                @foreach (var pageItem in pagesToShow)
                {
                    if (pageItem is string)
                    {
                        <li class="admin-page-item disabled">
                            <span class="d-inline-flex align-items-center justify-content-center text-muted px-1" style="min-width: 24px; height: 34px; font-weight: bold; user-select: none;">...</span>
                        </li>
                    }
                    else
                    {
                        int p = (int)pageItem;
                        <li class="admin-page-item">
                            <a href="/Admin/Customers?page=@p&search=@ViewBag.Search&status=@ViewBag.Status&tier=@ViewBag.Tier" 
                               class="btn btn-sm @(p == curPage ? "btn-dark text-white fw-bold shadow-sm" : "btn-light border text-dark")"
                               title="Trang @p"
                               style="min-width: 34px; height: 34px; border-radius: 6px; display: inline-flex; align-items: center; justify-content: center;">
                                @p
                            </a>
                        </li>
                    }
                }
                <li class="admin-page-item @(curPage >= totPages ? "disabled" : "")">
                    <a href="@(curPage >= totPages ? "javascript:void(0)" : $"/Admin/Customers?page={curPage + 1}&search={ViewBag.Search}&status={ViewBag.Status}&tier={ViewBag.Tier}")" 
                       class="btn btn-sm btn-light border @(curPage >= totPages ? "disabled opacity-50" : "text-dark")"
                       title="Trang tiếp theo"
                       style="min-width: 34px; height: 34px; border-radius: 6px; display: inline-flex; align-items: center; justify-content: center;">
                        Sau <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </div>
    }
    else
    {
        <div class="admin-pagination-wrap p-3 border-top bg-white">
            <div class="pagination-info small text-muted">
                Hiển thị @(Model.Any() ? 1 : 0)-@Model.Count() trong tổng số @ViewBag.TotalCount khách hàng
            </div>
        </div>
    }
</div>

<!-- FORM CHỨA CSRF TOKEN -->
<form id="antiForgeryForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<!-- MODAL THÊM KHÁCH HÀNG -->
<div class="modal fade" id="addCustomerModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background-color: var(--bg-card); border: 1px solid var(--border-color); color: #fff;">
            <div class="modal-header border-secondary">
                <h5 class="modal-title">Thêm khách hàng mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label-dark">Họ và tên *</label>
                    <input type="text" class="form-control-dark" placeholder="Nguyễn Văn B" />
                </div>
                <div class="mb-3">
                    <label class="form-label-dark">Số điện thoại *</label>
                    <input type="text" class="form-control-dark" placeholder="0912345678" />
                </div>
                <div class="mb-3">
                    <label class="form-label-dark">Địa chỉ Email *</label>
                    <input type="email" class="form-control-dark" placeholder="email@gmail.com" />
                </div>
                <div class="mb-3">
                    <label class="form-label-dark">Hạng thành viên</label>
                    <select class="form-select-dark">
                        <option>Đồng</option>
                        <option>Bạc</option>
                        <option>Vàng</option>
                        <option>Kim cương</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn-secondary-custom" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn-primary-custom" data-bs-dismiss="modal" onclick="alert('Đã thêm khách hàng thành công!')">Thêm mới</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function setStatus(val) {
            document.getElementById('statusInput').value = val;
            document.getElementById('filterForm').submit();
        }

        function setTier(val) {
            document.getElementById('tierInput').value = val;
            document.getElementById('filterForm').submit();
        }

        function toggleLock(code) {
            const token = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]')?.value 
                       || document.querySelector('input[name="__RequestVerificationToken"]')?.value 
                       || '';

            const formData = new URLSearchParams();
            formData.append('customerCode', code);
            if (token) {
                formData.append('__RequestVerificationToken', token);
            }

            fetch('/Admin/ToggleCustomerLock', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: formData.toString()
            })
            .then(res => {
                if (!res.ok) {
                    throw new Error(`Mã lỗi HTTP: ${res.status}`);
                }
                return res.json();
            })
            .then(data => {
                if (data.success) {
                    const badge = document.getElementById(`status-badge-${code}`);
                    const btn = document.getElementById(`btn-lock-${code}`);

                    if (data.isActive) {
                        if (badge) {
                            badge.className = 'badge-status badge-in-stock';
                            badge.innerText = 'Hoạt động';
                        }
                        if (btn) {
                            btn.className = 'btn btn-sm btn-action-delete';
                            btn.innerHTML = `<i class="bi bi-lock"></i> <span id="btn-text-${code}">Khóa</span>`;
                        }
                    } else {
                        if (badge) {
                            badge.className = 'badge-status badge-out-of-stock';
                            badge.innerText = 'Bị khóa';
                        }
                        if (btn) {
                            btn.className = 'btn btn-sm btn-action-edit';
                            btn.innerHTML = `<i class="bi bi-unlock"></i> <span id="btn-text-${code}">Mở khóa</span>`;
                        }
                    }
                } else {
                    alert(data.message || 'Thao tác không thành công');
                }
            })
            .catch(err => {
                console.error('Lỗi khi khóa/mở khóa tài khoản:', err);
                alert('Không thể thực hiện thao tác: ' + err.message);
            });
        }
    </script>
}
