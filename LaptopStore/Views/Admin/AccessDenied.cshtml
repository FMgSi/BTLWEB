@{
    Layout = null;
    ViewData["Title"] = "Từ chối truy cập (Access Denied)";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f1f5f9;
            color: #0f172a;
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .card-denied {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            max-width: 480px;
            width: 100%;
            padding: 40px 32px;
            text-align: center;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.06), 0 8px 10px -6px rgba(0, 0, 0, 0.04);
        }
        .icon-box {
            width: 68px;
            height: 68px;
            background: #fee2e2;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            font-size: 32px;
            color: #dc2626;
        }
    </style>
</head>
<body>
    <div class="card-denied">
        <div class="icon-box">
            <i class="bi bi-shield-x"></i>
        </div>
        <h2 class="fs-4 fw-bold text-dark mb-2">Quyền truy cập bị từ chối</h2>
        <p class="text-secondary small mb-4">
            Bạn cần đăng nhập với tài khoản có vai trò <strong>Nhân viên Quản trị (Admin)</strong> để thực hiện các thao tác quản trị trên hệ thống.
        </p>
        <div class="d-flex justify-content-center gap-3">
            <a href="/Admin/Login" class="btn btn-primary px-4 py-2 rounded-3 fw-semibold">
                <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập Admin
            </a>
            <a href="/Catalog" class="btn btn-outline-secondary px-4 py-2 rounded-3 fw-semibold">
                <i class="bi bi-shop me-1"></i> Về cửa hàng
            </a>
        </div>
    </div>
</body>
</html>
