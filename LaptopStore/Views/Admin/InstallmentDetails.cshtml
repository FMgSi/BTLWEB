@model LaptopStore.ViewModels.InstallmentContractDetailDto
@{
    ViewData["Title"] = $"Chi tiết hợp đồng #{Model.ContractCode}";
    var statusClass = Model.Status switch
    {
        "Đã tất toán" => "badge-paid",
        "Chờ trả trước" => "badge-low-stock",
        "Đang trả góp" => Model.OverduePeriodsCount > 0 ? "badge-out-of-stock" : "badge-processing",
        "Đã hủy" => "badge-out-of-stock",
        _ => "badge-in-stock"
    };
}

<div class="page-header">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <a href="/Admin/Installments" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Quay lại
            </a>
            <h2 class="page-title mb-0">Hợp đồng #@Model.ContractCode</h2>
            <span class="badge-status @statusClass">@Model.Status</span>
        </div>
        <p class="text-muted small mb-0">Đơn hàng liên kết: <a href="/Admin/Orders?search=@Model.OrderCode" class="fw-bold">#@Model.OrderCode</a> | Ngày tạo: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
    </div>
    <div class="page-actions">
        @if (Model.Status == "Chờ trả trước")
        {
            <button type="button" class="btn btn-success text-white fw-semibold" data-bs-toggle="modal" data-bs-target="#modal-activate">
                <i class="bi bi-shield-check me-1"></i> Xác nhận trả trước 30%
            </button>
        }
        else if (Model.NextPeriodToPay != null && Model.Status == "Đang trả góp")
        {
            <button type="button" class="btn btn-primary-custom" data-bs-toggle="modal" data-bs-target="#modal-collect-@Model.NextPeriodToPay.PeriodNumber">
                <i class="bi bi-cash-coin me-1"></i> Thu tiền kỳ @Model.NextPeriodToPay.PeriodNumber (@string.Format("{0:N0}đ", Model.NextPeriodToPay.Amount))
            </button>
        }
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show bg-success-subtle text-success border border-success mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show bg-danger-subtle text-danger border border-danger mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- THÔNG TIN TỔNG QUAN HỢP ĐỒNG -->
<div class="row g-4 mb-4">
    <!-- Cột 1: Thông tin khách hàng & Giao nhận -->
    <div class="col-lg-4">
        <div class="admin-card h-100 p-4">
            <h5 class="fs-6 fw-bold mb-3 border-bottom pb-2">
                <i class="bi bi-person-lines-fill text-primary me-2"></i> Thông tin khách hàng
            </h5>
            <div class="small mb-2">
                <div class="text-muted">Họ và tên:</div>
                <div class="fw-bold text-dark fs-6">@Model.CustomerName</div>
            </div>
            <div class="small mb-2">
                <div class="text-muted">Số điện thoại:</div>
                <div class="fw-semibold text-dark"><i class="bi bi-telephone text-primary me-1"></i>@Model.PhoneNumber</div>
            </div>
            <div class="small mb-3">
                <div class="text-muted">Địa chỉ nhận hàng:</div>
                <div class="text-dark"><i class="bi bi-geo-alt text-danger me-1"></i>@(Model.ShippingAddress ?? "Nhận tại cửa hàng")</div>
            </div>
            <div class="small">
                <div class="text-muted">Trạng thái đơn hàng:</div>
                <span class="badge bg-light text-dark border">@Model.OrderStatus</span>
            </div>
        </div>
    </div>

    <!-- Cột 2: Điều khoản trả góp & Tài chính -->
    <div class="col-lg-8">
        <div class="admin-card h-100 p-4">
            <h5 class="fs-6 fw-bold mb-3 border-bottom pb-2">
                <i class="bi bi-calculator-fill text-primary me-2"></i> Kế hoạch tài chính trả góp
            </h5>
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="p-3 bg-light rounded text-center">
                        <div class="text-muted small">Tổng giá trị đơn</div>
                        <div class="fs-5 fw-bold text-dark">@string.Format("{0:N0}đ", Model.TotalOrderAmount)</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 bg-light rounded text-center">
                        <div class="text-muted small">Trả trước (30%)</div>
                        <div class="fs-5 fw-bold text-primary">@string.Format("{0:N0}đ", Model.PrepayAmount)</div>
                        <span class="badge @(Model.PrepayStatus == "Đã thanh toán" ? "bg-success" : "bg-warning text-dark") small mt-1">@Model.PrepayStatus</span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 bg-light rounded text-center">
                        <div class="text-muted small">Thực tế đã thu</div>
                        <div class="fs-5 fw-bold text-success">@string.Format("{0:N0}đ", Model.TotalPaid)</div>
                        <small class="text-muted">@Model.PaidPeriodsCount/@Model.TermMonths kỳ</small>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 bg-light rounded text-center">
                        <div class="text-muted small">Dư nợ còn lại</div>
                        <div class="fs-5 fw-bold text-danger">@string.Format("{0:N0}đ", Model.RemainingDebt)</div>
                        <small class="text-muted">Lãi suất: 0%</small>
                    </div>
                </div>
            </div>

            <div class="row g-3 mt-1 small">
                <div class="col-md-4">
                    <span class="text-muted">Kỳ hạn trả góp:</span> <strong>@Model.TermMonths tháng (@Model.TermMonths kỳ)</strong>
                </div>
                <div class="col-md-4">
                    <span class="text-muted">Số tiền mỗi kỳ:</span> <strong>@string.Format("{0:N0}đ", Model.MonthlyInstallmentAmount)</strong>
                </div>
                <div class="col-md-4">
                    <span class="text-muted">Ngày kích hoạt:</span> <strong>@(Model.ActivatedAt.HasValue ? Model.ActivatedAt.Value.ToString("dd/MM/yyyy HH:mm") : "Chưa kích hoạt")</strong>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- BẢNG LỊCH CÁC KỲ TRẢ GÓP -->
<div class="admin-card mb-4">
    <div class="admin-card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title-text mb-0">
            <i class="bi bi-calendar3 text-primary me-2"></i> Lịch thanh toán các kỳ (@Model.Schedules.Count kỳ)
        </h5>
        @if (Model.Status == "Chờ trả trước")
        {
            <span class="badge bg-warning text-dark"><i class="bi bi-info-circle me-1"></i> Ngày đến hạn hiện là dự kiến (chốt chính thức ngay sau khi nhận tiền trả trước)</span>
        }
    </div>
    <div class="admin-table-container">
        <table class="admin-table">
            <thead>
                <tr>
                    <th style="width: 80px;">Kỳ số</th>
                    <th>Ngày đến hạn</th>
                    <th>Số tiền phải thu</th>
                    <th>Trạng thái</th>
                    <th>Ngày thu</th>
                    <th>Người xác nhận thu</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Schedules)
                {
                    var periodBadge = s.Status switch
                    {
                        "Đã thanh toán" => "badge-paid",
                        "Quá hạn" => "badge-out-of-stock",
                        _ => "badge-low-stock"
                    };

                    <tr class="@(s.IsCurrentDue ? "table-active border-primary border-2" : "")">
                        <td class="fw-bold fs-6 text-primary">#@s.PeriodNumber</td>
                        <td>
                            <div class="fw-semibold text-dark">@s.DueDate.ToString("dd/MM/yyyy")</div>
                            @if (Model.Status == "Chờ trả trước")
                            {
                                <small class="text-muted">(Dự kiến)</small>
                            }
                            else if (s.Status == "Quá hạn")
                            {
                                <small class="text-danger fw-bold"><i class="bi bi-exclamation-circle"></i> Đã quá hạn</small>
                            }
                        </td>
                        <td class="fw-bold text-dark fs-6">
                            @string.Format("{0:N0}đ", s.Amount)
                        </td>
                        <td>
                            <span class="badge-status @periodBadge">
                                @s.Status
                            </span>
                        </td>
                        <td>
                            @(s.PaidAt.HasValue ? s.PaidAt.Value.ToString("dd/MM/yyyy HH:mm") : "-")
                        </td>
                        <td>
                            @(string.IsNullOrEmpty(s.CollectedBy) ? "-" : s.CollectedBy)
                        </td>
                        <td class="text-end">
                            @if (s.Status != "Đã thanh toán")
                            {
                                if (Model.Status == "Đang trả góp" && s.IsCurrentDue)
                                {
                                    <button type="button" class="btn btn-sm btn-primary-custom" data-bs-toggle="modal" data-bs-target="#modal-collect-@s.PeriodNumber">
                                        <i class="bi bi-cash"></i> Thu tiền
                                    </button>
                                }
                                else if (Model.Status == "Chờ trả trước")
                                {
                                    <span class="text-muted small">Cần duyệt trả trước</span>
                                }
                                else
                                {
                                    <span class="text-muted small">Chờ kỳ trước</span>
                                }
                            }
                            else
                            {
                                @if (s.PaymentId.HasValue)
                                {
                                    <a href="/Admin/InstallmentReceipt/@s.PaymentId.Value" target="_blank" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-printer"></i> In phiếu thu
                                    </a>
                                }
                                else
                                {
                                    <span class="text-success small fw-semibold"><i class="bi bi-check-all"></i> Đã thu</span>
                                }
                            }
                        </td>
                    </tr>

                    <!-- MODAL THU TIỀN KỲ -->
                    @if (s.Status != "Đã thanh toán" && s.IsCurrentDue)
                    {
                        <div class="modal fade" id="modal-collect-@s.PeriodNumber" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content bg-white text-dark border-0 shadow-lg rounded-3">
                                    <div class="modal-header border-bottom bg-light">
                                        <h5 class="modal-title fs-6 fw-bold text-primary">
                                            <i class="bi bi-cash-stack me-2"></i>Thu tiền trả góp kỳ @s.PeriodNumber/@Model.TermMonths
                                        </h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <form method="post" asp-action="CollectInstallmentPeriod">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="contractId" value="@Model.ContractId" />
                                        <input type="hidden" name="periodNumber" value="@s.PeriodNumber" />
                                        <input type="hidden" name="returnUrl" value="/Admin/InstallmentDetails/@Model.ContractId" />
                                        <div class="modal-body text-start">
                                            <div class="p-3 rounded mb-3" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                                                <div class="small text-secondary mb-1">Khách hàng: <strong class="text-dark">@Model.CustomerName</strong> (@Model.PhoneNumber)</div>
                                                <div class="small text-secondary mb-1">Hợp đồng: <strong class="text-primary">#@Model.ContractCode</strong></div>
                                                <div class="small text-secondary mb-1">Hạn thanh toán: <strong class="text-dark">@s.DueDate.ToString("dd/MM/yyyy")</strong></div>
                                                <hr class="my-2" />
                                                <div class="fs-5 fw-bold text-success">
                                                    Số tiền thu kỳ @s.PeriodNumber: @string.Format("{0:N0}đ", s.Amount)
                                                </div>
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label small fw-semibold">Hình thức thu tiền *</label>
                                                <select name="paymentMethod" class="form-select form-control-dark">
                                                    <option value="Tiền mặt">Tiền mặt tại quầy / Nhân viên thu</option>
                                                    <option value="Chuyển khoản (VietQR)">Chuyển khoản VietQR / Ngân hàng</option>
                                                    <option value="Thẻ POS">Quẹt thẻ ngân hàng (POS)</option>
                                                </select>
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label small fw-semibold">Mã chuẩn chi / Mã giao dịch ngân hàng</label>
                                                <input type="text" name="transactionRef" class="form-control form-control-dark" placeholder="VD: MB123456789..." />
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label small fw-semibold">Ghi chú biên nhận</label>
                                                <input type="text" name="note" class="form-control form-control-dark" placeholder="Ghi chú người nộp tiền, chi nhánh thu..." />
                                            </div>
                                        </div>
                                        <div class="modal-footer border-top bg-light">
                                            <button type="button" class="btn-secondary-custom" data-bs-dismiss="modal">Đóng</button>
                                            <button type="submit" class="btn-primary-custom">
                                                <i class="bi bi-check-circle-fill"></i> Xác nhận đã thu @string.Format("{0:N0}đ", s.Amount)
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- LỊCH SỬ CÁC LẦN THU TIỀN VÀ BIÊN NHẬN -->
<div class="admin-card">
    <div class="admin-card-header">
        <h5 class="card-title-text mb-0">
            <i class="bi bi-receipt-cutoff text-primary me-2"></i> Lịch sử tất cả giao dịch thực thu (@Model.Payments.Count giao dịch)
        </h5>
    </div>
    <div class="admin-table-container">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Mã GD</th>
                    <th>Phân loại</th>
                    <th>Số tiền</th>
                    <th>Phương thức</th>
                    <th>Người xác nhận</th>
                    <th>Mã tham chiếu</th>
                    <th>Thời điểm thu</th>
                    <th>Ghi chú</th>
                    <th class="text-end">Phiếu thu</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Payments.Any())
                {
                    foreach (var p in Model.Payments)
                    {
                        var typeName = p.PaymentType switch
                        {
                            "Prepay" => "Trả trước 30%",
                            "InstallmentPeriod" => "Thu kỳ trả góp",
                            _ => "Thanh toán toàn bộ"
                        };

                        <tr>
                            <td class="fw-bold">#PAY-@p.PaymentId</td>
                            <td><span class="badge bg-primary-subtle text-primary border">@typeName</span></td>
                            <td class="fw-bold text-success">@string.Format("{0:N0}đ", p.Amount)</td>
                            <td>@p.PaymentMethod</td>
                            <td>@(string.IsNullOrEmpty(p.ConfirmedBy) ? "-" : p.ConfirmedBy)</td>
                            <td><code>@(p.TransactionReference ?? "-")</code></td>
                            <td class="small text-muted">@p.PaymentDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="small text-secondary">@p.Note</td>
                            <td class="text-end">
                                <a href="/Admin/InstallmentReceipt/@p.PaymentId" target="_blank" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-printer"></i> In
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">
                            Chưa có giao dịch thực thu nào được xác nhận thành công.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- MODAL DUYỆT TIỀN TRẢ TRƯỚC 30% TỪ TRANG CHI TIẾT -->
@if (Model.Status == "Chờ trả trước")
{
    <div class="modal fade" id="modal-activate" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-white text-dark border-0 shadow-lg rounded-3">
                <div class="modal-header border-bottom bg-light">
                    <h5 class="modal-title fs-6 fw-bold text-success">
                        <i class="bi bi-shield-check me-2"></i>Xác nhận khoản trả trước 30%
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form method="post" asp-action="ActivateInstallment">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="contractId" value="@Model.ContractId" />
                    <input type="hidden" name="returnUrl" value="/Admin/InstallmentDetails/@Model.ContractId" />
                    <div class="modal-body text-start">
                        <div class="p-3 rounded mb-3" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                            <div class="small text-secondary mb-1">Khách hàng: <strong class="text-dark">@Model.CustomerName</strong> (@Model.PhoneNumber)</div>
                            <div class="small text-secondary mb-1">Tổng tiền đơn: <strong>@string.Format("{0:N0}đ", Model.TotalOrderAmount)</strong></div>
                            <hr class="my-2" />
                            <div class="fs-6 fw-bold text-success">
                                Số tiền trả trước cần thu: @string.Format("{0:N0}đ", Model.PrepayAmount) (30%)
                            </div>
                            <div class="text-muted small mt-1">Hệ thống sẽ kích hoạt hợp đồng và chốt chính xác ngày đến hạn cho @Model.TermMonths kỳ trả góp.</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Hình thức nhận tiền *</label>
                            <select name="paymentMethod" class="form-select form-control-dark">
                                <option value="Chuyển khoản (VietQR)">Chuyển khoản VietQR / Ngân hàng</option>
                                <option value="Tiền mặt">Tiền mặt tại quầy / Shipper thu</option>
                                <option value="Thẻ POS">Quẹt thẻ ngân hàng (POS)</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Mã giao dịch / Mã chuẩn chi</label>
                            <input type="text" name="transactionRef" class="form-control form-control-dark" placeholder="VD: MB987654321..." />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Ghi chú xác nhận</label>
                            <input type="text" name="note" class="form-control form-control-dark" placeholder="Ghi chú xác nhận..." />
                        </div>
                    </div>
                    <div class="modal-footer border-top bg-light">
                        <button type="button" class="btn-secondary-custom" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="btn btn-success text-white fw-semibold">
                            <i class="bi bi-check2-circle"></i> Xác nhận & Kích hoạt hợp đồng
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
