@model LaptopStore.ViewModels.ServiceStorefrontViewModel
@using System.Globalization
@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Dịch vụ Sửa chữa & Bảo hành Chính hãng";
    var viCulture = CultureInfo.GetCultureInfo("vi-VN");
    string FormatVND(decimal amount) => amount.ToString("#,##0", viCulture) + " ₫";
}

<div class="container py-4">
    
    <div class="bg-white rounded-3 shadow-sm p-4 mb-4 border">
        <div class="row align-items-center g-3">
            <div class="col-lg-8">
                <span class="badge bg-danger-subtle text-danger px-3 py-2 fw-bold text-uppercase mb-2">
                    <i class="bi bi-shield-check me-1"></i> Trung tâm Chăm sóc & Dịch vụ Khách hàng
                </span>
                <h2 class="fw-bold text-dark mb-1">Dịch vụ Sửa chữa & Bảo hành Chính hãng</h2>
                <p class="text-secondary small mb-0">
                    Quy trình tiếp nhận chuẩn hóa 7 bước, minh bạch báo giá linh kiện và hỗ trợ đổi mới theo tiêu chuẩn nhà sản xuất.
                </p>
            </div>
            <div class="col-lg-4 text-lg-end">
                <div class="d-inline-flex flex-column gap-1 bg-light p-3 rounded-3 border text-start">
                    <div class="small text-muted"><i class="bi bi-telephone-inbound-fill text-danger me-1"></i> Hotline kỹ thuật 24/7:</div>
                    <div class="fs-5 fw-bold text-danger">1800 1234 (Nhánh 2)</div>
                    <div class="small text-secondary">8:00 - 21:30 (Cả T7 & Chủ nhật)</div>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    
    <div class="d-flex flex-wrap gap-2 mb-4 bg-white p-2 rounded-3 shadow-sm border">
        <a href="/service?tab=request" class="btn btn-sm px-4 py-2 fw-bold rounded-2 @(Model.ActiveTab == "request" ? "btn-danger text-white" : "btn-light text-secondary")">
            <i class="bi bi-send-plus me-1"></i> 1. Gửi yêu cầu tiếp nhận
        </a>
        <a href="/service?tab=lookup" class="btn btn-sm px-4 py-2 fw-bold rounded-2 @(Model.ActiveTab == "lookup" ? "btn-danger text-white" : "btn-light text-secondary")">
            <i class="bi bi-search me-1"></i> 2. Theo dõi tiến độ phiếu
        </a>
        <a href="/service?tab=catalog" class="btn btn-sm px-4 py-2 fw-bold rounded-2 @(Model.ActiveTab == "catalog" ? "btn-danger text-white" : "btn-light text-secondary")">
            <i class="bi bi-list-task me-1"></i> 3. Bảng giá dịch vụ tham khảo
        </a>
        <a href="/service?tab=my-devices" class="btn btn-sm px-4 py-2 fw-bold rounded-2 @(Model.ActiveTab == "my-devices" ? "btn-danger text-white" : "btn-light text-secondary")">
            <i class="bi bi-laptop me-1"></i> 4. Máy đã mua & Hạn BH (@Model.MyDevices.Count)
        </a>
    </div>

    
    @if (Model.ActiveTab == "request")
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="bg-white rounded-3 p-4 shadow-sm border">
                    <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                        <i class="bi bi-clipboard2-check text-danger me-2"></i>Đăng ký phiếu tiếp nhận máy trực tuyến
                    </h5>

                    
                    <ul class="nav nav-pills mb-3 gap-2" id="requestTypeTab" role="tablist">
                        <li class="nav-item">
                            <button class="nav-link active fw-bold btn-sm" id="warranty-tab" data-bs-toggle="pill" data-bs-target="#warranty-content" type="button">
                                🛡️ Bảo hành chính hãng (0 ₫ - Máy đã mua)
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link fw-bold btn-sm" id="repair-tab" data-bs-toggle="pill" data-bs-target="#repair-content" type="button">
                                🔧 Sửa chữa dịch vụ (Có phí - Máy ngoài hoặc máy đã mua)
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content" id="requestTypeContent">
                        
                        <div class="tab-pane fade show active" id="warranty-content">
                            <form asp-controller="Service" asp-action="SubmitWarranty" method="post">
                                @Html.AntiForgeryToken()
                                <div class="mb-3">
                                    <label class="form-label small fw-bold">Chọn máy đã mua cần bảo hành <span class="text-danger">*</span></label>
                                    @if (Model.MyDevices.Any())
                                    {
                                        <select name="SoldDeviceId" class="form-select form-select-sm" required>
                                            <option value="">-- Chọn thiết bị trong danh sách đã mua --</option>
                                            @foreach (var d in Model.MyDevices)
                                            {
                                                <option value="@d.DeviceId" selected="@(Model.PreSelectedDeviceId == d.DeviceId)">
                                                    @d.ProductName (Serial: @d.SerialNumber) - @(d.IsUnderWarranty ? $"Còn BH đến {d.WarrantyEndDate:dd/MM/yyyy}" : "Hết hạn BH")
                                                </option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        <div class="alert alert-warning py-2 px-3 small mb-2">
                                            Chưa tìm thấy máy đã mua trong phiên hiện tại. Vui lòng đăng nhập hoặc nhập số điện thoại để hệ thống tải danh sách máy của bạn.
                                        </div>
                                    }
                                </div>

                                <div class="row g-2 mb-3">
                                    <div class="col-sm-6">
                                        <label class="form-label small fw-bold">Họ và tên khách hàng <span class="text-danger">*</span></label>
                                        <input type="text" name="CustomerName" class="form-control form-control-sm" required placeholder="Nguyễn Văn A" />
                                    </div>
                                    <div class="col-sm-6">
                                        <label class="form-label small fw-bold">Số điện thoại liên hệ <span class="text-danger">*</span></label>
                                        <input type="tel" name="PhoneNumber" class="form-control form-control-sm" required placeholder="0987654321" />
                                    </div>
                                    <div class="col-sm-6">
                                        <label class="form-label small">Email nhận thông báo</label>
                                        <input type="email" name="Email" class="form-control form-control-sm" placeholder="email@example.com" />
                                    </div>
                                    <div class="col-sm-6">
                                        <label class="form-label small">Địa chỉ nhận trả máy (nếu giao tận nơi)</label>
                                        <input type="text" name="Address" class="form-control form-control-sm" placeholder="Số nhà, tên đường, quận/huyện" />
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small fw-bold">Mô tả triệu chứng / Lỗi gặp phải <span class="text-danger">*</span></label>
                                    <textarea name="FaultDescription" class="form-control form-control-sm" rows="3" required placeholder="Ví dụ: Máy bật không lên nguồn, quạt kêu to, màn hình bị chớp giật..."></textarea>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small">Phụ kiện mang kèm (sạc, túi, chuột...)</label>
                                    <input type="text" name="Accessories" class="form-control form-control-sm" placeholder="Củ sạc zin 65W, chuột không dây..." />
                                </div>

                                <div class="text-end border-top pt-3">
                                    <button type="submit" class="btn btn-danger px-4 fw-bold">
                                        <i class="bi bi-send-check me-1"></i> Gửi yêu cầu bảo hành (0 ₫)
                                    </button>
                                </div>
                            </form>
                        </div>

                        
                        <div class="tab-pane fade" id="repair-content">
                            <form asp-controller="Service" asp-action="SubmitRepair" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="DeviceSource" value="External" />
                                <div class="row g-2 mb-3">
                                    <div class="col-sm-6 position-relative">
                                        <label class="form-label small fw-bold">Dòng máy / Model laptop <span class="text-danger">*</span></label>
                                        <input type="text" name="ExternalDeviceModel" id="externalDeviceModelMvc" list="laptopModelSuggestions" class="form-control form-control-sm" required placeholder="Gõ để tìm (VD: Dell XPS 13, ASUS ROG...)" autocomplete="off" />
                                        <datalist id="laptopModelSuggestions">
                                            <option value="Dell XPS 13 9310">Dell XPS 13 - Mỏng nhẹ cao cấp</option>
                                            <option value="Dell Inspiron 15 3520">Dell Inspiron - Văn phòng học tập</option>
                                            <option value="ASUS ROG Strix G15">ASUS ROG Strix - Gaming hiệu năng cao</option>
                                            <option value="ASUS Zenbook 14 OLED">ASUS Zenbook - Màn hình OLED chuẩn đồ họa</option>
                                            <option value="MacBook Pro 14 M2">Apple MacBook Pro 14 - Apple Silicon</option>
                                            <option value="MacBook Air M2 13.6">Apple MacBook Air M2 - Siêu mỏng nhẹ</option>
                                            <option value="Lenovo Legion 5 15IAH7">Lenovo Legion 5 - Gaming tản nhiệt tốt</option>
                                            <option value="Lenovo ThinkPad X1 Carbon">Lenovo ThinkPad X1 Carbon - Doanh nhân</option>
                                            <option value="HP Envy 13 ba1030TU">HP Envy 13 - Kim loại nguyên khối</option>
                                        </datalist>
                                    </div>
                                    <div class="col-sm-6">
                                        <label class="form-label small">Số Serial / Service Tag (nếu có)</label>
                                        <input type="text" name="ExternalSerialNumber" class="form-control form-control-sm font-monospace" placeholder="VD: 8FC4K23" />
                                    </div>
                                </div>

                                <div class="row g-2 mb-3">
                                    <div class="col-sm-6">
                                        <label class="form-label small fw-bold">Họ và tên khách hàng <span class="text-danger">*</span></label>
                                        <input type="text" name="CustomerName" class="form-control form-control-sm" required placeholder="Nguyễn Văn A" />
                                    </div>
                                    <div class="col-sm-6">
                                        <label class="form-label small fw-bold">Số điện thoại liên hệ <span class="text-danger">*</span></label>
                                        <input type="tel" name="PhoneNumber" class="form-control form-control-sm" required placeholder="0987654321" />
                                    </div>
                                    <div class="col-sm-6">
                                        <label class="form-label small">Email nhận thông báo</label>
                                        <input type="email" name="Email" class="form-control form-control-sm" placeholder="email@example.com" />
                                    </div>
                                    <div class="col-sm-6">
                                        <label class="form-label small">Địa chỉ trả máy</label>
                                        <input type="text" name="Address" class="form-control form-control-sm" placeholder="Số nhà, tên đường, quận/huyện" />
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small fw-bold">Mô tả tình trạng hỏng hóc & Yêu cầu sửa chữa <span class="text-danger">*</span></label>
                                    <textarea name="FaultDescription" class="form-control form-control-sm" rows="3" required placeholder="Mô tả chi tiết để kỹ thuật viên chuẩn bị sẵn linh kiện phù hợp..."></textarea>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small">Phụ kiện mang kèm</label>
                                    <input type="text" name="Accessories" class="form-control form-control-sm" placeholder="Củ sạc, hộp đựng..." />
                                </div>

                                <div class="text-end border-top pt-3">
                                    <button type="submit" class="btn btn-danger px-4 fw-bold">
                                        <i class="bi bi-wrench me-1"></i> Gửi yêu cầu sửa chữa
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            
            <div class="col-lg-4">
                <div class="bg-white rounded-3 p-3 shadow-sm border mb-3">
                    <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">
                        <i class="bi bi-info-circle text-danger me-2"></i>Quy trình 7 bước tiếp nhận & xử lý
                    </h6>
                    <div class="small text-secondary">
                        <div class="mb-2"><span class="badge bg-danger rounded-circle p-1 me-1">1</span> <strong>Chờ tiếp nhận:</strong> Đăng ký online nhận mã phiếu.</div>
                        <div class="mb-2"><span class="badge bg-danger rounded-circle p-1 me-1">2</span> <strong>Đã tiếp nhận:</strong> Bàn giao máy tại quầy, in biên nhận.</div>
                        <div class="mb-2"><span class="badge bg-danger rounded-circle p-1 me-1">3</span> <strong>Đang kiểm tra:</strong> Kỹ thuật kiểm tra linh kiện và phần cứng.</div>
                        <div class="mb-2"><span class="badge bg-danger rounded-circle p-1 me-1">4</span> <strong>Chờ duyệt báo giá:</strong> Nếu có chi phí, khách duyệt trực tuyến.</div>
                        <div class="mb-2"><span class="badge bg-danger rounded-circle p-1 me-1">5</span> <strong>Đang xử lý:</strong> Tiến hành thay thế hoặc bảo hành.</div>
                        <div class="mb-2"><span class="badge bg-danger rounded-circle p-1 me-1">6</span> <strong>Chờ trả máy:</strong> Máy test hoàn tất, thông báo khách.</div>
                        <div><span class="badge bg-success rounded-circle p-1 me-1">7</span> <strong>Đã bàn giao:</strong> Bàn giao máy và cấp tem bảo hành.</div>
                    </div>
                </div>
                <div class="bg-white rounded-3 p-3 shadow-sm border">
                    <h6 class="fw-bold text-dark border-bottom pb-2 mb-2">
                        <i class="bi bi-geo-alt text-danger me-2"></i>Địa điểm tiếp nhận máy
                    </h6>
                    <div class="small text-secondary">
                        <div class="fw-semibold text-dark">Trung tâm Hà Nội:</div>
                        <div class="mb-2">123 Đường Cầu Giấy, Q. Cầu Giấy, Hà Nội</div>
                        <div class="fw-semibold text-dark">Hotline hỗ trợ:</div>
                        <div>1900 8888 (Nhánh kỹ thuật)</div>
                    </div>
                </div>
            </div>
        </div>
    }

    
    @if (Model.ActiveTab == "lookup")
    {
        <div class="row justify-content-center">
            <div class="col-lg-9">
                
                <div class="bg-white rounded-3 p-4 shadow-sm border mb-4">
                    <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                        <i class="bi bi-search text-danger me-2"></i>Tra cứu tiến độ & Duyệt báo giá trực tuyến
                    </h5>
                    <form method="get" action="/service" class="row g-2">
                        <input type="hidden" name="tab" value="lookup" />
                        <div class="col-md-5">
                            <label class="form-label small fw-semibold text-secondary">Mã phiếu tiếp nhận <span class="text-danger">*</span></label>
                            <input type="text" name="code" class="form-control form-control-sm font-monospace" required placeholder="VD: BH-20261101-0001" value="@Model.LookupCode" />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label small fw-semibold text-secondary">Số điện thoại xác thực</label>
                            <input type="tel" name="phone" class="form-control form-control-sm" placeholder="Số điện thoại khi đăng ký phiếu" value="@Model.LookupPhone" />
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="submit" class="btn btn-danger btn-sm w-100 fw-bold">
                                Tra cứu
                            </button>
                        </div>
                    </form>

                    @if (!string.IsNullOrEmpty(Model.LookupError))
                    {
                        <div class="alert alert-danger py-2 px-3 small mt-3 mb-0">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> @Model.LookupError
                        </div>
                    }
                </div>

                
                @if (Model.LookupResult != null)
                {
                    var t = Model.LookupResult;
                    <div class="bg-white rounded-3 p-4 shadow-sm border">
                        <div class="d-flex flex-wrap justify-content-between align-items-center border-bottom pb-3 mb-3">
                            <div>
                                <span class="badge bg-light text-primary font-monospace fs-6 me-2 border">#@t.TicketCode</span>
                                <span class="badge @(t.TicketType == "Bảo hành" ? "bg-success" : "bg-warning text-dark") fs-6">@t.TicketType</span>
                            </div>
                            <div class="text-end">
                                <div class="small text-muted">Trạng thái hiện tại:</div>
                                <span class="badge bg-primary fs-6 mt-1">@t.Status</span>
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <div class="p-3 bg-light rounded border small">
                                    <div class="text-muted">Thiết bị:</div>
                                    <div class="fw-bold fs-6 text-dark">@t.DeviceDisplayName</div>
                                    <div class="font-monospace text-primary">Serial: @t.SerialNumber</div>
                                    <div class="mt-2 text-muted">Mô tả lỗi:</div>
                                    <div class="text-dark">@t.FaultDescription</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 bg-light rounded border small">
                                    <div class="text-muted">Khách hàng:</div>
                                    <div class="fw-bold text-dark">@t.CustomerName</div>
                                    <div class="text-muted">SĐT: @t.PhoneNumber</div>
                                    <div class="mt-2 text-muted">Tổng chi phí dự kiến:</div>
                                    <div class="fs-5 fw-bold text-danger">@(t.TicketType == "Bảo hành" && t.FinalCost == 0 ? "0 ₫ (Bảo hành)" : FormatVND(t.FinalCost))</div>
                                </div>
                            </div>
                        </div>

                        
                        @if (t.Quotes != null && t.Quotes.Any())
                        {
                            <div class="card border-warning mb-4 shadow-sm">
                                <div class="card-header bg-warning-subtle fw-bold text-dark">
                                    <i class="bi bi-tag-fill me-1 text-warning-emphasis"></i> Báo giá chi phí linh kiện & sửa chữa
                                </div>
                                <div class="card-body p-3">
                                    @foreach (var q in t.Quotes)
                                    {
                                        <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 pb-2 border-bottom">
                                            <div>
                                                <div class="fw-bold text-dark">@q.Description</div>
                                                <div class="small text-muted">Thời gian báo: @q.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                            </div>
                                            <div class="text-end">
                                                <div class="fs-5 fw-bold text-danger">@FormatVND(q.Amount)</div>
                                                <div>
                                                    <span class="badge @(q.CustomerDecision == "Đồng ý" ? "bg-success" : q.CustomerDecision == "Từ chối" ? "bg-danger" : "bg-warning text-dark")">
                                                        @q.CustomerDecision
                                                    </span>
                                                </div>
                                            </div>
                                        </div>

                                        @if (q.CustomerDecision == "Chờ duyệt")
                                        {
                                            <form asp-controller="Service" asp-action="SubmitQuoteDecision" method="post" class="mt-3 text-end d-flex justify-content-end gap-2">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="quoteId" value="@q.QuoteId" />
                                                <input type="hidden" name="ticketCode" value="@t.TicketCode" />
                                                <input type="hidden" name="phone" value="@Model.LookupPhone" />
                                                <button type="submit" name="decision" value="Từ chối" class="btn btn-outline-secondary btn-sm fw-bold">
                                                    Từ chối báo giá
                                                </button>
                                                <button type="submit" name="decision" value="Đồng ý" class="btn btn-danger btn-sm fw-bold">
                                                    Đồng ý & Tiến hành sửa chữa
                                                </button>
                                            </form>
                                        }
                                    }
                                </div>
                            </div>
                        }

                        
                        @if (t.Histories != null && t.Histories.Any())
                        {
                            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-clock-history text-danger me-1"></i> Nhật ký xử lý thiết bị</h6>
                            <div class="timeline ps-2 border-start border-2 ms-2">
                                @foreach (var h in t.Histories)
                                {
                                    <div class="mb-3 position-relative ps-3">
                                        <span class="position-absolute start-0 top-0 translate-middle p-1 bg-danger border border-light rounded-circle"></span>
                                        <div class="small fw-bold text-dark">@h.Action: <span class="text-primary">@h.NewStatus</span></div>
                                        <div class="small text-secondary">@h.Notes</div>
                                        <div class="small text-muted" style="font-size: 11px;">@h.CreatedAt.ToString("dd/MM/yyyy HH:mm") • Bởi: @h.StaffName</div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    
    @if (Model.ActiveTab == "catalog")
    {
        <div class="row g-3">
            @foreach (var s in Model.Catalog)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border rounded-3 p-3 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-light text-primary font-monospace border">@s.ServiceCode</span>
                                <span class="badge @(s.ServiceType == "Bảo hành" ? "bg-success-subtle text-success border" : "bg-warning-subtle text-warning-emphasis border") small">
                                    @s.ServiceType
                                </span>
                            </div>
                            <h6 class="fw-bold text-dark mb-2">@s.ServiceName</h6>
                            <p class="text-secondary small mb-3">@s.ApplicableConditions</p>
                        </div>
                        <div class="border-top pt-2 mt-auto">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div>
                                    <div class="small text-muted" style="font-size: 11px;">Chi phí tham khảo:</div>
                                    <div class="fw-bold fs-6 text-danger">@(s.ServiceType == "Bảo hành" ? "0 ₫" : FormatVND(s.EstimatedCost))</div>
                                </div>
                                <div class="text-end">
                                    <div class="small text-muted" style="font-size: 11px;">Dự kiến:</div>
                                    <div class="small fw-semibold text-dark">@s.EstimatedTime</div>
                                </div>
                            </div>
                            <a href="/service?tab=request" class="btn btn-outline-danger btn-sm w-100 fw-semibold">
                                Đăng ký dịch vụ này
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    
    @if (Model.ActiveTab == "my-devices")
    {
        @if (Model.MyDevices.Any())
        {
            <div class="row g-3">
                @foreach (var d in Model.MyDevices)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm border rounded-3 p-3 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <span class="badge bg-light text-dark border font-monospace">Đơn: #@d.OrderCode</span>
                                    <span class="badge @(d.IsUnderWarranty ? "bg-success" : "bg-secondary")">
                                        @(d.IsUnderWarranty ? $"Còn BH ({d.DaysRemaining} ngày)" : "Hết hạn BH")
                                    </span>
                                </div>
                                <h6 class="fw-bold text-dark mb-1">@d.ProductName</h6>
                                <div class="small text-muted mb-2">Serial: <strong class="text-primary font-monospace">@d.SerialNumber</strong></div>
                                <div class="small text-secondary mb-2">Hạn BH: @d.WarrantyEndDate.ToString("dd/MM/yyyy")</div>
                            </div>
                            <div>
                                <a href="/service?tab=request&deviceId=@d.DeviceId" class="btn btn-danger btn-sm w-100 fw-semibold">
                                    Yêu cầu bảo hành / Sửa chữa
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="bg-white rounded-3 p-5 text-center border shadow-sm">
                <i class="bi bi-laptop text-muted fs-1 d-block mb-2"></i>
                <h6 class="fw-bold text-dark">Chưa có thiết bị nào được ghi nhận</h6>
                <p class="text-muted small mb-0">Khi đơn hàng giao thành công và nhân viên kích hoạt số Serial, máy sẽ hiển thị tại đây.</p>
            </div>
        }
    }
</div>
