<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LAPTOP WORLD ADMIN</title>

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Admin Modern Theme -->
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    @{
        var currentCtrl = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "").ToLower();
        var currentAction = (ViewContext.RouteData.Values["action"]?.ToString() ?? "").ToLower();
    }

    <div class="admin-layout">
        <!-- ==================== SIDEBAR ==================== -->
        <aside class="admin-sidebar" id="adminSidebar">
            <!-- Sidebar Header / Logo -->
            <div class="sidebar-header">
                <div class="brand-icon-box">
                    <i class="bi bi-laptop"></i>
                </div>
                <div class="brand-title-wrap">
                    <span class="brand-title">LAPTOP WORLD</span>
                    <span class="brand-subtitle">NHÂN VIÊN QUẢN TRỊ</span>
                </div>
            </div>

            <!-- Navigation Links -->
            <nav class="sidebar-nav">
                <!-- Quản lý sản phẩm -->
                <div>
                    <a href="/Product" class="nav-link-custom d-flex justify-content-between align-items-center @(currentCtrl == "product" ? "active" : "")">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-laptop"></i>
                            <span>Quản lý sản phẩm</span>
                        </div>
                        <i class="bi bi-chevron-down small" style="font-size: 0.75rem;"></i>
                    </a>
                    <div class="sidebar-submenu">
                        <a href="/Product" class="@(currentCtrl == "product" && currentAction == "index" ? "active" : "")">
                            <i class="bi bi-dot"></i> Danh sách laptop
                        </a>
                        <a href="/Product/Create" class="@(currentCtrl == "product" && currentAction == "create" ? "active" : "")">
                            <i class="bi bi-dot"></i> Thêm laptop mới
                        </a>
                    </div>
                </div>

                <!-- Quản lý Thể loại / Danh mục (Categories) -->
                <div>
                    <a href="/Categories" class="nav-link-custom d-flex justify-content-between align-items-center @(currentCtrl == "categories" ? "active" : "")">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-tags-fill"></i>
                            <span>Thể loại / Danh mục</span>
                        </div>
                        <i class="bi bi-chevron-down small" style="font-size: 0.75rem;"></i>
                    </a>
                    <div class="sidebar-submenu">
                        <a href="/Categories" class="@(currentCtrl == "categories" && currentAction == "index" ? "active" : "")">
                            <i class="bi bi-dot"></i> Danh sách thể loại
                        </a>
                        <a href="/Categories/Create" class="@(currentCtrl == "categories" && currentAction == "create" ? "active" : "")">
                            <i class="bi bi-dot"></i> Thêm thể loại mới
                        </a>
                    </div>
                </div>

                <!-- Quản lý Thương hiệu / Hãng (Brands) -->
                <div>
                    <a href="/Brands" class="nav-link-custom d-flex justify-content-between align-items-center @(currentCtrl == "brands" ? "active" : "")">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-buildings-fill"></i>
                            <span>Thương hiệu / Hãng</span>
                        </div>
                        <i class="bi bi-chevron-down small" style="font-size: 0.75rem;"></i>
                    </a>
                    <div class="sidebar-submenu">
                        <a href="/Brands" class="@(currentCtrl == "brands" && currentAction == "index" ? "active" : "")">
                            <i class="bi bi-dot"></i> Danh sách thương hiệu
                        </a>
                        <a href="/Brands/Create" class="@(currentCtrl == "brands" && currentAction == "create" ? "active" : "")">
                            <i class="bi bi-dot"></i> Thêm thương hiệu mới
                        </a>
                    </div>
                </div>

                <!-- Quản lý Bảng Màu (Colors) - LapTrinhWeb -->
                <div>
                    <a href="/Colors" class="nav-link-custom d-flex justify-content-between align-items-center @(currentCtrl == "colors" ? "active" : "")">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-palette-fill"></i>
                            <span>Bảng màu sản phẩm</span>
                        </div>
                        <i class="bi bi-chevron-down small" style="font-size: 0.75rem;"></i>
                    </a>
                    <div class="sidebar-submenu">
                        <a href="/Colors" class="@(currentCtrl == "colors" && currentAction == "index" ? "active" : "")">
                            <i class="bi bi-dot"></i> Danh mục màu sắc
                        </a>
                        <a href="/Colors/Create" class="@(currentCtrl == "colors" && currentAction == "create" ? "active" : "")">
                            <i class="bi bi-dot"></i> Thêm màu mới
                        </a>
                    </div>
                </div>

                <!-- Quản lý đơn hàng -->
                <a href="/Admin/Orders" class="nav-link-custom @(currentCtrl == "admin" && currentAction == "orders" ? "active" : "")">
                    <i class="bi bi-box-seam-fill"></i>
                    <span>Quản lý đơn hàng</span>
                </a>

                <!-- Quản lý trả góp (Mốc 1) -->
                <a href="/Admin/Installments" class="nav-link-custom @(currentCtrl == "admin" && (currentAction == "installments" || currentAction == "installmentdetails") ? "active" : "")">
                    <i class="bi bi-credit-card-2-front-fill"></i>
                    <span>Quản lý trả góp</span>
                </a>

                <!-- Quản lý khách hàng -->
                <a href="/Admin/Customers" class="nav-link-custom @(currentCtrl == "admin" && currentAction == "customers" ? "active" : "")">
                    <i class="bi bi-people-fill"></i>
                    <span>Quản lý khách hàng</span>
                </a>

                <!-- Mã giảm giá -->
                <a href="/Admin/Discounts" class="nav-link-custom @(currentCtrl == "admin" && currentAction == "discounts" ? "active" : "")">
                    <i class="bi bi-tag-fill"></i>
                    <span>Mã giảm giá</span>
                </a>

                <!-- Cấu hình hệ thống -->
                <a href="/Admin/Settings" class="nav-link-custom @(currentCtrl == "admin" && currentAction == "settings" ? "active" : "")">
                    <i class="bi bi-gear-fill"></i>
                    <span>Cấu hình hệ thống</span>
                </a>
            </nav>

            <!-- Sidebar Footer / User Profile -->
            <div class="sidebar-footer">
                <div class="sidebar-user-card mb-2">
                    <div class="sidebar-user-avatar">
                        @((User.Identity?.Name ?? "A").Substring(0, 1).ToUpper())
                    </div>
                    <div class="sidebar-user-info">
                        <div class="sidebar-user-name">@(User.Identity?.Name ?? "Nhân viên")</div>
                        <div class="sidebar-user-role">Nhân viên Quản trị</div>
                    </div>
                </div>
                <div class="d-flex justify-content-between align-items-center pt-1">
                    <a href="/Catalog" target="_blank" class="btn btn-sm btn-secondary-custom py-1 px-2" style="font-size: 0.72rem;">
                        <i class="bi bi-shop"></i> Xem web
                    </a>
                    <a href="/Admin/Logout" class="btn-sidebar-logout text-decoration-none">
                        <i class="bi bi-box-arrow-right"></i> Đăng xuất
                    </a>
                </div>
            </div>
        </aside>

        <!-- ==================== MAIN CONTENT WRAPPER ==================== -->
        <div class="admin-main">
            <!-- Topbar -->
            <header class="admin-topbar">
                <!-- Search Input -->
                <div class="topbar-search-wrap">
                    <i class="bi bi-search topbar-search-icon"></i>
                    <input type="text" class="topbar-search-input" id="globalAdminSearch" placeholder="Tìm kiếm sản phẩm, đơn hàng..." />
                </div>

                <!-- Topbar Actions -->
                <div class="topbar-actions">
                    <!-- Quick Storefront Link -->
                    <a href="/Catalog" target="_blank" class="btn-topbar-link d-none d-md-inline-flex">
                        <i class="bi bi-shop text-primary"></i>
                        <span>Cửa hàng</span>
                    </a>

                    <!-- Notification Dropdown -->
                    <div class="dropdown">
                        <div class="topbar-notification" data-bs-toggle="dropdown" aria-expanded="false" id="topbarNotificationBtn" role="button">
                            <i class="bi bi-bell"></i>
                            <span class="notification-badge d-none" id="notificationDot"></span>
                            <span class="d-none d-sm-inline">Thông báo</span>
                            <span class="badge bg-danger rounded-pill ms-1 d-none" id="notificationCountBadge" style="font-size: 0.68rem; padding: 0.25em 0.5em;">0</span>
                        </div>
                        <div class="dropdown-menu dropdown-menu-end shadow-lg border-0 p-0 rounded-3 mt-2" style="width: 370px; max-width: 92vw; z-index: 1060;" aria-labelledby="topbarNotificationBtn">
                            <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light rounded-top-3">
                                <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-bell-fill text-primary me-2"></i>Thông báo hệ thống</h6>
                                <span class="badge bg-primary rounded-pill small" id="notificationHeaderBadge">0 việc cần làm</span>
                            </div>
                            <div class="list-group list-group-flush" id="notificationList" style="max-height: 380px; overflow-y: auto;">
                                <div class="text-center py-4 text-muted small" id="notificationLoading">
                                    <span class="spinner-border spinner-border-sm me-2 text-primary" role="status"></span> Đang tải...
                                </div>
                            </div>
                            <div class="p-2 border-top bg-light text-center rounded-bottom-3 d-flex justify-content-around">
                                <a href="/Admin/Orders" class="btn btn-link btn-sm text-decoration-none fw-semibold small p-1">
                                    <i class="bi bi-box-seam me-1"></i> Quản lý đơn
                                </a>
                                <span class="text-muted align-self-center">|</span>
                                <a href="/Admin/Installments" class="btn btn-link btn-sm text-decoration-none fw-semibold small p-1">
                                    <i class="bi bi-credit-card-2-front me-1"></i> Quản lý trả góp
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- User Profile Dropdown -->
                    <div class="dropdown">
                        <div class="topbar-user" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="topbar-user-avatar">@((User.Identity?.Name ?? "A").Substring(0, 1).ToUpper())</div>
                            <span class="d-none d-sm-inline">@(User.Identity?.Name ?? "Nhân viên")</span>
                            <i class="bi bi-chevron-down small text-muted"></i>
                        </div>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border" style="background-color: #ffffff; border-color: #e2e8f0;">
                            <li><h6 class="dropdown-header text-primary fw-bold">Nhân viên Quản trị</h6></li>
                            <li><a class="dropdown-item text-dark" href="/Admin/Settings"><i class="bi bi-person me-2 text-muted"></i> Hồ sơ cá nhân</a></li>
                            <li><a class="dropdown-item text-dark" href="/Admin/Settings"><i class="bi bi-gear me-2 text-muted"></i> Cài đặt hệ thống</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="/Admin/Logout"><i class="bi bi-box-arrow-right me-2"></i> Đăng xuất</a></li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Page Body Content -->
            <main class="admin-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        async function fetchAdminNotifications() {
            try {
                const res = await fetch('/Admin/GetNotifications');
                if (!res.ok) return;
                const data = await res.json();
                if (!data.success) return;

                const dot = document.getElementById('notificationDot');
                const countBadge = document.getElementById('notificationCountBadge');
                const headerBadge = document.getElementById('notificationHeaderBadge');
                const list = document.getElementById('notificationList');

                if (data.totalCount > 0) {
                    if (dot) dot.classList.remove('d-none');
                    if (countBadge) {
                        countBadge.innerText = data.totalCount > 99 ? '99+' : data.totalCount;
                        countBadge.classList.remove('d-none');
                    }
                    if (headerBadge) {
                        headerBadge.innerText = `${data.totalCount} cần xử lý`;
                    }

                    let itemsHtml = '';

                    // 1. Kỳ trả góp đến hạn hoặc quá hạn
                    if (data.installments && data.installments.length > 0) {
                        data.installments.forEach(item => {
                            const icon = item.badge === 'Quá hạn' ? 'bi-exclamation-triangle-fill text-danger' : 'bi-clock-history text-warning';
                            itemsHtml += `
                                <a href="${item.url}" class="list-group-item list-group-item-action p-3 border-bottom d-flex align-items-start gap-2">
                                    <i class="bi ${icon} fs-5 mt-1"></i>
                                    <div class="flex-grow-1 min-w-0">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="fw-semibold text-dark small text-truncate">${item.title}</span>
                                            <span class="badge ${item.badgeClass} rounded-pill" style="font-size: 0.65rem;">${item.badge}</span>
                                        </div>
                                        <div class="text-secondary small text-truncate">${item.subtitle}</div>
                                        <div class="text-muted" style="font-size: 0.7rem;"><i class="bi bi-calendar-event me-1"></i>Hạn: ${item.time}</div>
                                    </div>
                                </a>
                            `;
                        });
                    }

                    // 2. Đơn hàng mới
                    if (data.orders && data.orders.length > 0) {
                        data.orders.forEach(item => {
                            const icon = item.badge === 'Chờ trả trước' ? 'bi-credit-card-2-front text-warning' : 'bi-bag-check-fill text-primary';
                            itemsHtml += `
                                <a href="${item.url}" class="list-group-item list-group-item-action p-3 border-bottom d-flex align-items-start gap-2">
                                    <i class="bi ${icon} fs-5 mt-1"></i>
                                    <div class="flex-grow-1 min-w-0">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="fw-semibold text-dark small text-truncate">${item.title}</span>
                                            <span class="badge ${item.badgeClass} rounded-pill" style="font-size: 0.65rem;">${item.badge}</span>
                                        </div>
                                        <div class="text-secondary small text-truncate">${item.subtitle}</div>
                                        <div class="text-muted" style="font-size: 0.7rem;"><i class="bi bi-clock me-1"></i>${item.time}</div>
                                    </div>
                                </a>
                            `;
                        });
                    }

                    // 3. Kho hàng
                    if (data.stocks && data.stocks.length > 0) {
                        data.stocks.forEach(item => {
                            itemsHtml += `
                                <a href="${item.url}" class="list-group-item list-group-item-action p-3 border-bottom d-flex align-items-start gap-2">
                                    <i class="bi bi-box-seam text-danger fs-5 mt-1"></i>
                                    <div class="flex-grow-1 min-w-0">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="fw-semibold text-dark small text-truncate">${item.title}</span>
                                            <span class="badge ${item.badgeClass} rounded-pill" style="font-size: 0.65rem;">${item.badge}</span>
                                        </div>
                                        <div class="text-secondary small text-truncate">${item.subtitle}</div>
                                    </div>
                                </a>
                            `;
                        });
                    }

                    list.innerHTML = itemsHtml;
                } else {
                    if (dot) dot.classList.add('d-none');
                    if (countBadge) countBadge.classList.add('d-none');
                    if (headerBadge) headerBadge.innerText = '0 việc mới';
                    list.innerHTML = `
                        <div class="text-center py-4 text-muted small">
                            <i class="bi bi-check2-circle text-success fs-3 d-block mb-1"></i>
                            Không có thông báo mới.<br/>Hệ thống đang hoạt động tối ưu!
                        </div>
                    `;
                }
            } catch (e) {
                console.error('Lỗi khi tải thông báo:', e);
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            fetchAdminNotifications();
            // Cập nhật lại sau mỗi 60 giây
            setInterval(fetchAdminNotifications, 60000);

            // Nạp mới khi mở dropdown
            const btn = document.getElementById('topbarNotificationBtn');
            if (btn) {
                btn.addEventListener('click', function() {
                    fetchAdminNotifications();
                });
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
