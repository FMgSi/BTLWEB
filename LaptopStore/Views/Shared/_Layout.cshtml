<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LAPTOP WORLD ADMIN</title>

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Admin Modern Theme -->
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    @{
        var currentCtrl = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "").ToLower();
        var currentAction = (ViewContext.RouteData.Values["action"]?.ToString() ?? "").ToLower();
    }

    <div class="admin-layout">
        <!-- ==================== SIDEBAR ==================== -->
        <aside class="admin-sidebar" id="adminSidebar">
            <!-- Sidebar Header / Logo -->
            <div class="sidebar-header">
                <div class="brand-icon-box">
                    <i class="bi bi-laptop"></i>
                </div>
                <div class="brand-title-wrap">
                    <span class="brand-title">LAPTOP WORLD</span>
                    <span class="brand-subtitle">ADMIN</span>
                </div>
            </div>

            <!-- Navigation Links -->
            <nav class="sidebar-nav">
                <!-- Quản lý sản phẩm -->
                <div>
                    <a href="/Product" class="nav-link-custom d-flex justify-content-between align-items-center @(currentCtrl == "product" ? "active" : "")">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-pc-display"></i>
                            <span>Quản lý sản phẩm</span>
                        </div>
                        <i class="bi bi-chevron-down small" style="font-size: 0.75rem;"></i>
                    </a>
                    <div class="sidebar-submenu">
                        <a href="/Product" class="@(currentCtrl == "product" && currentAction == "index" ? "active" : "")">
                            <i class="bi bi-dot"></i> Danh sách sản phẩm
                        </a>
                        <a href="/Product/Create" class="@(currentCtrl == "product" && currentAction == "create" ? "active" : "")">
                            <i class="bi bi-dot"></i> Thêm sản phẩm
                        </a>
                        <a href="/Product#categories" class="@(currentCtrl == "product" && currentAction == "categories" ? "active" : "")">
                            <i class="bi bi-dot"></i> Danh mục
                        </a>
                    </div>
                </div>

                <!-- Quản lý đơn hàng -->
                <a href="/Admin/Orders" class="nav-link-custom @(currentCtrl == "admin" && currentAction == "orders" ? "active" : "")">
                    <i class="bi bi-box-seam-fill"></i>
                    <span>Quản lý đơn hàng</span>
                </a>

                <!-- Quản lý khách hàng -->
                <a href="/Admin/Customers" class="nav-link-custom @(currentCtrl == "admin" && currentAction == "customers" ? "active" : "")">
                    <i class="bi bi-people-fill"></i>
                    <span>Quản lý khách hàng</span>
                </a>

                <!-- Mã giảm giá -->
                <a href="/Admin/Discounts" class="nav-link-custom @(currentCtrl == "admin" && currentAction == "discounts" ? "active" : "")">
                    <i class="bi bi-tag-fill"></i>
                    <span>Mã giảm giá</span>
                </a>

                <!-- Cấu hình hệ thống -->
                <a href="/Admin/Settings" class="nav-link-custom @(currentCtrl == "admin" && currentAction == "settings" ? "active" : "")">
                    <i class="bi bi-gear-fill"></i>
                    <span>Cấu hình hệ thống</span>
                </a>
            </nav>

            <!-- Sidebar Footer / User Profile -->
            <div class="sidebar-footer">
                <div class="sidebar-user-card mb-2">
                    <div class="sidebar-user-avatar">
                        @((User.Identity?.Name ?? "A").Substring(0, 1).ToUpper())
                    </div>
                    <div class="sidebar-user-info">
                        <div class="sidebar-user-name">@(User.Identity?.Name ?? "Quản trị viên")</div>
                        <div class="sidebar-user-role">Quản trị viên (Admin)</div>
                    </div>
                </div>
                <div class="d-flex justify-content-between align-items-center pt-1">
                    <a href="http://localhost:3000" target="_blank" class="btn btn-sm btn-secondary-custom py-1 px-2" style="font-size: 0.72rem;">
                        <i class="bi bi-shop"></i> Xem web
                    </a>
                    <a href="/Admin/Logout" class="btn-sidebar-logout text-decoration-none">
                        <i class="bi bi-box-arrow-right"></i> Đăng xuất
                    </a>
                </div>
            </div>
        </aside>

        <!-- ==================== MAIN CONTENT WRAPPER ==================== -->
        <div class="admin-main">
            <!-- Topbar -->
            <header class="admin-topbar">
                <!-- Search Input -->
                <div class="topbar-search-wrap">
                    <i class="bi bi-search topbar-search-icon"></i>
                    <input type="text" class="topbar-search-input" id="globalAdminSearch" placeholder="Tìm kiếm sản phẩm, đơn hàng..." />
                </div>

                <!-- Topbar Actions -->
                <div class="topbar-actions">
                    <!-- Quick Storefront Link -->
                    <a href="http://localhost:3000" target="_blank" class="btn-topbar-link d-none d-md-inline-flex">
                        <i class="bi bi-globe2 text-primary"></i>
                        <span>Cửa hàng</span>
                    </a>

                    <!-- Notification -->
                    <div class="topbar-notification">
                        <i class="bi bi-bell"></i>
                        <span class="notification-badge"></span>
                        <span class="d-none d-sm-inline">Thông báo</span>
                    </div>

                    <!-- User Profile Dropdown -->
                    <div class="dropdown">
                        <div class="topbar-user" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="topbar-user-avatar">A</div>
                            <span class="d-none d-sm-inline">Nguyễn Văn A</span>
                            <i class="bi bi-chevron-down small text-muted"></i>
                        </div>
                        <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark shadow" style="background-color: #151f32; border-color: rgba(255,255,255,0.1);">
                            <li><h6 class="dropdown-header text-primary fw-bold">Quản trị viên</h6></li>
                            <li><a class="dropdown-item" href="/Admin/Settings"><i class="bi bi-person me-2"></i> Hồ sơ cá nhân</a></li>
                            <li><a class="dropdown-item" href="/Admin/Settings"><i class="bi bi-gear me-2"></i> Cài đặt hệ thống</a></li>
                            <li><hr class="dropdown-divider border-secondary"></li>
                            <li><a class="dropdown-item text-danger" href="http://localhost:3000"><i class="bi bi-box-arrow-right me-2"></i> Đăng xuất</a></li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Page Body Content -->
            <main class="admin-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
