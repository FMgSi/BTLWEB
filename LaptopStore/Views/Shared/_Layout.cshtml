<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LAPTOP WORLD ADMIN</title>

    <!-- Bootstrap 5 & Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Admin Modern Theme -->
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="admin-body-horizontal">
    @{
        var currentCtrl = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "").ToLower();
        var currentAction = (ViewContext.RouteData.Values["action"]?.ToString() ?? "").ToLower();
    }

    <!-- ==================== THANH TASKBAR & ĐIỀU HƯỚNG THEO KIỂU NGANG ==================== -->
    <header class="admin-horizontal-header sticky-top">
        <div class="container-fluid px-3 px-lg-4">
            <!-- HÀNG TRÊN: LOGO, TÌM KIẾM, THÔNG BÁO & USER PROFILE -->
            <div class="d-flex align-items-center justify-content-between py-2 border-bottom">
                <!-- Logo & Brand -->
                <div class="d-flex align-items-center gap-3">
                    <a href="/Admin/Orders" class="d-flex align-items-center gap-2 text-decoration-none">
                        <div class="brand-icon-box">
                            <i class="bi bi-laptop"></i>
                        </div>
                        <div class="d-flex flex-column">
                            <span class="fw-bold text-dark fs-6" style="letter-spacing: 0.5px;">LAPTOP WORLD</span>
                            <span class="text-muted" style="font-size: 0.7rem;">HỆ THỐNG QUẢN TRỊ VIÊN</span>
                        </div>
                    </a>
                </div>

                <!-- Global Search Input -->
                <div class="topbar-search-wrap d-none d-md-block" style="width: 360px;">
                    <i class="bi bi-search topbar-search-icon"></i>
                    <input type="text" class="topbar-search-input" id="globalAdminSearch" placeholder="Tìm kiếm sản phẩm, đơn hàng, khách hàng..." />
                </div>

                <!-- Topbar Actions (Thông báo & Tài khoản) -->
                <div class="d-flex align-items-center gap-2">
                    <!-- Notification Dropdown -->
                    <div class="dropdown">
                        <div class="btn-action-tool py-1 px-2" data-bs-toggle="dropdown" aria-expanded="false" id="topbarNotificationBtn" role="button" style="cursor: pointer;">
                            <i class="bi bi-bell text-secondary"></i>
                            <span class="d-none d-sm-inline ms-1 small fw-medium">Thông báo</span>
                            <span class="badge bg-danger rounded-pill ms-1 d-none" id="notificationCountBadge" style="font-size: 0.65rem;">0</span>
                        </div>
                        <div class="dropdown-menu dropdown-menu-end shadow-lg border-0 p-0 rounded-3 mt-2" style="width: 370px; max-width: 92vw; z-index: 1060;" aria-labelledby="topbarNotificationBtn">
                            <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light rounded-top-3">
                                <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-bell-fill text-primary me-2"></i>Thông báo hệ thống</h6>
                                <span class="badge bg-primary rounded-pill small" id="notificationHeaderBadge">0 việc cần làm</span>
                            </div>
                            <div class="list-group list-group-flush" id="notificationList" style="max-height: 380px; overflow-y: auto;">
                                <div class="text-center py-4 text-muted small" id="notificationLoading">
                                    <span class="spinner-border spinner-border-sm me-2 text-primary" role="status"></span> Đang tải...
                                </div>
                            </div>
                            <div class="p-2 border-top bg-light text-center rounded-bottom-3 d-flex justify-content-around">
                                <a href="/Admin/Orders" class="btn btn-link btn-sm text-decoration-none fw-semibold small p-1">
                                    <i class="bi bi-box-seam me-1"></i> Quản lý đơn
                                </a>
                                <span class="text-muted align-self-center">|</span>
                                <a href="/Admin/Installments" class="btn btn-link btn-sm text-decoration-none fw-semibold small p-1">
                                    <i class="bi bi-credit-card-2-front me-1"></i> Quản lý trả góp
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- User Profile Dropdown -->
                    <div class="dropdown">
                        <div class="btn-action-tool py-1 px-2 gap-2" data-bs-toggle="dropdown" aria-expanded="false" style="cursor: pointer;">
                            <div class="topbar-user-avatar" style="width: 24px; height: 24px; font-size: 0.75rem;">
                                @((User.Identity?.Name ?? "A").Substring(0, 1).ToUpper())
                            </div>
                            <span class="small fw-semibold d-none d-sm-inline">@(User.Identity?.Name ?? "Quản Trị Viên")</span>
                            <i class="bi bi-chevron-down small text-muted"></i>
                        </div>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border mt-1">
                            <li><h6 class="dropdown-header text-primary fw-bold">Nhân viên Quản trị</h6></li>
                            <li><a class="dropdown-item text-dark" href="/Admin/Orders"><i class="bi bi-box-seam me-2 text-muted"></i> Quản lý đơn hàng</a></li>
                            <li><a class="dropdown-item text-dark" href="/Admin/Reports"><i class="bi bi-bar-chart-line me-2 text-muted"></i> Báo cáo thống kê</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="/Admin/Logout"><i class="bi bi-box-arrow-right me-2"></i> Đăng xuất</a></li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- HÀNG DƯỚI: THANH TASKBAR ĐIỀU HƯỚNG THEO KIỂU NGANG -->
            <nav class="horizontal-taskbar-nav py-1">
                <!-- 1. Quản lý sản phẩm (Nhấn để chuyển sang /Product, rê chuột hoặc bấm mũi tên để mở menu) -->
                <div class="nav-taskbar-group dropdown d-inline-flex align-items-center">
                    <a href="/Product" class="nav-taskbar-item @(currentCtrl == "product" || currentCtrl == "categories" || currentCtrl == "brands" || currentCtrl == "colors" ? "active" : "") pe-1" title="Nhấn để vào Danh sách sản phẩm">
                        <i class="bi bi-laptop me-1"></i> Quản lý sản phẩm
                    </a>
                    <button class="nav-taskbar-toggle @(currentCtrl == "product" || currentCtrl == "categories" || currentCtrl == "brands" || currentCtrl == "colors" ? "active" : "") dropdown-toggle dropdown-toggle-split" 
                            type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Mở menu Quản lý sản phẩm">
                        <span class="visually-hidden">Mở menu</span>
                    </button>
                    <ul class="dropdown-menu shadow-lg border mt-1">
                        <li><a class="dropdown-item @(currentCtrl == "product" && currentAction == "index" ? "active" : "")" href="/Product"><i class="bi bi-list-ul me-2 text-muted"></i> Danh sách laptop</a></li>
                        <li><a class="dropdown-item @(currentCtrl == "product" && currentAction == "create" ? "active" : "")" href="/Product/Create"><i class="bi bi-plus-circle me-2 text-muted"></i> Thêm laptop mới</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item @(currentCtrl == "categories" ? "active" : "")" href="/Categories"><i class="bi bi-tags me-2 text-muted"></i> Thể loại / Danh mục</a></li>
                        <li><a class="dropdown-item @(currentCtrl == "brands" ? "active" : "")" href="/Brands"><i class="bi bi-buildings me-2 text-muted"></i> Thương hiệu / Hãng</a></li>
                        <li><a class="dropdown-item @(currentCtrl == "colors" ? "active" : "")" href="/Colors"><i class="bi bi-palette me-2 text-muted"></i> Bảng màu sản phẩm</a></li>
                    </ul>
                </div>

                <!-- 2. Quản lý đơn hàng -->
                <a href="/Admin/Orders" class="nav-taskbar-item @(currentCtrl == "admin" && currentAction == "orders" ? "active" : "")">
                    <i class="bi bi-box-seam me-1"></i> Quản lý đơn hàng
                </a>

                <!-- 3. Quản lý trả góp -->
                <a href="/Admin/Installments" class="nav-taskbar-item @(currentCtrl == "admin" && (currentAction == "installments" || currentAction == "installmentdetails") ? "active" : "")">
                    <i class="bi bi-credit-card-2-front me-1"></i> Quản lý trả góp
                </a>

                <!-- 4. Dịch vụ & Bảo hành (Nhấn để chuyển sang /Admin/ServiceTickets, rê chuột hoặc bấm mũi tên để mở menu) -->
                <div class="nav-taskbar-group dropdown d-inline-flex align-items-center">
                    <a href="/Admin/ServiceTickets" class="nav-taskbar-item @(currentCtrl == "admin" && (currentAction.StartsWith("service") || currentAction == "solddevices") ? "active" : "") pe-1" title="Nhấn để vào Phiếu tiếp nhận">
                        <i class="bi bi-tools me-1"></i> Dịch vụ & Bảo hành
                    </a>
                    <button class="nav-taskbar-toggle @(currentCtrl == "admin" && (currentAction.StartsWith("service") || currentAction == "solddevices") ? "active" : "") dropdown-toggle dropdown-toggle-split" 
                            type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Mở menu Dịch vụ & Bảo hành">
                        <span class="visually-hidden">Mở menu</span>
                    </button>
                    <ul class="dropdown-menu shadow-lg border mt-1">
                        <li><a class="dropdown-item @(currentCtrl == "admin" && currentAction == "servicetickets" ? "active" : "")" href="/Admin/ServiceTickets"><i class="bi bi-card-checklist me-2 text-muted"></i> Phiếu tiếp nhận</a></li>
                        <li><a class="dropdown-item @(currentCtrl == "admin" && currentAction == "servicecatalog" ? "active" : "")" href="/Admin/ServiceCatalog"><i class="bi bi-list-task me-2 text-muted"></i> Bảng giá dịch vụ</a></li>
                        <li><a class="dropdown-item @(currentCtrl == "admin" && currentAction == "solddevices" ? "active" : "")" href="/Admin/SoldDevices"><i class="bi bi-laptop me-2 text-muted"></i> Máy đã giao & Serial</a></li>
                    </ul>
                </div>

                <!-- 5. Báo cáo thống kê -->
                <a href="/Admin/Reports" class="nav-taskbar-item @(currentCtrl == "admin" && currentAction == "reports" ? "active" : "")">
                    <i class="bi bi-bar-chart-line me-1"></i> Báo cáo thống kê
                </a>

                <!-- 6. Quản lý tài khoản -->
                <a href="/Admin/Customers" class="nav-taskbar-item @(currentCtrl == "admin" && (currentAction == "customers" || currentAction == "staff") ? "active" : "")">
                    <i class="bi bi-people me-1"></i> Quản lý tài khoản
                </a>
            </nav>
        </div>
    </header>

    <!-- ==================== KHÔNG GIAN NỘI DUNG CHÍNH (FULL WIDTH) ==================== -->
    <div class="admin-main admin-main-horizontal">
        <main class="container-fluid px-3 px-lg-4 py-4 flex-grow-1">
            @RenderBody()
        </main>

        <footer class="py-3 border-top bg-white text-muted small text-center">
            <div class="container-fluid">
                &copy; @DateTime.Now.Year - LAPTOP WORLD Enterprise Back-Office Portal. Toàn bộ quyền được bảo lưu.
            </div>
        </footer>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        async function fetchAdminNotifications() {
            try {
                const res = await fetch('/Admin/GetNotifications');
                if (!res.ok) return;
                const data = await res.json();
                if (!data.success) return;

                const countBadge = document.getElementById('notificationCountBadge');
                const headerBadge = document.getElementById('notificationHeaderBadge');
                const list = document.getElementById('notificationList');

                if (data.totalCount > 0) {
                    if (countBadge) {
                        countBadge.innerText = data.totalCount > 99 ? '99+' : data.totalCount;
                        countBadge.classList.remove('d-none');
                    }
                    if (headerBadge) {
                        headerBadge.innerText = `${data.totalCount} cần xử lý`;
                    }

                    let itemsHtml = '';

                    // 1. Kỳ trả góp đến hạn hoặc quá hạn
                    if (data.installments && data.installments.length > 0) {
                        data.installments.forEach(item => {
                            const icon = item.badge === 'Quá hạn' ? 'bi-exclamation-triangle-fill text-danger' : 'bi-clock-history text-warning';
                            itemsHtml += `
                                <a href="${item.url}" class="list-group-item list-group-item-action p-3 border-bottom d-flex align-items-start gap-2">
                                    <i class="bi ${icon} fs-5 mt-1"></i>
                                    <div class="flex-grow-1 min-w-0">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="fw-semibold text-dark small text-truncate">${item.title}</span>
                                            <span class="badge ${item.badgeClass} rounded-pill" style="font-size: 0.65rem;">${item.badge}</span>
                                        </div>
                                        <div class="text-secondary small text-truncate">${item.subtitle}</div>
                                        <div class="text-muted" style="font-size: 0.7rem;"><i class="bi bi-calendar-event me-1"></i>Hạn: ${item.time}</div>
                                    </div>
                                </a>
                            `;
                        });
                    }

                    // 2. Đơn hàng mới
                    if (data.orders && data.orders.length > 0) {
                        data.orders.forEach(item => {
                            const icon = item.badge === 'Chờ trả trước' ? 'bi-credit-card-2-front text-warning' : 'bi-bag-check-fill text-primary';
                            itemsHtml += `
                                <a href="${item.url}" class="list-group-item list-group-item-action p-3 border-bottom d-flex align-items-start gap-2">
                                    <i class="bi ${icon} fs-5 mt-1"></i>
                                    <div class="flex-grow-1 min-w-0">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="fw-semibold text-dark small text-truncate">${item.title}</span>
                                            <span class="badge ${item.badgeClass} rounded-pill" style="font-size: 0.65rem;">${item.badge}</span>
                                        </div>
                                        <div class="text-secondary small text-truncate">${item.subtitle}</div>
                                        <div class="text-muted" style="font-size: 0.7rem;"><i class="bi bi-clock me-1"></i>${item.time}</div>
                                    </div>
                                </a>
                            `;
                        });
                    }

                    // 3. Kho hàng
                    if (data.stocks && data.stocks.length > 0) {
                        data.stocks.forEach(item => {
                            itemsHtml += `
                                <a href="${item.url}" class="list-group-item list-group-item-action p-3 border-bottom d-flex align-items-start gap-2">
                                    <i class="bi bi-box-seam text-danger fs-5 mt-1"></i>
                                    <div class="flex-grow-1 min-w-0">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="fw-semibold text-dark small text-truncate">${item.title}</span>
                                            <span class="badge ${item.badgeClass} rounded-pill" style="font-size: 0.65rem;">${item.badge}</span>
                                        </div>
                                        <div class="text-secondary small text-truncate">${item.subtitle}</div>
                                    </div>
                                </a>
                            `;
                        });
                    }

                    list.innerHTML = itemsHtml;
                } else {
                    if (countBadge) countBadge.classList.add('d-none');
                    if (headerBadge) headerBadge.innerText = '0 việc mới';
                    list.innerHTML = `
                        <div class="text-center py-4 text-muted small">
                            <i class="bi bi-check2-circle text-success fs-3 d-block mb-1"></i>
                            Không có thông báo mới.<br/>Hệ thống đang hoạt động tối ưu!
                        </div>
                    `;
                }
            } catch (e) {
                console.error('Lỗi khi tải thông báo:', e);
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            fetchAdminNotifications();
            setInterval(fetchAdminNotifications, 60000);

            const btn = document.getElementById('topbarNotificationBtn');
            if (btn) {
                btn.addEventListener('click', function() {
                    fetchAdminNotifications();
                });
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>