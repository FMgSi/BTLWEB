@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LAPTOP WORLD | Thế Giới Laptop Chính Hãng</title>

    <!-- Google Fonts: Inter & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap 5.3 & Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Storefront Customer CSS -->
    <link rel="stylesheet" href="~/css/storefront.css" asp-append-version="true" />
</head>
<body class="storefront-body">
    @{
        var currentCtrl = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "").ToLower();
        var currentAction = (ViewContext.RouteData.Values["action"]?.ToString() ?? "").ToLower();
        var isAuth = User.Identity?.IsAuthenticated == true;
        var isAdmin = User.IsInRole("Admin") || Context.Session.GetString("Role") == "Admin";
        var username = User.Identity?.Name ?? Context.Session.GetString("Username") ?? "Khách hàng";
    }

    <!-- 1. TOP ANNOUNCEMENT BAR -->
    <div class="storefront-topbar py-1">
        <div class="container d-flex justify-content-between align-items-center small">
            <div class="d-flex align-items-center gap-3">
                <span><i class="bi bi-geo-alt-fill text-danger me-1"></i> Số 123 Cầu Giấy, Hà Nội</span>
                <span class="d-none d-md-inline text-muted">|</span>
                <span class="d-none d-md-inline"><i class="bi bi-telephone-fill text-success me-1"></i> Hotline: <strong>1900 8888</strong> (8h - 22h)</span>
            </div>
            <div class="d-flex align-items-center gap-3">
                <a href="/Catalog/Lookup" class="topbar-link"><i class="bi bi-truck me-1"></i> Tra cứu đơn hàng</a>
                <span class="text-muted">|</span>
                @if (isAuth || !string.IsNullOrEmpty(Context.Session.GetString("UserId")))
                {
                    <div class="dropdown">
                        <a class="dropdown-toggle topbar-link fw-semibold" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle me-1"></i> @username
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            <li><span class="dropdown-item-text text-muted small">Đã đăng nhập</span></li>
                            <li><hr class="dropdown-divider"></li>
                            @if (isAdmin)
                            {
                                <li>
                                    <a class="dropdown-item text-primary fw-bold" href="/Product">
                                        <i class="bi bi-speedometer2 me-2"></i> Trang Quản trị (Admin)
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                            }
                            <li><a class="dropdown-item" href="/Catalog/Lookup"><i class="bi bi-receipt me-2"></i> Đơn hàng của tôi</a></li>
                            <li>
                                <form asp-controller="Admin" asp-action="Logout" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a href="/Admin/Login" class="topbar-link"><i class="bi bi-person-lock me-1"></i> Đăng nhập</a>
                }
            </div>
        </div>
    </div>

    <!-- 2. MAIN HEADER -->
    <header class="storefront-header sticky-top bg-white border-bottom shadow-sm">
        <div class="container py-2">
            <div class="row align-items-center gy-2">
                <!-- Logo -->
                <div class="col-6 col-lg-3">
                    <a href="/Catalog" class="text-decoration-none d-flex align-items-center gap-2">
                        <div class="storefront-logo-icon">
                            <i class="bi bi-laptop"></i>
                        </div>
                        <div>
                            <span class="storefront-logo-text">LAPTOP WORLD</span>
                            <span class="storefront-logo-sub">OFFICIAL STORE</span>
                        </div>
                    </a>
                </div>

                <!-- Search Input -->
                <div class="col-12 col-lg-6 order-3 order-lg-2">
                    <form action="/Catalog" method="get" class="storefront-search-form">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 ps-3">
                                <i class="bi bi-search text-muted"></i>
                            </span>
                            <input type="text" name="q" class="form-control border-start-0 ps-1" placeholder="Bạn cần tìm laptop gì? (Ví dụ: ASUS ROG, Dell XPS, Macbook M3, Gaming...)" value="@Context.Request.Query["q"]" />
                            <button type="submit" class="btn btn-primary px-4 fw-semibold">Tìm kiếm</button>
                        </div>
                    </form>
                </div>

                <!-- Right Actions: Hotline & Cart -->
                <div class="col-6 col-lg-3 order-2 order-lg-3 text-end d-flex justify-content-end align-items-center gap-3">
                    <div class="d-none d-xl-flex align-items-center gap-2 text-start">
                        <div class="support-icon-wrap">
                            <i class="bi bi-headset fs-4 text-primary"></i>
                        </div>
                        <div>
                            <div class="small text-muted lh-1">Tư vấn miễn phí</div>
                            <strong class="text-dark">1900 8888</strong>
                        </div>
                    </div>
                    <a href="/Catalog/Lookup" class="btn btn-outline-primary d-flex align-items-center gap-2 rounded-pill px-3 py-2 fw-semibold">
                        <i class="bi bi-box-seam fs-5"></i>
                        <span class="d-none d-sm-inline">Tra cứu đơn</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- 3. NAVIGATION BAR -->
        <nav class="storefront-nav border-top bg-light">
            <div class="container">
                <ul class="nav nav-pills storefront-nav-list flex-nowrap overflow-x-auto py-1">
                    <li class="nav-item">
                        <a class="nav-link @(string.IsNullOrEmpty(Context.Request.Query["category"]) && string.IsNullOrEmpty(Context.Request.Query["brand"]) ? "active" : "")" href="/Catalog">
                            <i class="bi bi-grid-fill me-1"></i> Tất cả laptop
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(Context.Request.Query["category"] == "Laptop gaming" ? "active" : "")" href="/Catalog?category=Laptop+gaming">
                            <i class="bi bi-controller me-1"></i> Laptop Gaming
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(Context.Request.Query["category"] == "Laptop văn phòng" ? "active" : "")" href="/Catalog?category=Laptop+v%C4%83n+ph%C3%B2ng">
                            <i class="bi bi-briefcase me-1"></i> Văn phòng & Học tập
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(Context.Request.Query["category"] == "Laptop đồ họa" ? "active" : "")" href="/Catalog?category=Laptop+%C4%91%E1%BB%93+h%E1%BB%8Da">
                            <i class="bi bi-palette me-1"></i> Đồ họa & Kỹ thuật
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(Context.Request.Query["brand"] == "Apple" ? "active" : "")" href="/Catalog?brand=Apple">
                            <i class="bi bi-apple me-1"></i> Macbook (Apple)
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(Context.Request.Query["brand"] == "ASUS" ? "active" : "")" href="/Catalog?brand=ASUS">ASUS</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(Context.Request.Query["brand"] == "Dell" ? "active" : "")" href="/Catalog?brand=Dell">Dell</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(Context.Request.Query["brand"] == "Lenovo" ? "active" : "")" href="/Catalog?brand=Lenovo">Lenovo</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(Context.Request.Query["brand"] == "HP" ? "active" : "")" href="/Catalog?brand=HP">HP</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(Context.Request.Query["brand"] == "Acer" ? "active" : "")" href="/Catalog?brand=Acer">Acer</a>
                    </li>
                </ul>
            </div>
        </nav>
    </header>

    <!-- 4. BENEFIT TICKER -->
    <div class="storefront-benefits bg-white border-bottom py-2">
        <div class="container">
            <div class="row g-2 text-center text-md-start small">
                <div class="col-6 col-md-3 d-flex align-items-center justify-content-center justify-content-md-start gap-2">
                    <i class="bi bi-shield-check text-primary fs-5"></i>
                    <span><strong>100% Chính hãng</strong> (Bảo hành 12 - 24T)</span>
                </div>
                <div class="col-6 col-md-3 d-flex align-items-center justify-content-center justify-content-md-start gap-2">
                    <i class="bi bi-truck text-success fs-5"></i>
                    <span><strong>Giao hàng toàn quốc</strong> (Miễn phí)</span>
                </div>
                <div class="col-6 col-md-3 d-flex align-items-center justify-content-center justify-content-md-start gap-2">
                    <i class="bi bi-arrow-repeat text-warning fs-5"></i>
                    <span><strong>1 Đổi 1 trong 30 ngày</strong> nếu lỗi NSX</span>
                </div>
                <div class="col-6 col-md-3 d-flex align-items-center justify-content-center justify-content-md-start gap-2">
                    <i class="bi bi-credit-card-2-front text-danger fs-5"></i>
                    <span><strong>Hỗ trợ trả góp 0%</strong> duyệt hồ sơ nhanh</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 5. MAIN PAGE CONTENT -->
    <main class="storefront-main py-4">
        @RenderBody()
    </main>

    <!-- 6. STOREFRONT FOOTER -->
    <footer class="storefront-footer bg-dark text-white pt-5 pb-3">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-12 col-md-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="storefront-logo-icon bg-primary text-white">
                            <i class="bi bi-laptop"></i>
                        </div>
                        <span class="fs-5 fw-bold text-white">LAPTOP WORLD</span>
                    </div>
                    <p class="text-light-50 small mb-2">Hệ thống bán lẻ laptop chính hãng hàng đầu Việt Nam. Cung cấp các dòng máy tính xách tay Gaming, Doanh nhân, Văn phòng và Đồ họa uy tín số 1.</p>
                    <div class="small text-light-50">
                        <div class="mb-1"><i class="bi bi-geo-alt me-2 text-primary"></i> 123 Đường Cầu Giấy, Quận Cầu Giấy, TP. Hà Nội</div>
                        <div class="mb-1"><i class="bi bi-telephone me-2 text-primary"></i> Tổng đài: 1900 8888 (8:00 - 21:30)</div>
                        <div><i class="bi bi-envelope me-2 text-primary"></i> Email: hotro@laptopworld.vn</div>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <h6 class="text-white fw-bold mb-3">VỀ CHÚNG TÔI</h6>
                    <ul class="list-unstyled small text-light-50">
                        <li class="mb-2"><a href="/Catalog" class="footer-link">Giới thiệu công ty</a></li>
                        <li class="mb-2"><a href="/Catalog" class="footer-link">Hệ thống showroom</a></li>
                        <li class="mb-2"><a href="/Catalog" class="footer-link">Tuyển dụng</a></li>
                        <li class="mb-2"><a href="/Catalog" class="footer-link">Liên hệ hợp tác</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-3">
                    <h6 class="text-white fw-bold mb-3">CHÍNH SÁCH BÁN HÀNG</h6>
                    <ul class="list-unstyled small text-light-50">
                        <li class="mb-2"><a href="/Catalog" class="footer-link">Chính sách bảo hành</a></li>
                        <li class="mb-2"><a href="/Catalog" class="footer-link">Chính sách đổi trả 1 - 1</a></li>
                        <li class="mb-2"><a href="/Catalog" class="footer-link">Chính sách giao hàng toàn quốc</a></li>
                        <li class="mb-2"><a href="/Catalog/Lookup" class="footer-link">Hướng dẫn tra cứu đơn hàng</a></li>
                    </ul>
                </div>
                <div class="col-12 col-md-3">
                    <h6 class="text-white fw-bold mb-3">PHƯƠNG THỨC THANH TOÁN</h6>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <span class="badge bg-secondary p-2"><i class="bi bi-cash-stack"></i> COD Tiền mặt</span>
                        <span class="badge bg-primary p-2"><i class="bi bi-qr-code"></i> VietQR Chuyển khoản</span>
                        <span class="badge bg-danger p-2"><i class="bi bi-credit-card"></i> VNPAY Cổng thanh toán</span>
                    </div>
                    <div class="alert alert-secondary py-2 px-3 small mb-0 border-0 text-dark">
                        <i class="bi bi-shield-lock-fill text-success me-1"></i> Giao dịch bảo mật chuẩn SSL 256-bit
                    </div>
                </div>
            </div>

            <hr class="border-secondary my-3" />
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center small text-light-50">
                <div>© @DateTime.Now.Year LAPTOP WORLD. Tất cả quyền được bảo lưu. Đồ án Lập trình Web ASP.NET Core MVC.</div>
                <div class="mt-2 mt-md-0">
                    <span class="badge bg-dark border border-secondary text-light">ASP.NET Core 10 • SQL Server • Bootstrap 5.3</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5.3 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
